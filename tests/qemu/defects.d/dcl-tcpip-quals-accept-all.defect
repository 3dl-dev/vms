# dcl-tcpip-quals-accept-all -- one facility negative control (tests/qemu/facility_defects.sh).
# defect_meta: its metadata, by field ($_f). defect_apply: the mutation of $_file.

defect_meta() {
        case "$_f" in
        facility)     echo "DCL TCPIP per-sub-command qualifier validation (src/vmsdcl/dcl_cmd_misc.c tcpip_subcmd_quals, vms-097)";;
        targets)      echo "vmsdcl/dcl_cmd_misc.c";;
        suites_red)   echo "test_syssvc_dcl_tcpip_quals";;
        blind_suites) echo "";;
        blind_why)    echo "";;
        isolation)    echo "isolated";;
        why)          echo "TCPIP goes back to accept-all: the per-sub-command validation result is ignored, so TCPIP SET ROUTE/ZQONE, SHOW VERSION/OUTPUT= and the rest silently drop an unknown qualifier instead of %DCL-W-IVQUAL.";;
        require_fail) cat <<'EOF2'
TCPIP SET ROUTE/ZQONE is %DCL-W-IVQUAL
TCPIP SHOW VERSION/OUTPUT= (not implemented) is %DCL-W-IVQUAL, not silently dropped
TCPIP SHOW INTERFACE/ZQTWO is %DCL-W-IVQUAL
TCPIP SET SERVICE/ZQTHREE is %DCL-W-IVQUAL
EOF2
                      ;;
        knock_on_fail) echo "";;
        knock_on_why)  echo "";;
        esac

}

defect_apply() {
        sed -i 's|^        if (qs != SS\$_NORMAL)$|        if (0 \&\& qs != SS$_NORMAL) /* NEGCTL dcl-tcpip-quals-accept-all */|' "$_file"
    :
}
