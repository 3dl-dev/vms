# In-tree Kbuild for vmsfs.ko (vms-934, parent vms-19e "owns-kernel").
#
# The canonical source lives in the OVMX repo as src/kernel/vmsfs/ (the thin VFS
# + vmsfs_bio backend) and src/kernel-core/vmsfs/ (the substrate-agnostic ODS-2
# algorithms). distro/kernel/overlay-ovmx-drivers.sh copies BOTH into this
# directory (flattened) at kernel-build time, so every object below is a plain
# basename here. The object set MUST mirror src/kernel/vmsfs/Makefile's
# `vmsfs-y` (the standalone/out-of-tree build kept for the QEMU test harness) --
# if you add a src/kernel-core/vmsfs ODS-2 core .c there, add it here too.
#
# MIRRORED as of rd vms-4a8 (epic vms-208): src/kernel/vmsfs/Makefile's vmsfs-y
# also compiles the genuine ODS-2 codec (src/vmsfs/ods2/*.c) + vmsfs_ods2ro.o
# kernel-resident, and so does this overlay now -- the SHIPPED bootable vmsfs.ko
# carries the ods2ro presentation, not just the QEMU-test module. The codec's
# only subdir'd include, #include "vmsfs/ods2.h", is made flatten-safe by
# staging that one header at <moddir>/vmsfs/ods2.h via the '->' convention in
# overlay-ovmx-drivers.sh (see this module's sources.conf); every other codec
# include is basename-only and resolves under -I$(src). The out-of-tree QEMU
# build (src/kernel/vmsfs/Makefile) remains the co-authoritative object list --
# if you add a codec .c there, add it here too.
#
# ADDITIVE (rd vms-4a8): compiling the codec in is present-but-not-yet-driving-
# boot. It does NOT flip the boot default or mount SYS$DISK via the ACP; the
# ods2ro registration under OVMX_ODS2_KERNEL in vmsfs_super.c now resolves (the
# objects below satisfy it) but the bespoke-VMFS path still drives boot until
# the atomic flip rung.
#
# OVMX_KBACKEND_LINUX selects the Linux realization of the vmsfs_backend shim
# (vmsfs_backend_linux.h), which the overlay places beside these sources.
# OVMX_ODS2_KERNEL selects the codec's kernel-resident world (kernel types/alloc
# + the vmsfs_bio block backend) and flips on the ods2ro register path.

obj-$(CONFIG_OVMX_VMSFS) += vmsfs.o

vmsfs-y := vmsfs_super.o \
           vmsfs_inode.o \
           vmsfs_file.o \
           vmsfs_dir.o \
           vmsfs_blkdev.o \
           vmsfs_version.o \
           vmsfs_map.o \
           vmsfs_name.o \
           vmsfs_alloc.o \
           vmsfs_dirscan.o \
           vmsfs_header.o \
           ods2_reader.o \
           ods2_writer.o \
           ods2_bdev.o \
           ods2_path.o \
           ods2_block_kern.o \
           vmsfs_ods2ro.o

ccflags-y := -I $(src) -DOVMX_KBACKEND_LINUX -DOVMX_ODS2_KERNEL
