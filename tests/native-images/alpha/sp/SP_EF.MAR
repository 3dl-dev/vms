        SPCALL  SYS$SETIMR, 5
        SPUNG
        SPPR    CID122, PR1
        SPGRD   GH121
        PUSHL   #0
        PUSHL   #0
        SPCALL  SYS$CANTIM, 2
        SPUNG
        SPPR    CID123, PR1
        PUSHL   #7
        CALLS   #1, G^SYS$SETEF
        SPGRD   GH122
        PUSHL   #0
        PUSHL   #7
        SPCALL  SYS$WFLOR, 2
        SPUNG
        SPPR    CID124, PR1
        PUSHAB  FEND
        CALLS   #1, G^LIB$PUT_OUTPUT
        MOVL    #1, R0
        RET
        .END    START
