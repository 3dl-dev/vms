        .TITLE  TOVMS
        .PSECT  DATA,NOEXE,WRT,LONG
U1:     .ASCIZ  |bits/c++config.h|
U2:     .ASCIZ  |c++config.h|
U3:     .ASCIZ  |a.b.c.d|
U4:     .ASCIZ  |libstdc++.a|
U5:     .ASCIZ  |dir/sub/MixedCase.Txt|
U6:     .ASCIZ  |file|
U7:     .ASCIZ  |a b.txt|
U8:     .ASCIZ  |x~y.h|
U9:     .ASCIZ  |foo.tar.gz|
U10:    .ASCIZ  |/sys$login/c++config.h|
U11:    .ASCIZ  |include/c++/14.2.0/bits/c++config.h|
V1:     .ASCIZ  |LDA1:[TEST]c^+^+config.h;1|
V2:     .ASCIZ  |[.bits]c^+^+config.h|
V3:     .ASCIZ  |a^.b^.c.d|
V4:     .ASCIZ  |[TEST]MixedCase.Txt;2|
V5:     .ASCIZ  |README.|
V6:     .ASCIZ  |[.x^.y]z.h|
V7:     .ASCIZ  |[.a^_b]c^_d.txt|
SEP:    .ASCIZ  |--|
UNAMES: .ADDRESS U1,U2,U3,U4,U5,U6,U7,U8,U9,U10,U11
        .LONG   0
VNAMES: .ADDRESS V1,V2,V3,V4,V5,V6,V7
        .LONG   0
OUTD:   .WORD   0
        .BYTE   14,1
        .ADDRESS 0
        .PSECT  CODE,EXE,NOWRT
        .ENTRY  PUTZ,^M<R2,R3>
        MOVL    4(AP),R2
        CLRL    R3
10$:    TSTB    (R2)[R3]
        BEQL    20$
        INCL    R3
        BRB     10$
20$:    MOVW    R3,OUTD
        MOVL    R2,OUTD+4
        PUSHAB  OUTD
        CALLS   #1,G^LIB$PUT_OUTPUT
        RET
        .ENTRY  ACTION,^M<>
        PUSHL   4(AP)
        CALLS   #1,PUTZ
        MOVL    #1,R0
        RET
        .ENTRY  START,^M<R2,R4>
        MOVAL   UNAMES,R2
30$:    MOVL    (R2)+,R4
        BEQL    40$
        PUSHAB  SEP
        CALLS   #1,PUTZ
        PUSHL   R4
        CALLS   #1,PUTZ
        PUSHL   #0
        PUSHL   #0
        PUSHAL  ACTION
        PUSHL   R4
        CALLS   #4,G^DECC$TO_VMS
        BRB     30$
40$:    MOVAL   VNAMES,R2
50$:    MOVL    (R2)+,R4
        BEQL    60$
        PUSHAB  SEP
        CALLS   #1,PUTZ
        PUSHL   R4
        CALLS   #1,PUTZ
        PUSHL   R4
        CALLS   #1,G^DECC$TRANSLATE_VMS
        TSTL    R0
        BEQL    50$
        PUSHL   R0
        CALLS   #1,PUTZ
        BRB     50$
60$:    MOVL    #1,R0
        RET
        .END    START
