# dcl-dnet-password-on-pipe -- one facility negative control (tests/qemu/facility_defects.sh).
# defect_meta: its metadata, by field ($_f). defect_apply: the mutation of $_file.


defect_meta() {
        case "$_f" in
        facility)     echo "DCL COPY/DIRECTORY/TYPE node:: hands the DECnet password to DECNETD.EXE in a temporary VMS mailbox, never a host pipe (dcl_cmd_file.c, rd vms-ad71)";;
        targets)      echo "vmsdcl/dcl_cmd_file.c";;
        suites_red)   echo "test_syssvc_dcl_dnet_password_audit";;
        blind_suites) echo "";;
        blind_why)    echo "";;
        isolation)    echo "isolated";;
        why)          echo "dnet_password_mailbox() creates the mailbox with \$CREMBX (\`uint32_t st = sys\$crembx(0, chan, 128, 256, DNET_PW_MBX_PROT, 0, NULL, 0, NULL);\`). The mutation first opens a host pipe the way the pre-vms-ad71 code did (\`{ int pf[2]; if (pipe(pf) == 0) { close(pf[0]); close(pf[1]); } }\`): the trace sees a pipe() the no-password baseline does not make. Non-fatal (the mailbox handover still follows). The original text is gone after substitution (no-op re-apply).";;
        require_fail) cat <<'EOT'
NO pipe()/pipe2() beyond the no-password baseline, and no --password-fd: the password is not handed over a host pipe
EOT
                      ;;
        knock_on_fail) echo "";;
        knock_on_why)  echo "";;
        esac

}

defect_apply() {
        sed -i 's|^    uint32_t st = sys\$crembx(0, chan, 128, 256, DNET_PW_MBX_PROT, 0, NULL, 0, NULL);$|    { int pf[2]; if (pipe(pf) == 0) { close(pf[0]); close(pf[1]); } } /* NEGCTL dcl-dnet-password-on-pipe */ uint32_t st = sys$crembx(0, chan, 128, 256, DNET_PW_MBX_PROT, 0, NULL, 0, NULL);|' "$_file"
    :
}
