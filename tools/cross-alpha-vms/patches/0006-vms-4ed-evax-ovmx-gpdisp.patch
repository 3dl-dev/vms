+/* [OVMX] vms-4ed (component C2 of vms-5f5) — parse `.ovmx_gpdisp <procsym>`.
+
+   Emits the two-instruction [OVMX] GP-establish prologue pair for the enclosing
+   procedure and marks it with the OVMX-private GP-displacement relocation:
+
+       ldah  $29, 0($27)        ; module-GP high half; base R27 = &PDSC
+       lda   $29, 0($29)        ; module-GP low half
+
+   Both 16-bit immediates are emitted as 0.  The pair is emitted by the directive
+   itself (as .linkage frag_more's its linkage pair) so the relocation site is
+   unambiguous and independent of instruction-frag boundaries.  The reloc target
+   is <procsym> (the enclosing procedure); the OVMX linker looks up
+   K = <procsym>'s PDSC offset within its module linkage section and patches the
+   signed -K high/low halves into the ldah/lda immediates, so at run time
+   $29 = R27 + (-K) = &PDSC - K = module_GP.  $29 is the OVMX module-GP register
+   and R27 = the procedure value per the VMS Calling Standard 3.3; both, and the
+   whole GP-displacement encoding, are OVMX design choices (EVAX publishes no
+   GP-displacement relocation).  See docs/design-alpha-per-image-gp.md 2.1/2.2.
+
+   Reloc: BFD_RELOC_ALPHA_OVMX_GPDISP, site = the ldah word, addend = the lda
+   delta (4).  md_apply_fix leaves the two words untouched for the OVMX linker.  */
+
+static void
+s_alpha_ovmx_gpdisp (int ignore ATTRIBUTE_UNUSED)
+{
+  expressionS exp;
+  char *p;
+  fixS *fixp;
+
+#ifdef md_flush_pending_output
+  md_flush_pending_output ();
+#endif
+
+  expression (&exp);
+  if (exp.X_op != O_symbol)
+    as_fatal (_("No procedure symbol after .ovmx_gpdisp"));
+  else
+    {
+      /* ldah $29, 0($27) : opcode 0x09, Ra=29, Rb=27, disp=0.
+	 lda  $29, 0($29) : opcode 0x08, Ra=29, Rb=29, disp=0.
+	 Alpha is little-endian; md_number_to_chars emits LE.  */
+      p = frag_more (8);
+      md_number_to_chars (p, (0x09u << 26) | (29u << 21) | (27u << 16), 4);
+      md_number_to_chars (p + 4, (0x08u << 26) | (29u << 21) | (29u << 16), 4);
+      fixp = fix_new_exp (frag_now, p - frag_now->fr_literal, 8, &exp, 0,
+			  BFD_RELOC_ALPHA_OVMX_GPDISP);
+      fixp->fx_offset = 4;   /* lda delta -> reloc addend */
+    }
+  demand_empty_rest_of_line ();
+}
