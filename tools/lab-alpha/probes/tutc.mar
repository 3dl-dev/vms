        .TITLE  TUTC
        .LIBRARY "SYS$LIBRARY:STARLET.MLB"
        $DSCDEF
        .PSECT  DATA,NOEXE,WRT,LONG
UTC:    .BLKL   4
UTC2:   .BLKL   4
QUAD:   .BLKL   2
TV:     .BLKW   7
TIMDSC: .ASCID  "29-FEB-2000 12:23:45.67"
CTL4:   .ASCID  "UTC !XL !XL !XL !XL"
CTL2:   .ASCID  "Q !XL !XL"
CTL7:   .ASCID  "TV !UW !UW !UW !UW !UW !UW !UW"
CTLS:   .ASCID  "ASC [!AD]"
CTLR:   .ASCID  "STATUS !XL"
STAT:   .BLKL   1
OUTBUF: .BLKB   160
OUTLEN: .BLKL   1
OUTDSC: .WORD   160
        .BYTE   DSC$K_DTYPE_T
        .BYTE   DSC$K_CLASS_S
        .ADDRESS OUTBUF
ASCBUF: .BLKB   64
ASCLEN: .BLKW   1
ASCDSC: .WORD   64
        .BYTE   DSC$K_DTYPE_T
        .BYTE   DSC$K_CLASS_S
        .ADDRESS ASCBUF
        .PSECT  CODE,EXE,NOWRT
PRINT:  .JSB_ENTRY
        MOVW    OUTLEN, OUTDSC
        PUSHAL  OUTDSC
        CALLS   #1, G^LIB$PUT_OUTPUT
        MOVW    #160, OUTDSC
        RSB
        .ENTRY  START, ^M<>
        $BINUTC_S TIMBUF=TIMDSC, UTCADR=UTC
        MOVL    R0, STAT
        $FAO_S  CTRSTR=CTLR, OUTLEN=OUTLEN, OUTBUF=OUTDSC, P1=STAT
        JSB     PRINT
        $FAO_S  CTRSTR=CTL4, OUTLEN=OUTLEN, OUTBUF=OUTDSC, P1=UTC, P2=UTC+4, P3=UTC+8, P4=UTC+12
        JSB     PRINT
        $NUMUTC_S TIMBUF=TV, UTCADR=UTC
        MOVL    R0, STAT
        $FAO_S  CTRSTR=CTLR, OUTLEN=OUTLEN, OUTBUF=OUTDSC, P1=STAT
        JSB     PRINT
        $FAO_S  CTRSTR=CTL7, OUTLEN=OUTLEN, OUTBUF=OUTDSC, P1=TV, P2=TV+2, P3=TV+4, P4=TV+6, P5=TV+8, P6=TV+10, P7=TV+12
        JSB     PRINT
        $ASCUTC_S TIMLEN=ASCLEN, TIMBUF=ASCDSC, UTCADR=UTC
        MOVL    R0, STAT
        $FAO_S  CTRSTR=CTLR, OUTLEN=OUTLEN, OUTBUF=OUTDSC, P1=STAT
        JSB     PRINT
        MOVZWL  ASCLEN, R1
        $FAO_S  CTRSTR=CTLS, OUTLEN=OUTLEN, OUTBUF=OUTDSC, P1=R1, P2=ASCBUF
        JSB     PRINT
        PUSHL   #0
        PUSHAL  UTC
        PUSHAL  QUAD
        CALLS   #3, G^SYS$TIMCON
        MOVL    R0, STAT
        $FAO_S  CTRSTR=CTLR, OUTLEN=OUTLEN, OUTBUF=OUTDSC, P1=STAT
        JSB     PRINT
        $FAO_S  CTRSTR=CTL2, OUTLEN=OUTLEN, OUTBUF=OUTDSC, P1=QUAD, P2=QUAD+4
        JSB     PRINT
        PUSHL   #1
        PUSHAL  UTC2
        PUSHAL  QUAD
        CALLS   #3, G^SYS$TIMCON
        MOVL    R0, STAT
        $FAO_S  CTRSTR=CTLR, OUTLEN=OUTLEN, OUTBUF=OUTDSC, P1=STAT
        JSB     PRINT
        $FAO_S  CTRSTR=CTL4, OUTLEN=OUTLEN, OUTBUF=OUTDSC, P1=UTC2, P2=UTC2+4, P3=UTC2+8, P4=UTC2+12
        JSB     PRINT
        MOVL    #1, R0
        RET
        .END    START
