# dcl-create-dir-invented-msgs -- one facility negative control (tests/qemu/facility_defects.sh).
# defect_meta: its metadata, by field ($_f). defect_apply: the mutation of $_file.

defect_meta() {
        case "$_f" in
        facility)     echo "DCL CREATE/DIRECTORY reports VMS's own CREATE-I-EXISTS / CREATE-E-DIRNOTCRE conditions";;
        targets)      echo "vmsdcl/dcl_cmd_file.c";;
        suites_red)   echo "test_syssvc_dcl_create_dir";;
        blind_suites) echo "";;
        blind_why)    echo "";;
        isolation)    echo "isolated";;
        why)          echo "The mutation puts back the invented messages the oracle-captured ones replaced: %DCL-I-CREATED, directory already exists with SS\$_NORMAL, and %RMS-E-CRE, cannot create directory with SS\$_FILACCERR. Gone after substitution (no-op re-apply).";;
        require_fail) cat <<'EOF2'
an existing directory is %CREATE-I-EXISTS, <spec> already exists (oracle)
an existing directory leaves $STATUS = %X00911293 (CREATE-I-EXISTS)
a failed create is %CREATE-E-DIRNOTCRE, <spec> directory file not created (oracle)
a failed create leaves $STATUS = %X009112C2 (CREATE-E-DIRNOTCRE)
EOF2
                      ;;
        knock_on_fail) cat <<'EOF2'
EOF2
                      ;;
        knock_on_why)  echo "";;
        esac

}

defect_apply() {
        # UNIQUE TEXT: the two message helpers' bodies.
        sed -i 's|^    dcl_error("CREATE", 3, "EXISTS", "%s already exists", spec);$|    dcl_error("DCL", 0, "CREATED", "directory already exists - %s", spec); return SS$_NORMAL; /* NEGCTL dcl-create-dir-invented-msgs */|' "$_file"
        sed -i 's|^    dcl_error("CREATE", 2, "DIRNOTCRE", "%s directory file not created", spec);$|    dcl_error("RMS", 2, "CRE", "cannot create directory - %s", spec); (void)why; return SS$_FILACCERR; /* NEGCTL dcl-create-dir-invented-msgs */|' "$_file"
    :
}
