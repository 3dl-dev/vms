To re-vendor at a new pin:
  curl -LO https://ftp.gnu.org/gnu/binutils/binutils-<new-version>.tar.xz
  tar xf binutils-<new-version>.tar.xz
  cd binutils-<new-version> && rm -rf gold ld gprof gprofng libctf elfcpp binutils
  find . -maxdepth 2 -type d \( -name testsuite -o -name po -o -name doc \) -exec rm -rf {} +
  rsync -a --delete ./ third-party/binutils/src/
  # update the fields above with the new tarball name/date/sha256sum.
