$ SET DEFAULT SYS$SYSDEVICE:[ACLT]
$ CALL RD G1.DAT
$ CALL RD G2.DAT
$ CALL RD G3.DAT
$ CALL RD G4.DAT
$ EXIT
$RD: SUBROUTINE
$ OPEN/READ/ERROR=BAD X 'P1'
$ CLOSE X
$ WRITE SYS$OUTPUT "ACLPROBE ''F$GETJPI("","USERNAME")' ''P1' READ granted"
$ EXIT
$BAD:
$ WRITE SYS$OUTPUT "ACLPROBE ''F$GETJPI("","USERNAME")' ''P1' READ status=", $STATUS
$ EXIT
$ ENDSUBROUTINE
