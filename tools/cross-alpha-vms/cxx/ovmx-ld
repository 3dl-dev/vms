#!/bin/bash
# ovmx-ld -- the alpha-dec-vms C/C++ toolchain's `ld` (vms-4d0): OVMX LINK.EXE.
#
# The gcc driver (collect2) calls `ld` GNU-style, e.g.
#   ld [vms-dwarf2eh.o] -o OUT crt0.o crtbegin.o -L... OBJS... -lstdc++ -lm -lgcc -lc crtend.o
# This maps that onto the link an OpenVMS host does: LINK the objects, in the
# given order, against the OVMX shareables -- DECC$SHR (the C RTL), LIBOTS$SHR
# (OTS$ integer divide), LIBVMSRMS$SHR and LIBVMS$SHR when present -- searching
# each object library where it appears (`-lX` -> --library libX.a) and STARLET
# last, as VMS LINK searches SYS$LIBRARY:STARLET.OLB. STRICT: an undefined
# symbol fails the link (%LINK-F-UNDEF), so autoconf link tests get truthful
# answers from the real OVMX surface. The executable is linked in P0 (vms-035).
#
# Layout ($OVMX_ALPHA_SYSROOT, default: <prefix>/ovmx beside this script):
#   LINK.EXE  DECC$SHR.EXE  LIBOTS_SHR.EXE  STARLET.a  [LIBVMSRMS$SHR.EXE  LIBVMS$SHR.EXE]
set -u
HERE=$(cd "$(dirname "$0")" && pwd)
S=${OVMX_ALPHA_SYSROOT:-$(cd "$HERE/../../ovmx" 2>/dev/null && pwd)}
[ -n "$S" ] && [ -x "$S/LINK.EXE" ] || { echo "%OVMX-LD-F-NOSYSROOT, no OVMX link environment (LINK.EXE) at ${S:-<unset>}" >&2; exit 1; }
out=a.out
args=()
Ldirs=()
while [ $# -gt 0 ]; do
  a=$1; shift
  case "$a" in
    -o) out=$1; shift ;;
    -o*) out=${a#-o} ;;
    -L) Ldirs+=("$1"); shift ;;
    -L*) Ldirs+=("${a#-L}") ;;
    -lc|-lc_p|-lg) ;;                       # the C RTL is DECC$SHR (--use below)
    -l*)
      n=${a#-l}; f=""
      for d in "${Ldirs[@]}"; do [ -f "$d/lib$n.a" ] && { f="$d/lib$n.a"; break; }; done
      if [ -z "$f" ]; then
        [ "$n" = m ] && continue             # libm is part of the C RTL
        echo "%OVMX-LD-F-NOLIB, library -l$n not found" >&2; exit 1
      fi
      args+=(--library "$f") ;;
    -*) ;;                                   # GNU-ld options with no LINK meaning
    */*.o|*/*.obj|*.o|*.obj)
      [ -f "$a" ] || { echo "%OVMX-LD-F-NOFILE, $a not found" >&2; exit 1; }
      args+=("$a") ;;
    *) args+=("$a") ;;
  esac
done
uses=(--use "$S/DECC\$SHR.EXE" --use "$S/LIBOTS_SHR.EXE")
[ -f "$S/LIBVMSRMS\$SHR.EXE" ] && uses+=(--use "$S/LIBVMSRMS\$SHR.EXE")
[ -f "$S/LIBVMS\$SHR.EXE" ] && uses+=(--use "$S/LIBVMS\$SHR.EXE")
exec "$S/LINK.EXE" --transfer __main "${uses[@]}" -o "$out" "${args[@]}" --library "$S/STARLET.a"
