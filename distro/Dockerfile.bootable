# Dockerfile.bootable - Build and boot a minimal OVMX/Linux system
#
# Produces a Docker image that boots OVMX in QEMU. All dependencies
# (compiler, QEMU, kernel, initramfs) are contained — no host tools needed.
#
# ONE initramfs image is produced (vms-1ab, docs/design-vms-faithful-install.md
# §3.1 "Fat initramfs" KILL row): the initramfs is VMB/SYSBOOT — it loads the
# executive and mounts the (already-installed) system disk. It is never
# installation media; PID 1 no longer has any install path to smuggle onto it
# (vms-2f0, docs/design-init-scope.md §6).
#
#   initramfs-ovmx.cpio.gz — bootstrap only. Contains: STARTUP.EXE (/init),
#                            kernel modules (vms.ko, vmsfs.ko), minimal config
#                            (SYSUAF, SYS$MANAGER files). NOT INITIALIZE.EXE
#                            (mkfs belongs to the installed system + the
#                            distribution disk, not the bootstrap) and none of
#                            DCL.EXE/LOGINOUT.EXE/IMGACT.EXE/the SYSLIB
#                            shareables — those come off the system disk
#                            (/vms), which arrives pre-installed
#                            (/boot/ovmx-distrib.img, vms-8ab).
#
# Also shipped under the alias initramfs-ovmx-slim.cpio.gz — byte-identical
# content, kept only so other build/test consumers that still name the "slim"
# initramfs (tests/qemu/test_distrib_boot.sh and friends, out of this item's
# scope) keep working unmodified. There is exactly one initramfs; "slim" is a
# filename alias, not a second build.
#
# STARTUP.EXE (ovmx_init) is /init — no busybox, no shell scripts.
# It handles all boot setup: filesystem mounts, kernel modules, VMS
# directory provisioning, SYSUAF user creation, daemon startup, login loop.
#
# Usage:
#   docker build -f distro/Dockerfile.bootable -t ovmx-boot .
#   docker run --rm -it ovmx-boot

# -- link-native stage -----------------------------------------------------
# Builds the VMS-native LINK.EXE shareable-image graph (DECC$SHR.EXE,
# LIBVMSSYS$SHR.EXE, LIBVMSPROCESS$SHR.EXE, LIBVMSLNM$SHR.EXE,
# LIBVMSFS$SHR.EXE, LIBVMS$SHR.EXE, LIBVMSRMS$SHR.EXE, DCL.EXE, LOGINOUT.EXE)
# via `cmake --build --target link_native_graph` (OVMX_LINK_NATIVE, beads
# vms-b6a/vms-6da, docs/design-link-native-toolchain.md) plus IMGACT.EXE (the
# freestanding image activator, built by its own standalone Makefile — bead
# vms-913.11). Replaces vms-913.6 (cancelled: DT_HASH/ld-based dynamic ELF
# was a proven dead end) — these images carry NO DT_NEEDED/DT_HASH; IMGACT.EXE
# activates them by resolving each image's .vms$sv symbol vector instead.
#
# Real alpine:3.20 musl (not musl-tools on Ubuntu) — same container CI's
# link-native-cmake-x86_64 job uses; OVMX_LINK_NATIVE auto-detects ON only
# when `$CC -dumpmachine` reports an aarch64/x86_64 *-musl triple, which
# Ubuntu's musl-gcc wrapper does not.
FROM --platform=linux/amd64 alpine:3.20 AS link-native

RUN apk add --no-cache cmake gcc g++ musl-dev binutils make linux-headers

WORKDIR /src
COPY . .

RUN cmake -B /tmp/build -DBUILD_TESTS=OFF -DBUILD_TOOLS=ON -DCMAKE_BUILD_TYPE=Release && \
    cmake --build /tmp/build --target link_native_graph -j"$(nproc)"

# IMGACT.EXE — not part of the CMake OVMX_LINK_NATIVE graph (it gates on the
# separate OVMX_IMGACT option, which CMake keeps mutually exclusive with
# OVMX_STATIC and this configure never sets); built directly via its own
# Makefile, same musl container, same x86_64 target.
RUN cd src/imgact && make CC=gcc ARCH=x86_64

# PARTS.EXE — the OVMX 0.2 "it runs a real VMS app" demo (beads vms-e97/f20,
# src/apps/parts/), built with the EXACT same cc -> LINK.EXE toolchain as
# DCL.EXE/LOGINOUT.EXE above, via its own recipe (src/apps/parts/mk_parts.sh).
# PARTS.EXE and the recipe are already on main (owned by vms-e97/f20); wiring
# the build into this image and mastering the result into SYS$UPDATE: (below)
# is vms-cde. CFLAGS mirror build_link_native.sh's x86_64 ARCHFLAG
# (-mtls-dialect=gnu2) — this is the same alpine amd64 musl container that
# built LINK.EXE/DECC$SHR.EXE/LIBVMSRMS$SHR.EXE above, so PARTS is compiled
# and linked against those exact producer images.
RUN CC=gcc CFLAGS="-fPIC -O2 -ffreestanding -fno-builtin -fno-stack-protector -mtls-dialect=gnu2" \
    sh src/apps/parts/mk_parts.sh \
        /tmp/build/bin/LINK.EXE \
        /tmp/build/link-native/PARTS.EXE \
        "/tmp/build/link-native/SYSLIB/DECC\$SHR.EXE" \
        "/tmp/build/link-native/SYSLIB/LIBVMSRMS\$SHR.EXE"

# Ground-source gate, baked into the build itself (not just asserted by a
# separate CI job elsewhere): every artifact this stage ships must be a real
# LINK.EXE-built x86_64 image with NO DT_NEEDED/DT_HASH (LINK.EXE emits no
# .dynamic section at all — resolution is via .vms$sv, not ld.so) and
# IMGACT.EXE must be the freestanding activator (no PT_INTERP of its own).
RUN set -e; \
    SYSLIB=/tmp/build/link-native/SYSLIB; SYSEXE=/tmp/build/link-native/SYSEXE; \
    for f in "$SYSLIB"/*.EXE "$SYSEXE"/*.EXE; do \
        echo "-- $f --"; \
        readelf -h "$f" | grep -q "Machine:.*X86-64" || { echo "FAIL: $f not EM_X86_64"; exit 1; }; \
        N=$(readelf -d "$f" 2>/dev/null | grep -c NEEDED || true); \
        [ "$N" -eq 0 ] || { echo "FAIL: $f has $N DT_NEEDED entries (ld-linked, not VMS-native)"; exit 1; }; \
        H=$(readelf -d "$f" 2>/dev/null | grep -c HASH || true); \
        [ "$H" -eq 0 ] || { echo "FAIL: $f has $H DT_HASH entries (ld-linked, not VMS-native)"; exit 1; }; \
    done; \
    COUNT=$(ls "$SYSLIB"/*.EXE "$SYSEXE"/*.EXE | wc -l); \
    [ "$COUNT" -eq 9 ] || { echo "FAIL: expected 9 VMS-native artifacts, got $COUNT"; exit 1; }; \
    readelf -h src/imgact/IMGACT.EXE | grep -q "Machine:.*X86-64" || { echo "FAIL: IMGACT.EXE not EM_X86_64"; exit 1; }; \
    if readelf -l src/imgact/IMGACT.EXE 2>/dev/null | grep -q INTERP; then \
        echo "FAIL: IMGACT.EXE itself must have no PT_INTERP"; exit 1; \
    fi; \
    echo "OK: 9 VMS-native LINK.EXE artifacts (EM_X86_64, zero DT_NEEDED/DT_HASH) + IMGACT.EXE"; \
    P=/tmp/build/link-native/PARTS.EXE; \
    readelf -h "$P" | grep -q "Machine:.*X86-64" || { echo "FAIL: PARTS.EXE not EM_X86_64"; exit 1; }; \
    NP=$(readelf -d "$P" 2>/dev/null | grep -c NEEDED || true); \
    [ "$NP" -eq 0 ] || { echo "FAIL: PARTS.EXE has $NP DT_NEEDED entries (ld-linked, not VMS-native)"; exit 1; }; \
    HP=$(readelf -d "$P" 2>/dev/null | grep -c HASH || true); \
    [ "$HP" -eq 0 ] || { echo "FAIL: PARTS.EXE has $HP DT_HASH entries (ld-linked, not VMS-native)"; exit 1; }; \
    readelf -l "$P" 2>/dev/null | grep -q INTERP || { echo "FAIL: PARTS.EXE has no PT_INTERP (not IMGACT-activated)"; exit 1; }; \
    echo "OK: PARTS.EXE is VMS-native (EM_X86_64, zero DT_NEEDED/DT_HASH, PT_INTERP present)"

# -- kernel-build stage ----------------------------------------------------
# Builds the OVMX bootable kernel FROM PINNED UPSTREAM SOURCE (vms-448, parent
# vms-19e "owns-kernel"), replacing the old `apt install linux-image-generic +
# copy stock vmlinuz` path. That path made the shipped kernel = whatever apt
# happened to resolve; this one pins an exact upstream LTS tarball verified by
# SHA-256 so the kernel is reproducible and ours.
#
# PINNED: linux-6.12.103 (kernel.org "longterm"/LTS; 6.12 is the LTS floor the
# vms-448 item names). Bump KERNEL_VERSION + KERNEL_SHA256 together to move it
# -- never float the version.
#   Integrity: KERNEL_SHA256 is the tarball's sha256 as published in the
#   PGP-signed https://cdn.kernel.org/pub/linux/kernel/v6.x/sha256sums.asc
#   (cross-checked against a live download of the tarball).
#
#   WHY 6.12 AND NOT THE NEWEST LTS (6.18): vmsfs.ko is written against the
#   pre-6.14 VFS mount surface -- super_block.s_d_op (replaced by
#   set_default_d_op() in 6.14) and mount_bdev()/mount_nodev() (removed for the
#   fs_context get_tree_* API in 6.14). vms.ko builds clean on 6.18, but vmsfs.ko
#   does not; porting it to the modern mount API is real, separate work tracked
#   apart from this item (see PR). 6.12 LTS keeps BOTH modules building unchanged
#   while still giving us a pinned, from-source, reproducible kernel -- which is
#   what vms-448 is actually about. Advancing the floor is gated on that port.
#
# This is BUILD tooling, not a runtime (CLAUDE.md Rule 9): the kernel-build
# deps live only in this container stage; NOTHING is installed on the host.
FROM ubuntu:24.04 AS kernel-build

ENV DEBIAN_FRONTEND=noninteractive

ARG KERNEL_VERSION=6.12.103
ARG KERNEL_SHA256=f143aaade8877ba5616e788b4482576db28481bcf557ef537f4fcc3938fc3176

# Reproducible-build clock (vms-d73). The bootable vmlinuz produced here is one
# of the four artifacts the cut-release-reproducible gate cmps byte-for-byte
# across two independent --no-cache cuts. A stock kernel build embeds the
# wall-clock build time + build user/host into the image (UTS_VERSION), so two
# builds differ. cut-release.sh passes the commit's own timestamp as
# SOURCE_DATE_EPOCH to every stage; we derive KBUILD_BUILD_TIMESTAMP from it and
# fix KBUILD_BUILD_USER/HOST, so both cuts embed identical strings. Default 0
# (Unix epoch) for ordinary builds (boot.sh) -- still deterministic.
ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc make bc bison flex libssl-dev libelf-dev \
    xz-utils curl ca-certificates kmod cpio \
    && rm -rf /var/lib/apt/lists/*

# Fetch + integrity-verify + unpack the pinned source. The build FAILS closed
# if the sha256 does not match -- no unpinned/tampered source ever compiles.
WORKDIR /usr/src
RUN KMAJ=$(echo "$KERNEL_VERSION" | cut -d. -f1) && \
    curl -fsSL -o linux.tar.xz \
      "https://cdn.kernel.org/pub/linux/kernel/v${KMAJ}.x/linux-${KERNEL_VERSION}.tar.xz" && \
    echo "${KERNEL_SHA256}  linux.tar.xz" | sha256sum -c - && \
    tar -xf linux.tar.xz && \
    rm linux.tar.xz && \
    ln -s "linux-${KERNEL_VERSION}" linux

WORKDIR /usr/src/linux

# Overlay the OVMX kernel modules IN-TREE (vms-934, parent vms-19e "owns-kernel";
# generalized into a reusable module home by vms-bae). drivers/ovmx/ is a MENU:
# the overlay DISCOVERS each self-describing module subdir under
# distro/kernel/drivers-ovmx/<mod>/ (Kconfig + Kbuild + sources.conf), flattens
# the canonical source each names, and GENERATES drivers/ovmx/{Kconfig,Makefile}
# + wires drivers/ovmx into the kernel's drivers/Kconfig + drivers/Makefile.
# Done BEFORE `make defconfig`/olddefconfig so the CONFIG_OVMX_<MOD> symbols are
# recognised, and BEFORE `make modules` so each <mod>.ko builds as part of OUR
# kernel tree -- modpost then stamps modinfo intree=Y and finit_module() at boot
# does NOT set TAINT_OUT_OF_TREE. A new OVMX module needs no edit here (COPY is
# the whole scaffold dir). The standalone src/kernel Makefiles are untouched and
# still drive the QEMU test harness out-of-tree; this is an overlay, not a fork.
# See docs/adding-an-ovmx-kernel-module.md.
COPY src/kernel                          /tmp/ovmx-src/src/kernel
COPY src/kernel-core                     /tmp/ovmx-src/src/kernel-core
COPY distro/kernel/drivers-ovmx          /tmp/ovmx-src/distro/kernel/drivers-ovmx
COPY distro/kernel/overlay-ovmx-drivers.sh /tmp/ovmx-src/distro/kernel/overlay-ovmx-drivers.sh
RUN bash /tmp/ovmx-src/distro/kernel/overlay-ovmx-drivers.sh /usr/src/linux /tmp/ovmx-src

# Module signing key (vms-ff5, parent vms-19e "owns-kernel"). CONFIG_MODULE_SIG
# is enabled in the fragment below with CONFIG_MODULE_SIG_KEY="ovmx-module-
# signing-key.pem" -- a path the kernel build resolves relative to THIS source
# tree root. It must be the COMMITTED key (deterministic across builds), not the
# kernel's default build-ephemeral key: an ephemeral key regenerates randomly
# every build, which would change both the keyring cert baked into vmlinuz and
# the module signatures in the initramfs, reddening cut-release-reproducible
# (vms-d73). Copied in BEFORE the config/build so certs/Makefile embeds this
# exact certificate into the built-in trusted keyring. SIG_FORCE stays off
# (fragment + gate below), so this key gates nothing at load -- it only lets the
# kernel VERIFY the signature and thus NOT set TAINT_UNSIGNED_MODULE.
COPY distro/kernel/ovmx-module-signing-key.pem /usr/src/linux/ovmx-module-signing-key.pem

# Curated config: x86_64 defconfig + the OVMX boot fragment, reconciled with
# olddefconfig. The fragment (distro/kernel/ovmx-x86_64.config) is the
# single source of the OVMX-required option set; see its header.
COPY distro/kernel/ovmx-x86_64.config /tmp/ovmx-x86_64.config
RUN make ARCH=x86_64 defconfig && \
    ./scripts/kconfig/merge_config.sh -m .config /tmp/ovmx-x86_64.config && \
    make ARCH=x86_64 olddefconfig

# Hard gate: every load-bearing option MUST be enabled as expected. A future
# defconfig drift or a fragment typo that silently drops one of these would
# otherwise only surface as a mystery boot hang -- fail the build instead.
RUN set -e; \
    need_y="CONFIG_SERIAL_8250_CONSOLE CONFIG_VIRTIO_PCI CONFIG_VIRTIO_BLK \
            CONFIG_VIRTIO_NET CONFIG_DEVTMPFS CONFIG_TMPFS CONFIG_PROC_FS \
            CONFIG_SYSFS CONFIG_BLK_DEV_INITRD CONFIG_RD_GZIP CONFIG_MODULES \
            CONFIG_BINFMT_ELF CONFIG_EXT4_FS"; \
    for opt in $need_y; do \
        grep -q "^${opt}=y$" .config || { echo "FAIL: ${opt} not =y in built kernel .config"; exit 1; }; \
    done; \
    grep -q "^CONFIG_MODULE_SIG=y$" .config || { echo "FAIL: CONFIG_MODULE_SIG=y not set -- modules would not be verifiable, TAINT_UNSIGNED_MODULE would stay set (vms-ff5)"; exit 1; }; \
    grep -q '^CONFIG_MODULE_SIG_KEY="ovmx-module-signing-key.pem"$' .config || { echo "FAIL: CONFIG_MODULE_SIG_KEY not pinned to the committed OVMX key -- signatures/keyring would be non-reproducible (vms-ff5/vms-d73)"; exit 1; }; \
    if grep -q "^CONFIG_MODULE_SIG_FORCE=y$" .config; then \
        echo "FAIL: CONFIG_MODULE_SIG_FORCE=y is deferred (vms-ff5) and would brick boot if a module failed verification"; exit 1; \
    fi; \
    grep -q "^CONFIG_OVMX=y$" .config || { echo "FAIL: CONFIG_OVMX=y not set (the drivers/ovmx menu; vms-934)"; exit 1; }; \
    for sym in $(grep -h '^config OVMX_' drivers/ovmx/*/Kconfig | awk '{print $2}'); do \
        grep -q "^CONFIG_${sym}=m$" .config || { echo "FAIL: CONFIG_${sym}=m not set (in-tree OVMX module would not build; vms-934/vms-bae)"; exit 1; }; \
    done; \
    echo "OK: OVMX kernel .config carries every load-bearing option + CONFIG_OVMX=y and every discovered in-tree OVMX module (=m)"

# Build the bzImage + in-tree modules. Record the exact kernelrelease string
# (e.g. 6.12.103-ovmx) so downstream stages name modules/headers consistently.
#
# Reproducibility (vms-d73): fix the three build-identity strings the kernel
# would otherwise stamp from the environment. KBUILD_BUILD_TIMESTAMP comes from
# SOURCE_DATE_EPOCH (deterministic given the commit); USER/HOST are constants.
# The build number (#1) is deterministic here because --no-cache always builds
# from a fresh tree (.version starts at 1). Struct-layout randomization stays
# off (the config fragment keeps CONFIG_RANDSTRUCT_NONE) so there is no
# per-build seed; module signing is off (fragment) so there is no random key.
RUN export KBUILD_BUILD_TIMESTAMP="$(date -u -d "@${SOURCE_DATE_EPOCH}")" && \
    export KBUILD_BUILD_USER=ovmx KBUILD_BUILD_HOST=ovmx && \
    make ARCH=x86_64 -j"$(nproc)" bzImage modules && \
    mkdir -p /kernel-out && \
    cp arch/x86/boot/bzImage /kernel-out/vmlinuz && \
    make -s ARCH=x86_64 kernelrelease > /kernel-out/kernelrelease && \
    echo "Built OVMX kernel: $(cat /kernel-out/kernelrelease), bzImage $(ls -lh /kernel-out/vmlinuz | awk '{print $5}'), TS=$KBUILD_BUILD_TIMESTAMP"

# Harvest the IN-TREE-built OVMX modules (vms-934) and prove they are BOTH
# in-tree (vms-934) AND signed (vms-ff5) right here, fail-closed.
#
# GENERALIZED (vms-bae): this DISCOVERS every module the overlay built under
# drivers/ovmx/*/*.ko rather than naming vms/vmsfs. A new OVMX module (a new
# drivers-ovmx/<mod>/ subdir + CONFIG_OVMX_<MOD>=m) is harvested, verified and
# signed here with ZERO edits to this loop -- that is the "inherits intree=Y +
# signing for free" property. Each .ko lands at /kernel-out/<mod>.ko.
#
#   intree=Y  (vms-934): modpost stamps this for a module built as part of the
#     kernel tree (not via M=); it is exactly what makes loading it NOT set
#     TAINT_OUT_OF_TREE. A refactor back to an out-of-tree build would flip it
#     to "N"/absent and redden here before anything boots.
#
#   signed     (vms-ff5): the module carries a PKCS#7 appended signature made
#     with the committed OVMX key whose cert is in this kernel's built-in
#     keyring -- so finit_module() verifies it at load and does NOT set
#     TAINT_UNSIGNED_MODULE (bit 13 / 'E'). CONFIG_MODULE_SIG_ALL signs at
#     modules_install, but these .ko are harvested straight from the build
#     tree, so we sign them EXPLICITLY here (guarded: skip if the build already
#     signed them, so we never append a second, corrupting signature). The same
#     committed PEM supplies both the private key and the X.509 cert to
#     scripts/sign-file -- no dependency on the build's internal cert path.
RUN KEY=/usr/src/linux/ovmx-module-signing-key.pem; \
    n=0; \
    for KOSRC in drivers/ovmx/*/*.ko; do \
        [ -e "$KOSRC" ] || { echo "FAIL: no drivers/ovmx/*/*.ko built -- overlay/config regression (vms-934/vms-bae)"; exit 1; }; \
        ko=$(basename "$KOSRC" .ko); \
        KO=/kernel-out/${ko}.ko; \
        cp "$KOSRC" "$KO"; \
        it=$(modinfo -F intree "$KO"); \
        [ "$it" = "Y" ] || { echo "FAIL: ${ko}.ko intree='${it}' != Y -- module did not build in-tree (vms-934)"; exit 1; }; \
        if [ -z "$(modinfo -F signer "$KO" 2>/dev/null)" ]; then \
            ./scripts/sign-file sha256 "$KEY" "$KEY" "$KO" || { echo "FAIL: could not sign ${ko}.ko (vms-ff5)"; exit 1; }; \
        fi; \
        sg=$(modinfo -F signer "$KO" 2>/dev/null); \
        [ -n "$sg" ] || { echo "FAIL: ${ko}.ko carries NO signature -- finit_module() would set TAINT_UNSIGNED_MODULE (vms-ff5)"; exit 1; }; \
        echo "OK: ${ko}.ko intree=Y + signed by '$sg'"; \
        n=$((n + 1)); \
    done; \
    [ "$n" -ge 2 ] || { echo "FAIL: harvested $n OVMX module(s); expected at least vms.ko + vmsfs.ko (vms-934)"; exit 1; }; \
    [ -f /kernel-out/vms.ko ] && [ -f /kernel-out/vmsfs.ko ] || { echo "FAIL: vms.ko/vmsfs.ko not harvested (vms-934)"; exit 1; }; \
    echo "OK: $n OVMX module(s) built IN-TREE (intree=Y, no TAINT_OUT_OF_TREE) and SIGNED (no TAINT_UNSIGNED_MODULE)"

FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# Reproducible-build clock (vms-d73, tools/cut-release.sh). Every wall-clock
# timestamp this stage bakes into a shipped artifact -- the OVMX kit header's
# kh_build_time (tools/ovmx_kit_pack.c) and the mastered VMSFS image's
# fh_created/fh_modified/fh_accessed fields (tools/vmsfs_master.c) -- reads
# this instead of time(NULL) when it is set, and every cpio/initramfs pack
# step below normalizes its input file timestamps to it. Default 0 (the Unix
# epoch) so ordinary builds (boot.sh, other CI jobs) that never pass the
# build-arg still produce a deterministic, harmless value; cut-release.sh
# passes the real HEAD commit time so a release's artifacts carry an honest,
# reproducible date instead of 1970.
ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

# NB: NO linux-headers-generic / linux-image-generic here anymore (vms-448).
# The kernel + its build tree now come from the kernel-build stage above
# (pinned upstream source), not from apt. linux-libc-dev stays -- it only
# supplies the UAPI headers musl-gcc needs for the userspace build below.
# libelf1: the from-source kernel's objtool (copied in the built tree below)
# is dynamically linked against libelf.so.1 and runs during the external
# module build -- without it the vms.ko/vmsfs.ko compile dies with
# "libelf.so.1: cannot open shared object file". (The stock-kernel path used to
# get libelf transitively via linux-headers-generic, now dropped.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake gcc make musl-tools linux-libc-dev \
    kmod cpio binutils libelf1 \
    && rm -rf /var/lib/apt/lists/*

# The from-source OVMX kernel (vms-448): its built tree (for external module
# builds) + the bzImage that becomes the bootable vmlinuz + the exact
# kernelrelease string. Replaces the stock Ubuntu vmlinuz entirely.
COPY --from=kernel-build /usr/src/linux-*/ /usr/src/ovmx-kernel/
COPY --from=kernel-build /kernel-out/vmlinuz /boot/vmlinuz
COPY --from=kernel-build /kernel-out/kernelrelease /tmp/kver

# VMS-native LINK.EXE shareable graph (DCL.EXE, LOGINOUT.EXE, the 7
# shareables) + IMGACT.EXE, built by the link-native stage above.
COPY --from=link-native /tmp/build/link-native/SYSLIB /link-native/SYSLIB
COPY --from=link-native /tmp/build/link-native/SYSEXE /link-native/SYSEXE
COPY --from=link-native /src/src/imgact/IMGACT.EXE /link-native/IMGACT.EXE
COPY --from=link-native /tmp/build/link-native/PARTS.EXE /link-native/PARTS.EXE

# KVER is the from-source kernel's kernelrelease (copied from kernel-build as
# /tmp/kver above, e.g. 6.18.44-ovmx). The build tree lives at
# /usr/src/ovmx-kernel; expose it at the conventional /lib/modules/<ver>/build
# path so the module Makefiles' default KDIR resolves too.
RUN KVER=$(cat /tmp/kver) && \
    mkdir -p "/lib/modules/${KVER}" && \
    ln -sf /usr/src/ovmx-kernel "/lib/modules/${KVER}/build"

# Make kernel UAPI headers available to musl-gcc
# musl doesn't ship linux/ or asm/ headers — symlink from linux-libc-dev
RUN MUSL_INC=$(echo /usr/include/*-linux-musl) && \
    ARCH_INC=$(echo /usr/include/*-linux-gnu) && \
    ln -s /usr/include/linux "$MUSL_INC/linux" && \
    ln -s /usr/include/asm-generic "$MUSL_INC/asm-generic" && \
    ln -s "$ARCH_INC/asm" "$MUSL_INC/asm"

WORKDIR /src
COPY . .

# The VMS modules are now built IN-TREE by the kernel-build stage (vms-934,
# parent vms-19e "owns-kernel"): vms.ko / vmsfs.ko come from drivers/ovmx/ of
# OUR kernel tree and are stamped modinfo intree=Y (modpost), so finit_module()
# at boot does NOT set TAINT_OUT_OF_TREE. Land them at the exact paths the
# initramfs staging below already reads (src/kernel/vms.ko,
# src/kernel/vmsfs/vmsfs.ko) so nothing downstream changes. `COPY . .` above
# carries no *.ko (build artifacts, gitignored), so these overlay onto empty
# slots. The standalone src/kernel Makefiles remain the canonical source of
# record and still build these modules out-of-tree for the QEMU test harness
# (tests/qemu/, src/kernel/Dockerfile) -- unchanged by this item.
COPY --from=kernel-build /kernel-out/vms.ko       /src/src/kernel/vms.ko
COPY --from=kernel-build /kernel-out/vmsfs.ko     /src/src/kernel/vmsfs/vmsfs.ko

# The in-tree modules must carry a vermagic matching this kernel (or
# finit_module() rejects them at boot), be stamped intree=Y (or loading them
# would set TAINT_OUT_OF_TREE), AND carry a signature (or loading them would set
# TAINT_UNSIGNED_MODULE) -- assert all three here rather than discover it in
# QEMU. intree=Y is the vms-934 acceptance property; the signature is the
# vms-ff5 one; both re-checked on the exact artifact the initramfs will carry.
RUN KVER=$(cat /tmp/kver) && \
    for ko in src/kernel/vms.ko src/kernel/vmsfs/vmsfs.ko; do \
        vm=$(modinfo -F vermagic "$ko" | awk '{print $1}'); \
        [ "$vm" = "$KVER" ] || { echo "FAIL: $ko vermagic '$vm' != kernel '$KVER'"; exit 1; }; \
        it=$(modinfo -F intree "$ko"); \
        [ "$it" = "Y" ] || { echo "FAIL: $ko intree='$it' != Y -- would set TAINT_OUT_OF_TREE (vms-934)"; exit 1; }; \
        sg=$(modinfo -F signer "$ko" 2>/dev/null); \
        [ -n "$sg" ] || { echo "FAIL: $ko carries NO signature -- would set TAINT_UNSIGNED_MODULE (vms-ff5)"; exit 1; }; \
    done && \
    echo "OK: vms.ko + vmsfs.ko in-tree against OVMX kernel $KVER (vermagic matches, intree=Y, signed)"

# Build OVMX userspace — static musl (no glibc dependency)
RUN cmake -B build-static \
    -DCMAKE_C_COMPILER=musl-gcc \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/ \
    -DOVMX_STATIC=ON \
    -DBUILD_TESTS=OFF \
    -DBUILD_TOOLS=ON \
    && cmake --build build-static --parallel $(nproc) 2>&1

# -- System tree staging (OS kit + distribution image source) -----------------
# All OVMX binaries assembled into a /vms tree. This is BUILD staging only --
# it is never packed into an initramfs (vms-1ab: the fat initramfs that used
# to ship this tree as installation media is DELETED, docs/
# design-vms-faithful-install.md §3.1). It is the source the OS-kit stage and
# the mastering step below bake into ovmx-os.kit and the pre-installed
# ovmx-distrib.img; PID 1 no longer installs onto a blank disk (vms-2f0,
# docs/design-init-scope.md §6 — it mounts an installed disk or halts).
#
# ODS-2 directory layout:
#   /vms/SYS0/SYSCOMMON/SYSEXE/  — executables
#   /vms/SYS0/SYSCOMMON/SYSLIB/  — shareable images
#   /vms/SYS0/SYSCOMMON/SYSMGR/  — manager configs
#   /vms/SYS0/SYSCOMMON/SYSHLP/  — help files
#   /vms/SYS0/SYSCOMMON/SYSUPD/  — pre-PCSI layered-product install kits
#   /vms/USERS/                   — user home directories  (SYS$LOGIN base)
#   /vms/SYSTMP/                  — system scratch (SYS$SCRATCH -> [SYSTMP])
#
# [SYSTMP] and [USERS] are SYSTEM-writable persistent system-disk directories.
# They used to be created (and chowned to SYSTEM [1,4]) at boot by PID 1's
# provision_dirs()/provision_writable_dir(), which vms-2f0 DELETED under the
# operator's "STRIP ALL OF IT" ruling (docs/design-init-scope.md §6: PID 1 does
# no install work). They belong to the INSTALLED system, so they are created
# HERE, in the tree the mastering step (below) bakes into ovmx-distrib.img.
# vmsfs_master masters every directory owned by SYSTEM UIC [1,4] with
# VMSFS_PROT_DEFAULT (tools/vmsfs_master.c: MASTER_UIC_*, write_header) -- the
# exact ownership + protection provision_writable_dir() set, so SYSTEM (the
# OWNER category) can sys$create scratch/user files in them.
RUN mkdir -p /system-stage/dev /system-stage/proc /system-stage/sys \
             /system-stage/tmp /system-stage/var /system-stage/mnt \
             /system-stage/sbin \
             /system-stage/etc \
             /system-stage/lib/modules \
             /system-stage/vms/SYS0/SYSCOMMON/SYSEXE \
             /system-stage/vms/SYS0/SYSCOMMON/SYSLIB \
             /system-stage/vms/SYS0/SYSCOMMON/SYSMGR \
             /system-stage/vms/SYS0/SYSCOMMON/SYSHLP \
             /system-stage/vms/SYS0/SYSCOMMON/SYSUPD \
             "/system-stage/vms/SYS0/SYSCOMMON/SYS\$STARTUP" \
             /system-stage/vms/USERS \
             /system-stage/vms/SYSTMP && \
    # OVMX binaries → SYSEXE (STARTUP.EXE is also /init).
    # DCL.EXE + LOGINOUT.EXE + the 7 shareables are the VMS-native LINK.EXE
    # graph (link-native stage above, beads vms-b6a/vms-6da/vms-d0f5e) — ET_DYN
    # images with a .vms$sv symbol vector, NO DT_NEEDED/DT_HASH, activated by
    # IMGACT.EXE via PT_INTERP (replaces vms-913.6's cancelled DT_HASH/ld
    # approach). STARTUP.EXE and IMGACT.EXE stay static/freestanding — same
    # architectural requirement as today. The remaining utilities (HELP,
    # AUTHORIZE, MAIL, MONITOR, INITIALIZE) have no mk_*.sh VMS-native recipe
    # yet, so they ship static for 0.1 (scope decision, vms-d0f5e) — mixed
    # static+dynamic initramfs, DCL as the flagship dynamic proof.
    cp build-static/bin/STARTUP.EXE    /system-stage/init && \
    cp /link-native/IMGACT.EXE         /system-stage/vms/SYS0/SYSCOMMON/SYSEXE/ && \
    cp "/link-native/SYSEXE/DCL.EXE"      /system-stage/vms/SYS0/SYSCOMMON/SYSEXE/ && \
    cp "/link-native/SYSEXE/LOGINOUT.EXE" /system-stage/vms/SYS0/SYSCOMMON/SYSEXE/ && \
    cp /link-native/SYSLIB/*.EXE       /system-stage/vms/SYS0/SYSCOMMON/SYSLIB/ && \
    # PROVISION.EXE -- the startup process (vms-9b7). PID 1 execs THIS, not
    # DCL.EXE: it establishes the SYSTEM identity from SYSUAF through the
    # executive and then execs DCL.EXE on STARTUP.COM in the same process. A
    # boot without it halts (src/ovmx_init/ovmx_init.c run_startup), so this
    # copy is NOT best-effort -- no "2>/dev/null ;" here.
    cp build-static/bin/PROVISION.EXE  /system-stage/vms/SYS0/SYSCOMMON/SYSEXE/ && \
    # JOB_CONTROL.EXE (vms-8d2) -- the console-session process. It is
    # created DETACHED by SYS$STARTUP:JOB_CONTROL_STARTUP.COM (invoked
    # from SYSTARTUP_VMS.COM during STARTUP.COM), and PID 1's own login
    # loop is deleted, so a boot without this image on the disk reaches
    # STARTUP.COM but never a login prompt (%DCL-E-IVIMAGE, not a halt --
    # this copy is NOT best-effort, no "2>/dev/null ;" here, matching
    # PROVISION.EXE's treatment above).
    cp build-static/bin/JOB_CONTROL.EXE /system-stage/vms/SYS0/SYSCOMMON/SYSEXE/ && \
    cp build-static/bin/HELP.EXE       /system-stage/vms/SYS0/SYSCOMMON/SYSEXE/ && \
    cp build-static/bin/AUTHORIZE.EXE  /system-stage/vms/SYS0/SYSCOMMON/SYSEXE/ 2>/dev/null ; \
    cp build-static/bin/MAIL.EXE       /system-stage/vms/SYS0/SYSCOMMON/SYSEXE/ 2>/dev/null ; \
    cp build-static/bin/MONITOR.EXE    /system-stage/vms/SYS0/SYSCOMMON/SYSEXE/ 2>/dev/null ; \
    cp build-static/bin/INITIALIZE.EXE /system-stage/vms/SYS0/SYSCOMMON/SYSEXE/ 2>/dev/null ; \
    cp build-static/bin/INSTALL.EXE    /system-stage/vms/SYS0/SYSCOMMON/SYSEXE/ 2>/dev/null ; \
    # SYSGEN.EXE (vms-d34): `$ SYSGEN` (src/vmsdcl/dcl_cmd_misc.c cmd_sysgen)
    # dcl_exec_utility()'s for it at SYS$SYSTEM: -- without this copy the
    # command fails %SYSGEN-F-NOIMG and SYS$SYSTEM:OVMXVMSSYS.PAR can never
    # be read or written on the real runtime.
    cp build-static/bin/SYSGEN.EXE     /system-stage/vms/SYS0/SYSCOMMON/SYSEXE/ 2>/dev/null ; \
    # PRODUCT.EXE (vms-df9): `$ PRODUCT INSTALL`/`SHOW PRODUCT`
    # dcl_exec_utility()'s for it at SYS$SYSTEM: -- without this copy every
    # PRODUCT operation fails %PCSI-F-NOIMG on the real runtime.
    cp build-static/bin/PRODUCT.EXE    /system-stage/vms/SYS0/SYSCOMMON/SYSEXE/ 2>/dev/null ; \
    # The setuid-root mount(2)/umount(2) helper (vms-651, tools/
    # vms_mount_helper.c) -- NOT a VMS image, lives outside SYS$SYSTEM: at a
    # fixed Linux path (ovmx_layout.h VMS_MOUNT_HELPER_PATH). Owned by root
    # with the setuid bit set HERE, at build time, so no boot-time step ever
    # has to (a de-privileged session couldn't set it on itself anyway).
    cp build-static/bin/vms_mount_helper /system-stage/sbin/vms_mount_helper && \
    chown root:root /system-stage/sbin/vms_mount_helper && \
    chmod 4755 /system-stage/sbin/vms_mount_helper && \
    # Kernel modules
    cp src/kernel/vms.ko /system-stage/lib/modules/ && \
    cp src/kernel/vmsfs/vmsfs.ko /system-stage/lib/modules/ && \
    # SYSKRNL distro metadata (rd vms-700/vms-296/vms-3de, GNU/Linux-style
    # dual identity) -- standard /etc/os-release naming the "OVMX/Linux"
    # SYSKRNL layer, distinct from the "OpenVMX" VMS-facing product identity
    # (ovmx_identity.h). See distro/rootfs/etc/os-release's own header.
    cp distro/rootfs/etc/os-release /system-stage/etc/os-release && \
    # System disk config files → VMS-standard locations
    cp -r distro/rootfs/vms/SYS0/SYSCOMMON/SYSMGR/* /system-stage/vms/SYS0/SYSCOMMON/SYSMGR/ && \
    # SYS$STARTUP: (vms-21a) -- STDRV's phase/component data files
    # (VMS$PHASES.DAT, VMS$VMS.DAT). STARTUP.COM's phase driver opens these
    # by filespec at boot; without this copy every OPEN fails %RMS-E-FNF and
    # every phase (and every site file the driver invokes) silently never runs.
    cp -r "distro/rootfs/vms/SYS0/SYSCOMMON/SYS\$STARTUP/"* "/system-stage/vms/SYS0/SYSCOMMON/SYS\$STARTUP/" && \
    # SYS$HELP: (vms-01b) -- the hierarchical HELP library HELPLIB.HLP that the
    # HELP built-in (src/vmsdcl/dcl_help.c) and HELP.EXE walk. Without it the
    # booted system's HELP has no library to read and every topic fails.
    cp -r distro/rootfs/vms/SYS0/SYSCOMMON/SYSHLP/. /system-stage/vms/SYS0/SYSCOMMON/SYSHLP/ && \
    cp distro/rootfs/vms/SYS0/SYSCOMMON/SYSEXE/SYSUAF.DAT /system-stage/vms/SYS0/SYSCOMMON/SYSEXE/ && \
    cp distro/rootfs/vms/SYS0/SYSCOMMON/SYSEXE/RIGHTSLIST.DAT /system-stage/vms/SYS0/SYSCOMMON/SYSEXE/ 2>/dev/null ; \
    # OVMXVMSSYS.PAR (vms-d34): the initial SYSGEN parameter file, seeded
    # with factory defaults (SCSNODE=OVMX). Staged UNVERSIONED, same
    # convention as SYSUAF.DAT/RIGHTSLIST.DAT above -- vmsfs_master (below)
    # stamps every mastered regular file as version ;1 itself and does not
    # parse a literal ";N" already in a source-tree filename (it would land
    # in the TYPE field instead, corrupting the name), so the on-disk
    # result is the real, already-versioned OVMXVMSSYS.PAR;1 and WRITE
    # CURRENT's very first run on a fresh install lands on ;2 -- exactly
    # like the oracle's ALPHAVMSSYS.PAR (docs/design-boot-faithful.md sec 3.4).
    cp distro/rootfs/vms/SYS0/SYSCOMMON/SYSEXE/OVMXVMSSYS.PAR /system-stage/vms/SYS0/SYSCOMMON/SYSEXE/ 2>/dev/null ; \
    # SYS$UPDATE: -- the standard VMS home for pre-PCSI layered-product
    # install kits (vms-cde, parent vms-2579, docs/release-plan-0.2-to-0.5.md
    # §4). SYS$UPDATE itself is DEFINEd in SYS$MANAGER:STARTUP.COM (copied
    # above, not lnm_setup_defaults() -- see that file's own comment), so no
    # logical-name wiring is needed here, only the files. PARTS_SETUP.COM
    # (vms-977/#183) is staged in distro/rootfs/.../SYSUPD/ and copied
    # wholesale; PARTS.EXE (vms-e97/f20), the kit's image, is built above and
    # placed alongside it, exactly as PARTS_SETUP.COM's own header comment
    # describes ("the PARTS kit ... is staged in SYS$UPDATE:"). PARTS creates
    # its own indexed data file at runtime (src/apps/parts/parts.c generates
    # records programmatically) -- no seed data file is needed or shipped.
    cp -r distro/rootfs/vms/SYS0/SYSCOMMON/SYSUPD/* /system-stage/vms/SYS0/SYSCOMMON/SYSUPD/ && \
    cp /link-native/PARTS.EXE /system-stage/vms/SYS0/SYSCOMMON/SYSUPD/ && \
    # Ground-source gate: the SHIPPED DCL.EXE AND LOGINOUT.EXE (the files
    # that actually go into the initramfs STARTUP execs at boot, not a copy
    # elsewhere) must both be the VMS-native ET_DYN LINK.EXE output — no
    # DT_NEEDED, no DT_HASH. Both are gated, not just DCL.EXE: STARTUP execs
    # LOGINOUT.EXE first (src/ovmx_init/ovmx_init.c), and LOGINOUT is what
    # authenticates against SYSUAF and execs DCL.EXE next (tools/
    # vms_login.c) — LOGINOUT is the FIRST VMS-native image in the login
    # chain, and a DCL.EXE-only gate would not have caught a regression
    # that reintroduced an ld/ld.so-linked LOGINOUT.EXE ahead of it (vms-fbc).
    # This is a re-check of the ACTUAL SHIPPED bytes, deliberately redundant
    # with the generic 9-artifact loop in the link-native stage above (which
    # checks the build-output copies, not what cp placed in the initramfs):
    # a gate that only proves properties of a source file two directories
    # away from the one that boots is not proof of what boots.
    for name in "DCL.EXE" "LOGINOUT.EXE"; do \
        IMG="/system-stage/vms/SYS0/SYSCOMMON/SYSEXE/$name" && \
        readelf -h "$IMG" | grep -q "Machine:.*X86-64" || { echo "FAIL: shipped $name not EM_X86_64"; exit 1; } && \
        N=$(readelf -d "$IMG" 2>/dev/null | grep -c NEEDED || true) && \
        [ "$N" -eq 0 ] || { echo "FAIL: shipped $name has $N DT_NEEDED entries"; exit 1; } && \
        H=$(readelf -d "$IMG" 2>/dev/null | grep -c HASH || true) && \
        [ "$H" -eq 0 ] || { echo "FAIL: shipped $name has $H DT_HASH entries"; exit 1; } && \
        echo "OK: shipped $name is VMS-native (EM_X86_64, zero DT_NEEDED/DT_HASH)"; \
    done && \
    # Same shipped-bytes re-check for PARTS.EXE (vms-cde) -- the SYSUPD copy
    # is what a booted system actually gets, not the /link-native/ build
    # copy the link-native stage already checked.
    PIMG="/system-stage/vms/SYS0/SYSCOMMON/SYSUPD/PARTS.EXE" && \
    readelf -h "$PIMG" | grep -q "Machine:.*X86-64" || { echo "FAIL: shipped PARTS.EXE not EM_X86_64"; exit 1; } && \
    PN=$(readelf -d "$PIMG" 2>/dev/null | grep -c NEEDED || true) && \
    [ "$PN" -eq 0 ] || { echo "FAIL: shipped PARTS.EXE has $PN DT_NEEDED entries"; exit 1; } && \
    PH=$(readelf -d "$PIMG" 2>/dev/null | grep -c HASH || true) && \
    [ "$PH" -eq 0 ] || { echo "FAIL: shipped PARTS.EXE has $PH DT_HASH entries"; exit 1; } && \
    echo "OK: shipped PARTS.EXE is VMS-native (EM_X86_64, zero DT_NEEDED/DT_HASH)" && \
    [ -f "/system-stage/vms/SYS0/SYSCOMMON/SYSUPD/PARTS_SETUP.COM" ] || { echo "FAIL: PARTS_SETUP.COM missing from SYS\$UPDATE: (SYSUPD)"; exit 1; } && \
    echo "OK: PARTS_SETUP.COM present under SYS\$UPDATE: (SYSUPD)"
# This tree is NOT packed into an initramfs (vms-1ab) -- it flows only into
# the OS-kit stage and the distribution-image mastering step below, both of
# which stamp their own SOURCE_DATE_EPOCH-derived timestamps into their
# output (ovmx_kit_pack.c kh_build_time, vmsfs_master.c fh_created/
# fh_modified/fh_accessed), so no cpio-specific mtime normalization is
# needed here.

# -- OVMX OS kit (vms-0b6) ------------------------------------------------------
# Package the just-staged SYSEXE/SYSLIB/SYSMGR/SYSHLP payload into an OVMX
# product kit file, the container docs/design-ovmx-kit-format.md defines
# (OVMX-invented, Rule-8-labeled -- src/libvms/include/ovmx_kit_format.h).
# This is the "kit packaging at build" row of
# docs/design-vms-faithful-install.md §3.3; consuming the kit (PRODUCT
# INSTALL, the product database) is vms-df9's job, not this build's.
#
# ovmx_kit_pack (tools/ovmx_kit_pack.c) is factory BUILD tooling -- same
# class as vmsfs_master above: never shipped on the media, plain host name,
# never run at boot. It treats the direct children of its staging directory
# as top-level VMS directories, so a scratch tree carrying only the five
# component directories (not SYSUPD, which holds PARTS -- a separate,
# already-a-kit-shaped layered product, not the OS payload) is assembled
# here before packing. SYS$STARTUP (vms-21a) ships so a PRODUCT INSTALL
# upgrade carries STDRV's phase/component data files, same as any other
# system directory.
RUN mkdir -p /kit-stage/SYSEXE /kit-stage/SYSLIB /kit-stage/SYSMGR /kit-stage/SYSHLP "/kit-stage/SYS\$STARTUP" && \
    cp -r /system-stage/vms/SYS0/SYSCOMMON/SYSEXE/. /kit-stage/SYSEXE/ && \
    cp -r /system-stage/vms/SYS0/SYSCOMMON/SYSLIB/. /kit-stage/SYSLIB/ && \
    cp -r /system-stage/vms/SYS0/SYSCOMMON/SYSMGR/. /kit-stage/SYSMGR/ && \
    cp -r /system-stage/vms/SYS0/SYSCOMMON/SYSHLP/. /kit-stage/SYSHLP/ 2>/dev/null ; \
    cp -r "/system-stage/vms/SYS0/SYSCOMMON/SYS\$STARTUP/." "/kit-stage/SYS\$STARTUP/" && \
    /src/build-static/bin/ovmx_kit_pack pack /boot/ovmx-os.kit /kit-stage "X86VMS VMS" && \
    /src/build-static/bin/ovmx_kit_pack list /boot/ovmx-os.kit && \
    # Ground-source gate: the kit manifest must actually name the images the
    # login chain depends on, not just carry a file count.
    LISTING=$(/src/build-static/bin/ovmx_kit_pack list /boot/ovmx-os.kit) && \
    for name in "DCL.EXE" "LOGINOUT.EXE" "STARTUP.COM"; do \
        echo "$LISTING" | grep -q "$name" || { echo "FAIL: ovmx-os.kit manifest missing $name"; exit 1; }; \
        echo "OK: ovmx-os.kit manifest names $name"; \
    done && \
    # Persist the listing as a build artifact (vms-d73, tools/cut-release.sh):
    # the release script folds this into release-manifest.json and re-checks
    # DCL.EXE/LOGINOUT.EXE/STARTUP.COM against the SHIPPED kit's own listing,
    # not just this build-time variable. SOURCE_DATE_EPOCH normalization above
    # makes the embedded "Built:" line (kh_build_time) reproducible too.
    echo "$LISTING" > /boot/ovmx-os.kit.manifest.txt && \
    # Round-trip the kit itself here too (not just in ctest): extract and
    # byte-compare every payload file against the staged tree that was
    # packed. A flag file (not a loop exit code) carries failure out of the
    # `find | while` pipeline subshell -- POSIX sh, not bash, runs this RUN
    # step, so `exit 1` inside the pipeline would only kill the subshell.
    rm -rf /tmp/kit-verify && \
    /src/build-static/bin/ovmx_kit_pack extract /boot/ovmx-os.kit /tmp/kit-verify && \
    rm -f /tmp/kit-verify.failed && \
    find /kit-stage -type f | while read -r f; do \
        rel=$(echo "$f" | sed 's#^/kit-stage/##'); \
        cmp -s "$f" "/tmp/kit-verify/$rel" || { echo "FAIL: ovmx-os.kit did not round-trip $rel"; touch /tmp/kit-verify.failed; }; \
    done && \
    [ ! -f /tmp/kit-verify.failed ] || { echo "FAIL: ovmx-os.kit round-trip had byte mismatches"; exit 1; } && \
    echo "OK: ovmx-os.kit round-tripped byte-exact against the staged tree" && \
    rm -rf /tmp/kit-verify && \
    echo "OS kit: $(ls -lh /boot/ovmx-os.kit | awk '{print $5}')" && \
    # Also stage the kit onto the DISTRIB image itself, at SYS$UPDATE: (vms-df9
    # ground-source test), same shelf PARTS.EXE/PARTS_SETUP.COM already use.
    # WHY HERE AND NOT A RAW VIRTIO DISK: a PRODUCT INSTALL ground-source test
    # needs the guest to read the kit's bytes as SYSTEM. A THIRD raw virtio
    # block device (e.g. /dev/vdc) is owned root:root mode 0600 by devtmpfs (no
    # udev in this minimal initramfs to relax it), so SYSTEM's real UIC-derived
    # uid/gid (vms_login.c: uid=member, gid=group, [1,4] -> uid 4/gid 1) gets
    # EPERM reading it directly -- correctly: OVMX has no "VMS privilege
    # overrides Unix file permission" path for raw devices, so faking one just
    # to make a test pass would be the exact LARP class CLAUDE.md Rule 9
    # exists to prevent. Landing the kit as an ordinary SYSTEM-owned file on
    # the ALREADY-MOUNTED system disk (the same path SYSEXE/SYSLIB/SYSUPD
    # content already reaches SYSTEM through) sidesteps the whole problem
    # instead of working around it.
    cp /boot/ovmx-os.kit /system-stage/vms/SYS0/SYSCOMMON/SYSUPD/OVMX-OS.KIT && \
    echo "OK: ovmx-os.kit staged at SYS\$UPDATE:OVMX-OS.KIT for the distrib image"

# -- Distribution system-disk image (vms-8ab) ----------------------------------
# Master a PRE-INSTALLED, bootable VMSFS system disk from the SAME populated
# /vms system tree the system-tree staging stage just assembled above (/system-stage/vms:
# the [SYS0][SYSCOMMON][SYSEXE][SYSLIB][SYSMGR][SYSHLP][SYSUPD][USERS] tree with
# DCL.EXE/LOGINOUT.EXE/IMGACT.EXE/PROVISION.EXE, the SYSLIB shareables, SYSUAF,
# STARTUP.COM, PARTS). Kernel modules are deliberately NOT on the disk — they are
# initramfs cargo (/system-stage/lib/modules), loaded before any disk exists.
#
# This is the artifact a §6-stripped PID 1 boots (mount-or-halt,
# docs/design-init-scope.md §6): the disk arrives ALREADY installed, so no
# self-install runs. The boot initramfs below (STARTUP.EXE + vms.ko + vmsfs.ko +
# minimal config -- the ONLY initramfs, vms-1ab) mounts this image at /vms and
# finds the full system on it.
#
# Clean-room Rule 8: vmsfs_master (tools/vmsfs_master.c) is factory BUILD
# tooling — it is never shipped on the media, never given a VMS name, never run
# at boot. The on-disk byte layout comes entirely from the single shared
# description in src/kernel/vmsfs/vmsfs_ondisk.h (the same header vmsfs.ko and
# INITIALIZE.EXE use); VMSFS is an OVMX design choice, labeled as such in that
# header and in the tool — NOT presented as byte-authentic ODS-2. The mastering
# policy (SYSTEM UIC [1,4], every file version ;1, the OVMXSYS volume label) is
# an OVMX build-tool choice, not a VMS-authentic fact.
#
# 64 MB matches the system-disk convention used everywhere else (boot.sh /
# run-qemu.sh / test_persistent_boot.sh all size a blank DKA0: at 64M) and
# leaves free space for runtime writes (e.g. PARTS creating its indexed data
# file), while staying well above the tree's own footprint.
RUN /src/build-static/bin/vmsfs_master master \
        /boot/ovmx-distrib.img OVMXSYS /system-stage/vms 64 && \
    /src/build-static/bin/vmsfs_master list /boot/ovmx-distrib.img && \
    # Ground-source gate, baked into the build: extract the mastered image back
    # out with the tool's round-trip reader and prove the login chain the boot
    # depends on (LOGINOUT -> DCL, via IMGACT, established by PROVISION) is
    # actually PRESENT on the disk and byte-identical to what the system-tree
    # staging stage staged. A mastered image that does not carry these cannot
    # reach a login prompt, so this is checked here, not merely asserted
    # downstream.
    rm -rf /tmp/distrib-verify && \
    /src/build-static/bin/vmsfs_master extract /boot/ovmx-distrib.img /tmp/distrib-verify && \
    for name in DCL.EXE LOGINOUT.EXE IMGACT.EXE PROVISION.EXE SYSUAF.DAT; do \
        SRC="/system-stage/vms/SYS0/SYSCOMMON/SYSEXE/$name" && \
        OUT="/tmp/distrib-verify/SYS0/SYSCOMMON/SYSEXE/$name" && \
        [ -f "$OUT" ] || { echo "FAIL: mastered ovmx-distrib.img missing SYS\$SYSTEM:$name"; exit 1; } && \
        cmp -s "$SRC" "$OUT" || { echo "FAIL: mastered SYS\$SYSTEM:$name differs from staged bytes"; exit 1; } && \
        echo "OK: ovmx-distrib.img carries SYS\$SYSTEM:$name (byte-identical to staged)"; \
    done && \
    [ -f /tmp/distrib-verify/SYS0/SYSCOMMON/SYSMGR/STARTUP.COM ] || { echo "FAIL: mastered image missing SYS\$MANAGER:STARTUP.COM"; exit 1; } && \
    echo "OK: ovmx-distrib.img carries SYS\$MANAGER:STARTUP.COM" && \
    # vms-21a: STDRV's phase-driver data files must be on the mastered disk,
    # or every OPEN in STARTUP.COM's phase driver fails %RMS-E-FNF and no
    # phase (and no site file the driver invokes) ever runs.
    [ -f "/tmp/distrib-verify/SYS0/SYSCOMMON/SYS\$STARTUP/VMS\$PHASES.DAT" ] || { echo "FAIL: mastered image missing SYS\$STARTUP:VMS\$PHASES.DAT"; exit 1; } && \
    [ -f "/tmp/distrib-verify/SYS0/SYSCOMMON/SYS\$STARTUP/VMS\$VMS.DAT" ] || { echo "FAIL: mastered image missing SYS\$STARTUP:VMS\$VMS.DAT"; exit 1; } && \
    echo "OK: ovmx-distrib.img carries SYS\$STARTUP:VMS\$PHASES.DAT and VMS\$VMS.DAT" && \
    [ -f /tmp/distrib-verify/SYS0/SYSCOMMON/SYSMGR/SYCONFIG.COM ] || { echo "FAIL: mastered image missing SYS\$MANAGER:SYCONFIG.COM"; exit 1; } && \
    [ -f /tmp/distrib-verify/SYS0/SYSCOMMON/SYSMGR/SYLOGICALS.COM ] || { echo "FAIL: mastered image missing SYS\$MANAGER:SYLOGICALS.COM"; exit 1; } && \
    echo "OK: ovmx-distrib.img carries SYS\$MANAGER:SYCONFIG.COM and SYLOGICALS.COM" && \
    # The LARP config files this work deletes must never come back on the
    # mastered image -- a regression that recreates distro/rootfs/.../
    # OVMX.CONF would silently ship it again without this gate.
    [ ! -f /tmp/distrib-verify/SYS0/SYSCOMMON/SYSMGR/OVMX.CONF ] || { echo "FAIL: mastered image carries deleted SYS\$MANAGER:OVMX.CONF"; exit 1; } && \
    [ ! -f /tmp/distrib-verify/SYS0/SYSCOMMON/SYSMGR/SYLOGICALS.CONF ] || { echo "FAIL: mastered image carries deleted SYS\$MANAGER:SYLOGICALS.CONF"; exit 1; } && \
    echo "OK: ovmx-distrib.img carries neither OVMX.CONF nor SYLOGICALS.CONF" && \
    # The SYSTEM-writable persistent directories must be baked in: PID 1 no
    # longer creates them (vms-2f0), so if the mastering source ever loses them
    # SYS$SCRATCH:/SYS$LOGIN: writes fail at runtime (%RMS-E-DNF). Assert both
    # are present so a regression is caught at BUILD, not in the PARTS demo.
    [ -d /tmp/distrib-verify/SYSTMP ] || { echo "FAIL: mastered image missing [SYSTMP] (SYS\$SCRATCH:)"; exit 1; } && \
    [ -d /tmp/distrib-verify/USERS ]  || { echo "FAIL: mastered image missing [USERS]"; exit 1; } && \
    echo "OK: ovmx-distrib.img carries SYSTEM-writable [SYSTMP] and [USERS]" && \
    rm -rf /tmp/distrib-verify && \
    echo "DISTRIB image: $(ls -lh /boot/ovmx-distrib.img | awk '{print $5}')"

# -- Negative-control distribution disk (vms-2a9) -------------------------------
# A SECOND mastered disk, built from the SAME staged system tree
# (/system-stage/vms) as ovmx-distrib.img above, with exactly one line
# removed: SYS$STARTUP:VMS$VMS.DAT's CONFIG-phase JOB_CONTROL registration
# (docs/design-boot-faithful.md §3.8). Nothing else differs. This is the
# negative half of vms-2a9's ground-source proof
# (tests/qemu/test_job_control_negctl.sh): boot it and JOB_CONTROL is never
# created (no %RUN-S-PROC_ID line) and the console never reaches Username:
# (JOB_CONTROL is the only thing that creates the console login loop,
# vms-8d2) -- while STARTUP.COM still runs to completion (the
# site-specific-startup line still prints), proving the boot did not simply
# crash. Same NEGATIVE_CONTROL-style precedent as tests/qemu/Dockerfile's
# vms.ko-absent build variant, applied here to a rootfs component instead of
# a kernel module: a deliberately mutated, checked-in-mechanism artifact
# baked at build time, not edited by a test script at run time.
RUN cp -r /system-stage/vms /system-stage-negctl-vms && \
    grep -v 'JOB_CONTROL_STARTUP\.COM' \
        "/system-stage/vms/SYS0/SYSCOMMON/SYS\$STARTUP/VMS\$VMS.DAT" \
        > "/system-stage-negctl-vms/SYS0/SYSCOMMON/SYS\$STARTUP/VMS\$VMS.DAT" && \
    if grep -q 'JOB_CONTROL_STARTUP\.COM' "/system-stage-negctl-vms/SYS0/SYSCOMMON/SYS\$STARTUP/VMS\$VMS.DAT"; then \
        echo "FAIL: negctl VMS\$VMS.DAT still names JOB_CONTROL_STARTUP.COM"; exit 1; \
    fi && \
    /src/build-static/bin/vmsfs_master master \
        /boot/ovmx-distrib-negctl.img OVMXSYS /system-stage-negctl-vms 64 && \
    /src/build-static/bin/vmsfs_master list /boot/ovmx-distrib-negctl.img && \
    rm -rf /system-stage-negctl-vms && \
    echo "NEGCTL DISTRIB image: $(ls -lh /boot/ovmx-distrib-negctl.img | awk '{print $5}')"

# -- Install-media distribution disk (vms-dcf) ----------------------------------
# A SEPARATE THIRD mastered disk, built from the SAME staged system tree
# (/system-stage/vms) as ovmx-distrib.img above, with exactly one file
# replaced: SYS$MANAGER:SYSTARTUP_VMS.COM, swapped for the distribution-only
# variant (distro/rootfs-distrib-only/) that runs the install menu
# (OVMX$INSTALL.COM) before JOB_CONTROL/login -- matching the oracle
# (docs/oracle/installation-media-vax73-alpha84.md sec3a: the media boots
# straight into the menu, no login) and docs/design-vms-faithful-install.md
# sec3.3 ("the distribution disk differs from an installed system disk only
# in its payload... a site startup that runs the menu").
#
# THIS MUST BE A SEPARATE IMAGE, NOT A MUTATION OF /system-stage ITSELF OR
# OF ovmx-distrib.img (vms-dcf CI regression, PR #374 round 1): CI's
# Persistent Boot Smoke Test, test_distrib_boot.sh (consumed by the
# cut-release job), and the UAT job ALL boot ovmx-distrib.img expecting an
# ORDINARY pre-installed system disk that reaches Username: directly, with
# NO menu -- that contract predates this item (vms-8ab) and stays exactly
# as it was. Same negative-control-style pattern as vms-2a9 immediately
# above: copy the staged tree, mutate ONLY the copy, master a
# separately-named image, never touch /system-stage/vms or
# ovmx-distrib.img itself. OVMX$INSTALL.COM (the procedure file) still
# ships on every disk via the ordinary SYSMGR copy in the system-tree
# staging stage -- only which SYSTARTUP_VMS.COM invokes it differs, and
# now that difference lives entirely in this one disk.
RUN cp -r /system-stage/vms /system-stage-install-media-vms && \
    cp distro/rootfs-distrib-only/vms/SYS0/SYSCOMMON/SYSMGR/SYSTARTUP_VMS.COM \
       /system-stage-install-media-vms/SYS0/SYSCOMMON/SYSMGR/SYSTARTUP_VMS.COM && \
    grep -q 'OVMX\$INSTALL' /system-stage-install-media-vms/SYS0/SYSCOMMON/SYSMGR/SYSTARTUP_VMS.COM && \
    echo "OK: install-media image's SYSTARTUP_VMS.COM invokes OVMX\$INSTALL.COM" && \
    ! grep -q 'OVMX\$INSTALL' /system-stage/vms/SYS0/SYSCOMMON/SYSMGR/SYSTARTUP_VMS.COM && \
    echo "OK: ovmx-distrib.img's own SYSTARTUP_VMS.COM (unmodified /system-stage) does NOT invoke OVMX\$INSTALL.COM" && \
    /src/build-static/bin/vmsfs_master master \
        /boot/ovmx-install-media.img OVMXSYS /system-stage-install-media-vms 64 && \
    /src/build-static/bin/vmsfs_master list /boot/ovmx-install-media.img && \
    rm -rf /system-stage-install-media-vms && \
    echo "INSTALL-MEDIA image: $(ls -lh /boot/ovmx-install-media.img | awk '{print $5}')"

# -- Boot initramfs (vms-1ab: THE initramfs — no fat variant exists anymore) ---
# Bootstrap-only: STARTUP.EXE + kernel modules + config. NOT INITIALIZE.EXE
# (mkfs belongs to the installed system + the distribution disk, not the
# bootstrap — it ships instead in the system-tree staging above, so it lands
# on ovmx-os.kit and ovmx-distrib.img). All other binaries (DCL, LOGIN, HELP,
# IMGACT, the SYSLIB shareables) must be on the system disk, which arrives
# pre-installed (docs/design-vms-faithful-install.md §3.1).
RUN mkdir -p /initramfs-slim/dev /initramfs-slim/proc /initramfs-slim/sys \
             /initramfs-slim/tmp /initramfs-slim/var /initramfs-slim/mnt \
             /initramfs-slim/sbin \
             /initramfs-slim/etc \
             /initramfs-slim/lib/modules \
             /initramfs-slim/vms/SYS0/SYSCOMMON/SYSEXE \
             /initramfs-slim/vms/SYS0/SYSCOMMON/SYSMGR && \
    # Bootstrap binary only -- STARTUP.EXE (/init). INITIALIZE.EXE stays off
    # the bootstrap (see header above); it is already staged onto the
    # distribution disk by the system-tree stage.
    cp build-static/bin/STARTUP.EXE    /initramfs-slim/init && \
    # MOUNT/DISMOUNT (vms-651) need this on every boot -- DCL comes off the
    # system disk, but the helper still lives at the same fixed Linux path
    # outside the VMS tree.
    cp build-static/bin/vms_mount_helper /initramfs-slim/sbin/vms_mount_helper && \
    chown root:root /initramfs-slim/sbin/vms_mount_helper && \
    chmod 4755 /initramfs-slim/sbin/vms_mount_helper && \
    # Kernel modules
    cp src/kernel/vms.ko /initramfs-slim/lib/modules/ && \
    cp src/kernel/vmsfs/vmsfs.ko /initramfs-slim/lib/modules/ && \
    # SYSKRNL distro metadata (rd vms-700/vms-296/vms-3de) -- same
    # os-release as the system-tree stage, see its comment there.
    cp distro/rootfs/etc/os-release /initramfs-slim/etc/os-release && \
    # Minimal config — SYSUAF + manager files (STARTUP.EXE reads these at boot)
    cp distro/rootfs/vms/SYS0/SYSCOMMON/SYSEXE/SYSUAF.DAT /initramfs-slim/vms/SYS0/SYSCOMMON/SYSEXE/ && \
    cp -r distro/rootfs/vms/SYS0/SYSCOMMON/SYSMGR/* /initramfs-slim/vms/SYS0/SYSCOMMON/SYSMGR/ && \
    # Pack the (only) boot initramfs. Reproducibility (vms-d73): normalize
    # every file's mtime to SOURCE_DATE_EPOCH (cp resets mtime to build
    # wall-clock, which the cpio "newc" format embeds per entry); sort the
    # cpio member order -- find(1)'s raw readdir order is not a
    # byte-reproducibility guarantee even when the create sequence is
    # identical; drop gzip's embedded mtime (-n); and --reproducible
    # (measured necessary, not theoretical -- vms-d73 CI caught a real diff
    # without it), GNU cpio's own name for --ignore-devno --ignore-dirnlink
    # --renumber-inodes -- without it, cpio's "newc" format embeds the REAL
    # filesystem inode number of every entry, which differs across builds
    # even for byte-identical, identically-timestamped trees.
    #
    # Written to the plain initramfs-ovmx.cpio.gz name (the fat pack used to
    # own this name; now the single initramfs takes it over) plus the
    # initramfs-ovmx-slim.cpio.gz alias, so out-of-scope consumers that still
    # name "slim" explicitly (tests/qemu/test_distrib_boot.sh and friends)
    # keep working -- both names carry byte-identical content, produced by
    # this one pack step, not a second build.
    find /initramfs-slim -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} + && \
    cd /initramfs-slim && find . | sort | cpio -o -H newc --reproducible 2>/dev/null | gzip -n > /boot/initramfs-ovmx.cpio.gz && \
    cp /boot/initramfs-ovmx.cpio.gz /boot/initramfs-ovmx-slim.cpio.gz && \
    echo "Boot initramfs: $(ls -lh /boot/initramfs-ovmx.cpio.gz | awk '{print $5}')"

# -- NOEXEC initramfs (negative control) ---------------------------------------
# The (only) boot initramfs with vms.ko REMOVED -- i.e. a system whose
# executive cannot be loaded. It exists so
# tests/qemu/test_executive_integral.sh can prove that OVMX REFUSES TO BOOT
# without an executive, rather than coming up degraded. Rebuilt from the same
# bootstrap baseline (/initramfs-slim) the real boot initramfs ships (vms-1ab
# -- there is no longer a separate fat baseline to fork from).
#
# This is a test artifact, not a runtime: it is the only way to exercise the
# fatal path, and building it here (where cpio lives) keeps the runner stage
# minimal. Nothing boots it except that test. If you are tempted to ship it or
# to "fix" a boot failure by using it -- don't; a system with no executive is
# precisely the state OVMX exists to make unreachable (CLAUDE.md Rule 9).
RUN cp -a /initramfs-slim /initramfs-noexec && \
    rm -f /initramfs-noexec/lib/modules/vms.ko && \
    find /initramfs-noexec -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} + && \
    cd /initramfs-noexec && find . | sort | cpio -o -H newc --reproducible 2>/dev/null | gzip -n > /boot/initramfs-ovmx-noexec.cpio.gz && \
    echo "NOEXEC initramfs: $(ls -lh /boot/initramfs-ovmx-noexec.cpio.gz | awk '{print $5}')"

# -- NODEV initramfs (negative control) -----------------------------------------
# The (only) boot initramfs with /lib/modules/vms.ko REPLACED by a different,
# real, loadable kernel module (vmsfs.ko's own binary) that registers no misc
# device. finit_module() on it succeeds, but /dev/vms never appears in
# devtmpfs -- the second reachable half of executive_attach()'s fatal path
# (vms.ko itself is untouched; NOEXEC above already covers "module missing"
# entirely). Exists so tests/qemu/test_executive_integral.sh Boot C can prove
# that path is fatal too, and diagnosed honestly, rather than merely asserted
# (vms-a35 round 2 / Rule 10). Rebuilt from the same bootstrap baseline as
# NOEXEC above (vms-1ab).
#
# Test artifact, not a runtime -- same rule as NOEXEC above.
RUN cp -a /initramfs-slim /initramfs-nodev && \
    cp src/kernel/vmsfs/vmsfs.ko /initramfs-nodev/lib/modules/vms.ko && \
    find /initramfs-nodev -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} + && \
    cd /initramfs-nodev && find . | sort | cpio -o -H newc --reproducible 2>/dev/null | gzip -n > /boot/initramfs-ovmx-nodev.cpio.gz && \
    echo "NODEV initramfs: $(ls -lh /boot/initramfs-ovmx-nodev.cpio.gz | awk '{print $5}')"

# The bootable vmlinuz is the from-source OVMX bzImage, already copied to
# /boot/vmlinuz from the kernel-build stage (vms-448) -- no stock-kernel
# symlink to reconstruct anymore. Assert it is present and is a real kernel
# image so the runner stage never COPYs a missing/empty file.
# Every x86 bzImage carries the "HdrS" setup-header magic at offset 0x202.
RUN test -s /boot/vmlinuz && \
    [ "$(dd if=/boot/vmlinuz bs=1 skip=514 count=4 2>/dev/null)" = "HdrS" ] && \
    echo "OVMX vmlinuz present: $(ls -lh /boot/vmlinuz | awk '{print $5}'), kernel $(cat /tmp/kver)"

# -- Runner stage --------------------------------------------------------------
# Minimal image with just QEMU and boot artifacts. `expect` is test tooling,
# not a runtime dependency (CLAUDE.md Rule 9 distinction) -- it drives the
# SYSBOOT> conversational-boot proof (tests/qemu/test_sysboot_conversational.sh,
# vms-b81) over the real serial console, the same way this stage's QEMU boots
# every other test in tests/qemu/.
FROM ubuntu:24.04 AS runner

# Distro metadata (rd vms-700/vms-296/vms-3de, GNU/Linux-style dual
# identity): this container image builds and boots the "OVMX/Linux"
# SYSKRNL layer (Linux kernel + initramfs) -- distinct from the "OpenVMX"
# VMS-compatible PRODUCT identity a booted guest shows at its own login
# banner/SHOW SYSTEM/MONITOR (ovmx_identity.h OVMX_PRODUCT_BANNER). This
# image label is build/test-tooling metadata (Docker as BUILD tooling,
# CLAUDE.md Rule 9), not the OVMX runtime itself.
LABEL org.opencontainers.image.title="OVMX/Linux" \
      org.opencontainers.image.description="OVMX/Linux -- SYSKRNL layer (Linux kernel) that boots the OpenVMX VMS-compatible product" \
      org.opencontainers.image.vendor="OVMX" \
      ovmx.syskrnl.name="OVMX/Linux" \
      ovmx.product.name="OpenVMX"

ENV DEBIAN_FRONTEND=noninteractive

# kmod: provides `modinfo`, which tests/qemu/test_intree_modules.sh (vms-934)
# runs on the shipped vms.ko/vmsfs.ko to prove they are stamped intree=Y. Test
# tooling only (CLAUDE.md Rule 9 distinction), like `expect` above.
RUN apt-get update && apt-get install -y --no-install-recommends \
    qemu-system-x86 qemu-system-arm qemu-efi-aarch64 cpio expect kmod \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /boot/vmlinuz /boot/vmlinuz
COPY --from=builder /boot/initramfs-ovmx.cpio.gz /boot/initramfs-ovmx.cpio.gz
# Byte-identical alias (vms-1ab: the builder stage `cp`s the same pack output
# under both names): out-of-scope consumers that still name the "slim"
# initramfs explicitly (tests/qemu/test_distrib_boot.sh and friends) keep
# working without a second build.
COPY --from=builder /boot/initramfs-ovmx-slim.cpio.gz /boot/initramfs-ovmx-slim.cpio.gz
# Pre-installed distribution system disk (vms-8ab). The boot initramfs boots
# this; a §6-stripped PID 1 mounts it or halts (docs/design-init-scope.md §6).
COPY --from=builder /boot/ovmx-distrib.img /boot/ovmx-distrib.img
# Negative-control distribution disk (vms-2a9): same tree, JOB_CONTROL's
# STDRV component registration removed. Consumed only by
# tests/qemu/test_job_control_negctl.sh -- never booted by anything else.
COPY --from=builder /boot/ovmx-distrib-negctl.img /boot/ovmx-distrib-negctl.img
# Install-media distribution disk (vms-dcf): same tree as ovmx-distrib.img,
# SYSTARTUP_VMS.COM swapped for the variant that runs the install menu.
# Consumed only by tests/qemu/test_install_menu.sh -- ovmx-distrib.img
# itself is untouched and keeps booting straight to login as before.
COPY --from=builder /boot/ovmx-install-media.img /boot/ovmx-install-media.img
# OVMX OS kit (vms-0b6, docs/design-ovmx-kit-format.md). Not consumed by
# anything that boots today -- vms-df9's PRODUCT INSTALL is the consumer --
# carried here so the build's kit artifact is retrievable like the other
# `-o dist` outputs, not buried inside the builder stage.
COPY --from=builder /boot/ovmx-os.kit /boot/ovmx-os.kit
# The kit's own internal file listing (vms-d73, tools/cut-release.sh) --
# carried out alongside the kit itself so a release cut can fold "the kit's
# internal manifest names DCL.EXE/LOGINOUT.EXE/STARTUP.COM" into
# release-manifest.json from the actual shipped kit, without needing
# ovmx_kit_pack on the release host.
COPY --from=builder /boot/ovmx-os.kit.manifest.txt /boot/ovmx-os.kit.manifest.txt
# Negative controls for test_executive_integral.sh only — never a runtime.
COPY --from=builder /boot/initramfs-ovmx-noexec.cpio.gz /boot/initramfs-ovmx-noexec.cpio.gz
COPY --from=builder /boot/initramfs-ovmx-nodev.cpio.gz /boot/initramfs-ovmx-nodev.cpio.gz

ENV MEMORY=512M

# DISTRIB=1             — boot the PRE-INSTALLED distribution disk (vms-8ab): seed
#                         the disk from /boot/ovmx-distrib.img when it does not yet
#                         exist (instead of a blank disk PID 1 would self-install).
#                         This is the §6 mount-or-halt shape: an already-installed
#                         disk, no self-install. There is exactly ONE initramfs
#                         (vms-1ab) -- no INITRD switch to select between variants.
# BOOT_FLAGS            — Conversational boot (vms-b81): "R5,R6" appended to the
#                         kernel cmdline as ovmx.flags=R5,R6. Bit 0 of R6 is the
#                         conversational bit -- BOOT_FLAGS=0,1 halts STARTUP.EXE
#                         at a SYSBOOT> prompt before the executive attaches
#                         (docs/design-boot-faithful.md §2.2/§3.1). Unset boots
#                         straight through.
# SYSDISK_NAME          — disk filename inside /data volume (default: sysdisk.img)
# OVMX_NET_MODE         — virtio-net NIC mode (vms-7bd, parent vms-67f). The
#                         guest gets ONE virtio-net-pci device; the guest kernel
#                         has virtio_net built in (CONFIG_VIRTIO_NET=y) so the
#                         interface enumerates with no in-guest module load.
#                         This is the LINUX-LAYER NIC only -- the VMS device
#                         face (EWAn:) is a separate downstream item.
#                           user  (DEFAULT) : user-mode NAT (SLIRP), zero host
#                                             config, works unprivileged / in
#                                             CI. NO inbound by default.
#                           tap             : PRE-EXISTING host tap OVMX_NET_TAP
#                                             (default tap0), script=no; the
#                                             operator provisions/bridges it.
#                           bridge          : qemu-bridge-helper to EXISTING
#                                             host bridge OVMX_NET_BRIDGE
#                                             (default br0), operator-provisioned.
#                           none            : no NIC (legacy -nic none behavior).
#                         tap/bridge need host privileges and will NOT work in
#                         unprivileged CI; user mode is the safe default. This
#                         launch never creates a tap/bridge as a side effect.
# OVMX_NET_TAP          — tap ifname for OVMX_NET_MODE=tap    (default: tap0)
# OVMX_NET_BRIDGE       — bridge name for OVMX_NET_MODE=bridge (default: br0)
# OVMX_NET_MAC          — guest NIC MAC (default: QEMU-assigned)
# OVMX_NET_HOSTFWD      — user-mode ONLY: extra hostfwd rules for deliberate
#                         inbound (e.g. "tcp::2223-:23"). Empty by default.
#
# boot.sh mounts a host directory at /data so the container owns the disk
# file and can write freely (avoids rootless Docker permission issues).
# When run standalone (no /data mount), falls back to /tmp/sysdisk.img.
CMD ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ] || [ "$ARCH" = "arm64" ]; then \
        QEMU=qemu-system-aarch64; \
        MACHINE="-machine virt -cpu cortex-a57"; \
        CONSOLE="console=ttyAMA0"; \
    else \
        QEMU=qemu-system-x86_64; \
        MACHINE=""; \
        CONSOLE="console=ttyS0"; \
    fi && \
    INITRAMFS=/boot/initramfs-ovmx.cpio.gz && \
    if [ -d /data ]; then \
        DISK="/data/${SYSDISK_NAME:-sysdisk.img}"; \
    else \
        DISK="/tmp/sysdisk.img"; \
    fi && \
    if [ ! -e "$DISK" ]; then \
        if [ -n "${DISTRIB:-}" ]; then \
            cp /boot/ovmx-distrib.img "$DISK"; \
        else \
            truncate -s 64M "$DISK"; \
        fi; \
    fi && \
    APPEND="$CONSOLE loglevel=3 quiet" && \
    if [ -n "${BOOT_FLAGS:-}" ]; then APPEND="$APPEND ovmx.flags=$BOOT_FLAGS"; fi && \
    NET_MODE="${OVMX_NET_MODE:-user}" && \
    DEV_OPTS="netdev=net0,romfile=" && \
    if [ -n "${OVMX_NET_MAC:-}" ]; then DEV_OPTS="$DEV_OPTS,mac=$OVMX_NET_MAC"; fi && \
    case "$NET_MODE" in \
        user) NETDEV="user,id=net0"; \
              if [ -n "${OVMX_NET_HOSTFWD:-}" ]; then NETDEV="$NETDEV,hostfwd=$OVMX_NET_HOSTFWD"; fi; \
              set -- -netdev "$NETDEV" -device "virtio-net-pci,$DEV_OPTS" ;; \
        tap) set -- -netdev "tap,id=net0,ifname=${OVMX_NET_TAP:-tap0},script=no,downscript=no" \
                    -device "virtio-net-pci,$DEV_OPTS" ;; \
        bridge) set -- -netdev "bridge,id=net0,br=${OVMX_NET_BRIDGE:-br0}" \
                       -device "virtio-net-pci,$DEV_OPTS" ;; \
        none) set -- -nic none ;; \
        *) echo "Error: unknown OVMX_NET_MODE='$NET_MODE' (want: user|tap|bridge|none)" >&2; exit 1 ;; \
    esac && \
    exec $QEMU $MACHINE \
        -kernel /boot/vmlinuz \
        -initrd "$INITRAMFS" \
        -nographic \
        -append "$APPEND" \
        -m $MEMORY \
        -smp 2 \
        "$@" \
        -nodefaults \
        -serial mon:stdio \
        -drive file="$DISK",format=raw,if=virtio \
        -no-reboot
