        .TITLE  LUNTST
        .PSECT  DATA,WRT,NOEXE,LONG
LUN:    .LONG   0
STS:    .LONG   0
ARG:    .LONG   0
FAO:    .ASCID  /!SL !XL/
BUF:    .BLKB   80
BUFD:   .LONG   80
        .ADDRESS BUF
OUTL:   .WORD   0
        .PSECT  CODE,NOWRT,EXE
        .ENTRY  SHOW,^M<>
        $FAO_S  CTRSTR=FAO,OUTLEN=OUTL,OUTBUF=BUFD,P1=LUN,P2=STS
        MOVW    OUTL,BUFD
        PUSHAQ  BUFD
        CALLS   #1,G^LIB$PUT_OUTPUT
        MOVW    #80,BUFD
        RET
        .ENTRY  START,^M<R2>
        MOVL    #305,R2
LOOP:   PUSHAL  LUN
        CALLS   #1,G^LIB$GET_LUN
        MOVL    R0,STS
        CALLS   #0,SHOW
        BLBC    STS,FREE
        SOBGTR  R2,LOOP
FREE:   MOVL    #100,LUN
        PUSHAL  LUN
        CALLS   #1,G^LIB$FREE_LUN
        MOVL    R0,STS
        CALLS   #0,SHOW
        PUSHAL  LUN
        CALLS   #1,G^LIB$FREE_LUN
        MOVL    R0,STS
        CALLS   #0,SHOW
        MOVL    #5,LUN
        PUSHAL  LUN
        CALLS   #1,G^LIB$FREE_LUN
        MOVL    R0,STS
        CALLS   #0,SHOW
        MOVL    #150,LUN
        PUSHAL  LUN
        CALLS   #1,G^LIB$FREE_LUN
        MOVL    R0,STS
        CALLS   #0,SHOW
        PUSHAL  LUN
        CALLS   #1,G^LIB$GET_LUN
        MOVL    R0,STS
        CALLS   #0,SHOW
        MOVL    #1,R0
        RET
        .END    START
