# libvmssys_shr.vec — CANONICAL, FROZEN symbol-vector manifest for LIBVMSSYS$SHR.EXE
# (the src/libvmssys freestanding /dev/vms client). SINGLE SOURCE OF TRUTH.
# bead vms-bd1 (operator-approved freeze 2026-08-13), pillar vms-ade.
#
# WHAT THIS IS. One ordered list of the universals LIBVMSSYS$SHR exports in its
# `.vms$sv` symbol vector. Every build recipe and every native-link test harness
# derives its --symbol-vector from THIS file (via symvec_emit.sh) instead of
# hand-keeping its own copy. Before this file existed the same vector was carried
# in SEVEN hand-maintained places (mk_vmssys_shr.sh + six run_*_native.sh
# harnesses) and had already DRIFTED into two different orders — exactly the
# cross-build GSMATCH hazard this manifest removes.
#
# THE INVARIANT — APPEND-ONLY (this is what makes GSMATCH LEQUAL safe).
# The position of an entry in this file IS its symbol-vector index, and a
# consumer image binds an imported universal by that index. Therefore:
#   * NEVER reorder, and NEVER delete, an existing line. Either shifts every
#     index below it and breaks every already-linked consumer.
#   * A NEW universal is added by APPENDING a line at the END of the file.
#   * A universal that goes away is RETIRED IN PLACE, not removed: change its
#     class to PRIVATE_PROCEDURE (or PRIVATE_DATA) and leave the line where it
#     is, so no later index moves. (Same rule the LIBVMSPROCESS$SHR event-flag
#     slots follow — mk_vmsprocess_shr.sh.)
# This is the OpenVMS upward-compatibility contract for a GSMATCH LEQUAL
# shareable image: see docs/design-link-native-toolchain.md §5 (derived from the
# public VSI OpenVMS Linker Utility Manual — clean-room, CLAUDE.md Rule 8).
#
# ENFORCEMENT. tests/integration/test_symvec_freeze.sh proves, on every ctest
# run, that (a) the frozen prefix in libvmssys_shr.vec.frozen is still an exact
# ordered prefix of this file (no reorder / no drop), (b) no name repeats, and
# (c) no harness or recipe has re-grown an inline copy of the vector. Reorder or
# drop -> RED; append -> GREEN.
#
# FORMAT: one `NAME=CLASS` per line. `#` comments and blank lines are ignored.
vms_strlen=PROCEDURE
vms_kif_open=PROCEDURE
vms_kif_enq=PROCEDURE
vms_kif_deq=PROCEDURE
vms_kif_convert=PROCEDURE
vms_kif_assign=PROCEDURE
vms_kif_dassgn=PROCEDURE
vms_kif_getdvi_chan=PROCEDURE
vms_kif_setprn=PROCEDURE
vms_kif_setprv=PROCEDURE
vms_kif_getjpi_self=PROCEDURE
vms_kif_getjpi_pid=PROCEDURE
vms_kif_getjpi_prcnam=PROCEDURE
vms_kif_procscan=PROCEDURE
vms_kif_setef=PROCEDURE
vms_kif_clref=PROCEDURE
vms_kif_readef=PROCEDURE
vms_kif_waitfr=PROCEDURE
vms_kif_wflor=PROCEDURE
vms_kif_wfland=PROCEDURE
vms_kif_ascefc=PROCEDURE
vms_kif_dacefc=PROCEDURE
vms_kif_dlcefc=PROCEDURE
vms_kif_devscan=PROCEDURE
vms_kif_getdvi_devnam=PROCEDURE
vms_kif_setident=PROCEDURE
vms_kif_dclast=PROCEDURE
vms_kif_setast=PROCEDURE
vms_kif_deliverast=PROCEDURE
vms_kif_lnm_define=PROCEDURE
vms_kif_lnm_delete=PROCEDURE
vms_kif_lnm_translate=PROCEDURE
vms_kif_register_continue=PROCEDURE
vms_kif_mbx_create=PROCEDURE
vms_kif_mbx_assign=PROCEDURE
vms_kif_mbx_delmbx=PROCEDURE
vms_kif_mbx_write=PROCEDURE
vms_kif_mbx_read=PROCEDURE
vms_kif_p0_map=PROCEDURE
vms_kif_p0_unmap=PROCEDURE
vms_kif_p1_map=PROCEDURE
vms_kif_enter_image=PROCEDURE
vms_kif_image_rundown=PROCEDURE
vms_kif_p1_protect=PROCEDURE
vms_kif_lnm_enumerate=PROCEDURE
vms_kif_disk_resolve=PROCEDURE
vms_kif_chkpriv=PROCEDURE
vms_kif_alloc=PROCEDURE
vms_kif_dalloc=PROCEDURE
vms_kif_establish_system=PROCEDURE
# vms-9003: mailbox write-attention AST (IO$_SETMODE|IO$M_WRTATTN). APPENDED at
# the end per the append-only contract above -- a new universal never shifts an
# existing index.
vms_kif_mbx_set_wrtattn=PROCEDURE
# vms-feb: $HIBER/$WAKE, executive-resident + AST-interruptible. APPENDED at the
# end per the append-only contract -- a new universal never shifts an existing
# index.
vms_kif_hiber=PROCEDURE
vms_kif_wake=PROCEDURE
# vms-527: INET pseudo-device BGn: driver wrappers (VMS_IOCTL_BG_*, the $QIO
# network path). APPENDED at the end per the append-only contract above -- a new
# universal never shifts an existing index. The socket is executive-resident
# (src/kernel/vms_bg.c); these are the userspace marshalling shims.
vms_kif_bg_create=PROCEDURE
vms_kif_bg_setmode=PROCEDURE
vms_kif_bg_connect=PROCEDURE
vms_kif_bg_send=PROCEDURE
vms_kif_bg_recv=PROCEDURE
vms_kif_bg_deaccess=PROCEDURE
vms_kif_bg_dassgn=PROCEDURE
vms_kif_bg_pollfd=PROCEDURE
# vms-0cd RUNG-3b: materialize a BGn: channel as a real data-carrying fd (dup2-able,
# survives execve) so a wrapped daemon can hand a connection to its exec'd child.
vms_kif_bg_materialize_fd=PROCEDURE
# vms-4bf: OpenSSH de-veneer Tier A -- getsockname/getpeername (IO$_SENSEMODE)
# and get/setsockopt (IO$_SETMODE/SENSEMODE) over BGn:, so unmodified OpenSSH's
# getpeername()/setsockopt() dispatch to $QIO on the executive-resident socket.
# APPENDED at the end per the append-only contract -- a new universal never
# shifts an existing index.
vms_kif_bg_getname=PROCEDURE
vms_kif_bg_setsockopt=PROCEDURE
vms_kif_bg_getsockopt=PROCEDURE
# --- Files-11 (ODS-2) ACP channel + mount front-end (vms-149, epic vms-208).
# $MOUNT/$DISMOUNT of an ODS-2 volume into the executive-global mounted table
# and $ASSIGN of a file-class channel bound to a mounted volume. APPENDED at the
# end per the append-only contract -- a new universal never shifts an existing
# index. vms_kif_acp_mount/dmount are OVMX-UNWIRED (test-only) today; exported
# so the vector is stable when the boot-time $MOUNT rung wires them.
vms_kif_acp_mount=PROCEDURE
vms_kif_acp_dmount=PROCEDURE
vms_kif_acp_assign=PROCEDURE
# --- Files-11 (ODS-2) ACP IO$_ACCESS / IO$_DEACCESS (vms-204, epic vms-208).
# Open a file by name or by FID on a file-class channel, building its VBN->LBN
# window; release it. APPENDED at the end per the append-only contract -- a new
# universal never shifts an existing index. OVMX-UNWIRED (test-only) today;
# exported so the vector is stable when the RMS-over-$QIO rung wires them.
vms_kif_acp_access=PROCEDURE
vms_kif_acp_deaccess=PROCEDURE
# --- Files-11 (ODS-2) ACP IO$_READVBLK / IO$_WRITEVBLK (vms-c60, epic vms-208).
# Virtual-block transfer on an accessed file channel through its window; a write
# past EOF implicitly extends (BITMAP.SYS allocation + FH2 grow). APPENDED at the
# end per the append-only contract -- a new universal never shifts an existing
# index. OVMX-UNWIRED (test-only) today; exported so the vector is stable when
# the RMS-over-$QIO $GET/$PUT rung wires them.
vms_kif_acp_readvb=PROCEDURE
vms_kif_acp_writevb=PROCEDURE
# --- Files-11 (ODS-2) ACP IO$_ACPCONTROL wildcard directory search (vms-a0b,
# epic vms-208). The $SEARCH primitive: successive one-per-call matches against
# a wildcard directory context (FIB$L_WCC), terminating SS$_NOMOREFILES.
# APPENDED at the end per the append-only contract -- a new universal never
# shifts an existing index. OVMX-UNWIRED (test-only) today; exported so the
# vector is stable when the RMS $SEARCH / DCL F$SEARCH rung wires it.
vms_kif_acp_acpcontrol=PROCEDURE
# --- Files-11 (ODS-2) ACP IO$_CREATE / IO$_DELETE / IO$_MODIFY (vms-5303, epic
# vms-208). The ACP file-operation umbrella: create a file header (real FID from
# INDEXF.SYS + versioned directory entry + optional access), delete a file
# (remove entry + deallocate header/blocks), modify (extend/truncate/write
# attributes). func-dispatched. APPENDED at the end per the append-only contract
# -- a new universal never shifts an existing index. OVMX-UNWIRED (test-only)
# today; exported so the vector is stable when RMS $CREATE/$ERASE/$EXTEND wire it.
vms_kif_acp_fileop=PROCEDURE
# --- $EXIT / $STATUS + CLI invocation context (vms-f60d). The userspace face of
# the executive process-table facility VMS_IOCTL_SETEXIT..GETCLI: the exiting
# image records its completion $STATUS (vms_kif_setexit) and the invoking CLI
# reads it (vms_kif_getexit); the CLI records its command line (vms_kif_setcli)
# and the activated image reads it (vms_kif_getcli). APPENDED at the end per the
# append-only contract -- a new universal never shifts an existing index.
vms_kif_setexit=PROCEDURE
vms_kif_getexit=PROCEDURE
vms_kif_setcli=PROCEDURE
vms_kif_getcli=PROCEDURE
# --- $GETDVI VOLUME items of a disk unit (vms-e6f): mount state, ODS-2 volume
# label, size, cluster factor and free-block count of a mounted volume, read
# from the executive-global mounted-volume table. SHOW DEVICE (DCL) reads this to
# report a disk as Mounted with its label + free/total blocks. APPENDED at the
# end per the append-only contract -- a new universal never shifts an existing index.
vms_kif_getvol=PROCEDURE
# BGn: SERVER path (vms-698, OpenSSH server port). bind/listen/accept over the
# exec_socket_* seam. APPENDED per the append-only contract.
vms_kif_bg_bind=PROCEDURE
vms_kif_bg_listen=PROCEDURE
vms_kif_bg_accept=PROCEDURE
# DLM cross-node message TRANSPORT (vms-94c, cluster-wide $ENQ/$DEQ rung 1). The
# executive cross-node RECEIVE seam reached over /dev/vms. APPENDED per the
# append-only contract -- a new universal never shifts an existing index.
vms_kif_dlm_xnode=PROCEDURE
