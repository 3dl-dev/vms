+;; [OVMX] vms-095 (component C3 of vms-5f5; docs/design-alpha-per-image-gp.md
+;; 2.1): establish this image's per-image module-GP in the TARGET_ABI_OPEN_VMS
+;; prologue.  Emits `.ovmx_gpdisp $15, <proc>' (added to the alpha-dec-vms gas by
+;; binutils port patch 0006-vms-4ed), which itself emits
+;;      ldah $15,0($27)   ; $15 = high part of (&PDSC - K)
+;;      lda  $15,0($15)   ; $15 = &PDSC - K = module_GP
+;; and marks the pair EVAX_R_OVMX_GPDISP so the OVMX linker patches the signed
+;; -K (K = this procedure's PDSC offset within its module linkage section).  On
+;; entry R27 = &PDSC (VMS Calling Standard 3.1.1/3.3).  $15 is the reserved,
+;; fixed, call-saved OVMX module-GP register (vms.h); on this port $29 is the
+;; hard frame pointer, so $15 -- not $29 -- carries the GP (OVMX divergence,
+;; Rule 8).  The caller's $15 is saved/restored around this (sa_mask), so it
+;; survives calls with no per-call reload.  Single-procedure module: K = 0, the
+;; pair is a no-op-equivalent.  The directive text is produced by
+;; alpha_output_ovmx_gpdisp (operand = the procedure's PDSC symbol, alpha_fnname).
+(define_insn "prologue_ovmx_gpdisp"
+  [(set (reg:DI 15)
+	(unspec_volatile:DI [(reg:DI 27)] UNSPECV_OVMX_GPDISP))]
+  "TARGET_ABI_OPEN_VMS"
+  "* return alpha_output_ovmx_gpdisp ();"
+  [(set_attr "cannot_copy" "true")])
