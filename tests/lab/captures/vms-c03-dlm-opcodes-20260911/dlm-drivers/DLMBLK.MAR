 .TITLE DLMBLK
 $LCKDEF
 $SSDEF
 .PSECT DAT,WRT,NOEXE,LONG
LKSB: .BLKB 8
FLAG: .LONG 0
CMDBUF: .BLKB 100
CMDDSC: .WORD 100
 .BYTE 14
 .BYTE 1
 .ADDRESS CMDBUF
CMDLEN: .WORD 0
 .WORD 0
MODE: .LONG 0
RESDSC: .WORD 0
 .BYTE 14
 .BYTE 1
 .ADDRESS 0
 .PSECT COD,EXE,NOWRT
 .ENTRY BLKRTN,^M<>
 MOVL #1,FLAG
 RET
 .ENTRY DLMBLK,^M<R2,R3,R4,R5,R6>
 PUSHAW CMDLEN
 PUSHL #0
 PUSHAB CMDDSC
 CALLS #3,G^LIB$GET_FOREIGN
 MOVZBL CMDBUF,R0
 SUBL2 #^A/0/,R0
 MOVL R0,MODE
 MOVZWL CMDLEN,R1
 SUBL2 #1,R1
 MOVW R1,RESDSC
 MOVAB CMDBUF+1,RESDSC+4
 $ENQW_S EFN=#1,LKMODE=MODE,LKSB=LKSB,FLAGS=#LCK$M_SYSTEM,RESNAM=RESDSC,BLKAST=BLKRTN
 $HIBER_S
 RET
 .END DLMBLK
