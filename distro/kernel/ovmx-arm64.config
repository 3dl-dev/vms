# OVMX bootable kernel config fragment for arm64 (rd vms-a07, epic vms-0ad0:
# aarch64 ships in V1.0). The arm64 twin of ovmx-x86_64.config: the SAME OVMX
# option set, merged on top of `make ARCH=arm64 defconfig` via
# scripts/kconfig/merge_config.sh, then `olddefconfig`, inside
# distro/Dockerfile.bootable's kernel-build stage (TARGETARCH=arm64).
#
# Only the console and PCI host differ: qemu-system-aarch64 -machine virt has a
# PL011 UART (console=ttyAMA0) and an ECAM generic PCI host bridge, where the
# x86 PC has an 8250 and a native PCI host. Everything else is shared, so keep
# the two fragments in step (test_kernel_config_fragments_agree, if you add one).

# --- Serial console -------------------------------------------------------
# -machine virt's UART is a PL011 (ttyAMA0); it is the only console under
# QEMU -nographic, as the 8250 is on x86.
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_PRINTK=y

# --- PCI host for -machine virt -------------------------------------------
# virtio-pci devices on `virt` sit behind the generic ECAM host bridge.
CONFIG_PCI_HOST_GENERIC=y

# --- virtio transport + the two devices run-qemu.sh attaches --------------
# System disk is `-drive if=virtio` => /dev/vda (virtio-blk); the NIC is
# `virtio-net-pci` (vms-7bd). The initramfs loads NO stock kernel modules,
# so both drivers MUST be built in (=y, never =m).
CONFIG_PCI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y

# --- virtio-scsi (non-virtio-blk disks: bare-metal SATA/SCSI, vms-ddc / --
# vms-47d) -------------------------------------------------------------
# OVMX targets bare metal, where the system disk is SATA/SCSI/NVMe, not
# virtio-blk. A prior attempt (reverted) tried NVMe here, but this minimal
# from-source config lacks the MSI-X plumbing NVMe needs to bring up
# /dev/nvme0n1 in the guest. virtio-scsi instead reuses the already-enabled
# virtio transport above and presents disks as /dev/sd*, exercising the
# SAME non-virtio probe path (vms_devtab_probe_disks()'s SATA/SCSI loop)
# reliably in a minimal kernel. Built-in (=y, never =m -- the initramfs
# loads no modules). test_kmod_disk.c attaches one real virtio-scsi disk
# and proves the executive enters SDA0: for it.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_LOWLEVEL=y
CONFIG_SCSI_VIRTIO=y

# --- Block layer (the virtio-blk system disk) -----------------------------
CONFIG_BLOCK=y

# --- Pseudo-filesystems ovmx_init mounts at boot --------------------------
# src/ovmx_init/ovmx_init.c mounts proc, sysfs, devtmpfs and tmpfs directly.
# DEVTMPFS is also what makes /dev/vms (vms.ko's misc device) appear -- the
# executive-attach path the whole runtime depends on (Rule 9).
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y

# --- initramfs (the cpio.gz boot image) -----------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# --- ELF binaries + multiuser ---------------------------------------------
# /init is STARTUP.EXE, a static ELF; vms_mount_helper is setuid-root.
CONFIG_BINFMT_ELF=y
CONFIG_MULTIUSER=y

# --- Loadable modules: vms.ko via finit_module() --------------------------
# OVMX modules are SIGNED (vms-ff5, parent vms-19e "owns-kernel"). Turning on
# module signing embeds the signing certificate into this kernel's built-in
# trusted keyring, so at load finit_module() verifies each module signature
# against that key and does NOT set TAINT_UNSIGNED_MODULE (bit 13 / 'E'). The
# signing key is supplied to the build at distro/kernel/ovmx-module-signing-
# key.pem -- as the `ovmx_module_signing_key` build secret, else auto-generated
# ephemerally by certs/Makefile. It is NEVER committed (a committed private key
# is public); see the Byte-reproducibility note below for how reproducibility is
# preserved without committing it.
# SIG_ALL auto-signs at modules_install; vms.ko is additionally
# signed explicitly in the kernel-build stage (it is harvested straight from
# the build tree, not via modules_install).
#
# Enforcement (SIG_FORCE) is DELIBERATELY NOT SET (vms-ff5 decision): signing
# is proven first WITHOUT enforcement so a signing-pipeline slip can never
# brick the boot (finit_module would reject an unverifiable module). Forcing is
# a deferred follow-up. The Dockerfile hard-gates that SIG_FORCE stays off.
#
# NB: keep prose references to config symbols mid-line -- a comment line that
# BEGINS with "# CONFIG_..." is misparsed by merge_config.sh as a directive.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA256=y
CONFIG_MODULE_SIG_KEY="ovmx-module-signing-key.pem"
# CONFIG_MODULE_SIG_FORCE is not set

# --- ext4 (general-purpose fs; disk-image interop) ------------------------
CONFIG_EXT4_FS=y

# --- OVMX VMS modules, built IN-TREE (vms-934, parent vms-19e owns-kernel) -
# vms.ko (the /dev/vms executive, which carries the Files-11 ODS-2 ACP) lives
# under drivers/ovmx/ in this kernel tree -- distro/kernel/overlay-ovmx-
# drivers.sh copies its canonical source (src/kernel/ + src/kernel-core/)
# there with in-tree Kbuild+Kconfig BEFORE this fragment is merged. Building
# it =m in-tree makes modpost stamp modinfo intree=Y, so finit_module() at
# boot does NOT set TAINT_OUT_OF_TREE (the "loading out-of-tree module taints
# kernel" log is gone). CONFIG_OVMX gates the drivers/ovmx/ menu; each module
# is an independent tristate.
#
# drivers/ovmx/ is a REUSABLE module home (vms-bae): each per-module symbol
# CONFIG_OVMX_<MOD> is declared by its own drivers-ovmx/<mod>/Kconfig, and the
# overlay generates the menu wrapper + Makefile from the discovered subdirs.
# Adding an OVMX module (e.g. the DECnet kernel half, vms-30e) = a new subdir +
# Kconfig stanza + one CONFIG_OVMX_<MOD>=m line HERE -- it then inherits in-tree
# (intree=Y) + auto-signing for free. See docs/adding-an-ovmx-kernel-module.md.
CONFIG_OVMX=y
CONFIG_OVMX_VMS=m

# --- OVMX kernel identity -------------------------------------------------
# Makes `uname -r` / module vermagic read <ver>-ovmx, so the from-source
# kernel is unmistakable from a stock distro one.
CONFIG_LOCALVERSION="-ovmx"
# CONFIG_LOCALVERSION_AUTO is not set

# --- Byte-reproducibility (vms-d73) ---------------------------------------
# No per-build seed may enter the image: struct-layout randomization must be
# OFF (else a random seed differs every build). Module signing is ON (above)
# but reproducible AS LONG AS the same signing key is fed to both cuts. The key
# is provided via the `ovmx_module_signing_key` build secret (CONFIG_MODULE_SIG_
# KEY path), NEVER committed -- a committed private key is public and lets anyone
# forge a signature this keyring trusts (vms-secret-signing-key). Two cuts sharing
# one secret key produce identical keyring certs and identical (PKCS#1 v1.5,
# deterministic) module signatures, so cut-release-reproducible stays green; the
# gate mints ONE ephemeral key and passes it to both cuts (tools/cut-release.sh
# OVMX_MODULE_SIGNING_KEY). With no key supplied, certs/Makefile generates an
# ephemeral one per build and only the signature bytes vary. The build
# timestamp/user/host are pinned in the Dockerfile via
# KBUILD_BUILD_TIMESTAMP/USER/HOST, not here.
CONFIG_RANDSTRUCT_NONE=y
# CONFIG_GCC_PLUGIN_RANDSTRUCT is not set

# --- Headless: no display, sound or media stack ---------------------------
# OVMX boots to a serial console (ttyAMA0); nothing uses DRM, sound or V4L.
# arm64 defconfig enables them for every SoC, and some (drm/msm) generate
# headers with python3, which the kernel-build stage does not carry.
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
