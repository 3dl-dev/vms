        .TITLE  TATR
; vms-38b: what IO$_ACCESS returns for an attribute list (ATR$C_ASCNAME,
; ATR$C_CREDATE, ATR$C_RECATTR) and for the P3/P4 resultant name, on
; SYS$SCRATCH:ATRT.TXT (create it first: two versions written by DCL).
        .LIBRARY "SYS$LIBRARY:STARLET.MLB"
        $DSCDEF
        $FABDEF
        $NAMDEF
        $FIBDEF
        $ATRDEF
        $IODEF
        .PSECT  DATA,NOEXE,WRT,QUAD
FAB:    $FAB    FNM=<SYS$SCRATCH:ATRT.TXT>, NAM=NAM
NAM:    $NAM    ESA=ESABUF, ESS=255, RSA=RSABUF, RSS=255
ESABUF: .BLKB   256
RSABUF: .BLKB   256
CHAN:   .BLKW   1
IOSB:   .BLKQ   1
FIB:    .BLKB   FIB$K_LENGTH
FIBDSC: .LONG   FIB$K_LENGTH
        .ADDRESS FIB
DEVDSC: .WORD   0
        .BYTE   DSC$K_DTYPE_T, DSC$K_CLASS_S
        .LONG   0
NAMDSC: .WORD   0
        .BYTE   DSC$K_DTYPE_T, DSC$K_CLASS_S
        .LONG   0
RESLEN: .WORD   0
RESBUF: .BLKB   256
RESDSC: .WORD   256
        .BYTE   DSC$K_DTYPE_T, DSC$K_CLASS_S
        .ADDRESS RESBUF
ASCN:   .BLKB   ATR$S_ASCNAME
CRED:   .BLKQ   1
RECA:   .BLKB   ATR$S_RECATTR
ATRL:   .WORD   ATR$S_ASCNAME, ATR$C_ASCNAME
        .ADDRESS ASCN
        .WORD   ATR$S_CREDATE, ATR$C_CREDATE
        .ADDRESS CRED
        .WORD   ATR$S_RECATTR, ATR$C_RECATTR
        .ADDRESS RECA
        .LONG   0
        .LONG   0
F1:     .ASCID  "TATR: QIOW=!XL IOSB=!XW RESLEN=!UW RES=[!AD]"
F2:     .ASCID  "TATR: ASCNAME40=[!AF]"
F3:     .ASCID  "TATR: CREDATE=!XL!XL"
F5:     .ASCID  "TATR: NAME=[!AD]"
OUTBUF: .BLKB   200
OUTLEN: .BLKL   1
OUTDSC: .WORD   200
        .BYTE   DSC$K_DTYPE_T, DSC$K_CLASS_S
        .ADDRESS OUTBUF
        .PSECT  CODE,EXE,NOWRT
        .ENTRY  START, ^M<R2,R3,R4,R6>
        $PARSE  FAB=FAB
        $SEARCH FAB=FAB
        MOVZBL  NAM+NAM$B_DEV, R0
        MOVW    R0, DEVDSC
        MOVL    NAM+NAM$L_DEV, DEVDSC+4
        $ASSIGN_S DEVNAM=DEVDSC, CHAN=CHAN
        MOVW    NAM+NAM$W_DID, FIB+FIB$W_DID
        MOVW    NAM+NAM$W_DID+2, FIB+FIB$W_DID+2
        MOVW    NAM+NAM$W_DID+4, FIB+FIB$W_DID+4
        MOVZBL  NAM+NAM$B_NAME, R1
        MOVZBL  NAM+NAM$B_TYPE, R2
        ADDL2   R2, R1
        MOVZBL  NAM+NAM$B_VER, R2
        ADDL2   R2, R1
        MOVW    R1, NAMDSC
        MOVL    NAM+NAM$L_NAME, NAMDSC+4
        MOVZWL  NAMDSC, R3
        MOVL    NAMDSC+4, R4
        MOVW    #200, OUTDSC
        $FAO_S  CTRSTR=F5, OUTLEN=OUTLEN, OUTBUF=OUTDSC, P1=R3, P2=R4
        MOVW    OUTLEN, OUTDSC
        PUSHAL  OUTDSC
        CALLS   #1, G^LIB$PUT_OUTPUT
        $QIOW_S CHAN=CHAN, FUNC=#<IO$_ACCESS!IO$M_ACCESS>, IOSB=IOSB, -
                P1=FIBDSC, P2=#NAMDSC, P3=#RESLEN, P4=#RESDSC, P5=#ATRL
        MOVL    R0, R6
        MOVZWL  IOSB, R2
        MOVZWL  RESLEN, R3
        MOVW    #200, OUTDSC
        $FAO_S  CTRSTR=F1, OUTLEN=OUTLEN, OUTBUF=OUTDSC, P1=R6, P2=R2, P3=R3, P4=R3, P5=#RESBUF
        MOVW    OUTLEN, OUTDSC
        PUSHAL  OUTDSC
        CALLS   #1, G^LIB$PUT_OUTPUT
        MOVW    #200, OUTDSC
        $FAO_S  CTRSTR=F2, OUTLEN=OUTLEN, OUTBUF=OUTDSC, P1=#40, P2=#ASCN
        MOVW    OUTLEN, OUTDSC
        PUSHAL  OUTDSC
        CALLS   #1, G^LIB$PUT_OUTPUT
        MOVW    #200, OUTDSC
        $FAO_S  CTRSTR=F3, OUTLEN=OUTLEN, OUTBUF=OUTDSC, P1=CRED+4, P2=CRED
        MOVW    OUTLEN, OUTDSC
        PUSHAL  OUTDSC
        CALLS   #1, G^LIB$PUT_OUTPUT
        $QIOW_S CHAN=CHAN, FUNC=#IO$_DEACCESS, IOSB=IOSB, P1=FIBDSC
        MOVL    #1, R0
        RET
        .END    START
