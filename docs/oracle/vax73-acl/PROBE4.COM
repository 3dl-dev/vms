$ SET DEFAULT SYS$SYSDEVICE:[ACLT]
$ CALL RD P1.DAT
$ CALL RD P2.DAT
$ CALL RD P3.DAT
$ CALL RD P4.DAT
$ EXIT
$RD: SUBROUTINE
$ OPEN/READ/ERROR=BAD X 'P1'
$ CLOSE X
$ WRITE SYS$OUTPUT "PRVPROBE ''F$GETJPI("","USERNAME")' ''P1' READ granted"
$ EXIT
$BAD:
$ WRITE SYS$OUTPUT "PRVPROBE ''F$GETJPI("","USERNAME")' ''P1' READ status=", $STATUS
$ EXIT
$ ENDSUBROUTINE
