0x570     SYS$WFLAND       sys$wfland
0x580     SYS$WFLOR        sys$wflor
0x5C0     SYS$GETMSG       SYS$GETMSG
0x610     SYS$GETJPI       SYS$GETJPI
0x660     SYS$SETPRV       sys$setprv
0x6D0     SYS$GET          SYS$GET
0x6E0     SYS$PUT          SYS$PUT
0x740     SYS$CLOSE        SYS$CLOSE
