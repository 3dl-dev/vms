	cd /home/baron/projects/vms/.claude/worktrees/authenticity-inv1/build-local && $(MAKE) $(MAKESILENT) -f src/vmsscs/CMakeFiles/scsd_exe.dir/build.make src/vmsscs/CMakeFiles/scsd_exe.dir/scsd.c.s
.PHONY : scsd.c.s

