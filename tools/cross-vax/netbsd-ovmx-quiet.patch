 void (*v_putc)(int) = cnputc;	/* start with cnputc (normal cons) */
+
+#ifdef OVMX_QUIET
+/*
+ * OVMX_QUIET (OpenVMX, rd vms-553): the console of an OpenVMX/VAX system
+ * belongs to the VMS personality, so this kernel does not print its own
+ * boot and run-time chatter there.  Every kernel message still goes to the
+ * message buffer (dmesg) exactly as before -- nothing is dropped, it is only
+ * not echoed to the console.  The console still receives:
+ *   - everything once panicstr is set (panics, and what follows them);
+ *   - lines printed with TOCONSOP (the OpenVMX executive's operator lines);
+ *   - everything, when booted verbose or debug (AB_VERBOSE / AB_DEBUG), or
+ *     when the kernel has to ask the operator something (RB_ASKNAME,
+ *     RB_USERCONF, or setroot_ask() clearing ovmx_quiet_console).
+ * ddb writes the console through cnputc() directly and is never gated.
+ */
+int ovmx_quiet_console = 1;
+
+static inline bool
+ovmx_console_is_quiet(int flags)
+{
+	if (!ovmx_quiet_console || panicstr != NULL || (flags & TOCONSOP))
+		return false;
+	return (boothowto & (AB_VERBOSE|AB_DEBUG|RB_ASKNAME|RB_USERCONF)) == 0;
+}
+#endif /* OVMX_QUIET */
 void (*v_flush)(void) = cnflush;	/* start with cnflush (normal cons) */
 
