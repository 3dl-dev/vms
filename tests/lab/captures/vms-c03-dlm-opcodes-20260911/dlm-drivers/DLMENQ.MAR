 .TITLE DLMENQ
 $LCKDEF
 $SSDEF
 .PSECT DAT,WRT,NOEXE,LONG
LKSB: .BLKB 8
CMDBUF: .BLKB 100
CMDDSC: .WORD 100
 .BYTE 14
 .BYTE 1
 .ADDRESS CMDBUF
CMDLEN: .WORD 0
 .WORD 0
MODE: .LONG 0
FLAGS: .LONG 0
RESDSC: .WORD 0
 .BYTE 14
 .BYTE 1
 .ADDRESS 0
 .PSECT COD,EXE,NOWRT
 .ENTRY DLMENQ,^M<R2,R3,R4,R5,R6>
 PUSHAW CMDLEN
 PUSHL #0
 PUSHAB CMDDSC
 CALLS #3,G^LIB$GET_FOREIGN
 MOVZBL CMDBUF,R0
 SUBL2 #^A/0/,R0
 MOVL R0,MODE
 MOVL #LCK$M_SYSTEM,R2
 CMPB CMDBUF+1,#^A/1/
 BNEQ 10$
 BISL2 #LCK$M_NOQUEUE,R2
10$: MOVL R2,FLAGS
 MOVZWL CMDLEN,R1
 SUBL2 #2,R1
 MOVW R1,RESDSC
 MOVAB CMDBUF+2,RESDSC+4
 $ENQW_S EFN=#1,LKMODE=MODE,LKSB=LKSB,FLAGS=FLAGS,RESNAM=RESDSC
 MOVL R0,R6
 CMPB CMDBUF+1,#^A/2/
 BEQL 20$
 $DEQ_S LKID=LKSB+4
 BRB 30$
20$: $HIBER_S
30$: RET
 .END DLMENQ
