# creprc-handshake-eintr -- one facility negative control (tests/qemu/facility_defects.sh).
# defect_meta: its metadata, by field ($_f). defect_apply: the mutation of $_file.

defect_meta() {
        case "$_f" in
        facility)     echo "process creation handshake in the PRODUCT (\$CREPRC's creation record, VMS_IOCTL_CREPRC_SYNC through src/libvmssys/vms_kif.c, rd vms-416d)";;
        targets)      echo "libvmssys/vms_kif.c";;
        suites_red)   echo "test_syssvc_procnam";;
        blind_suites) echo "";;
        blind_why)    echo "";;
        isolation)    echo "isolated";;
        why)          cat <<'EOF'
$CREPRC's handshake wait is no longer re-entered on a signal: the creation
record's waits (VMS_IOCTL_CREPRC_SYNC, rd vms-416d -- formerly a read on a
pipe) go through kif_call instead of kif_wait_call, so a signal delivered to
the CALLER through a handler without SA_RESTART ends the creator's ACCEPT wait
with EINTR, and the service misreads the child as never having arrived: it
closes the record, the held child is released with SS$_ABORT and exits, and
$CREPRC answers OVMX$_PRCLOST about a process it did fork. This is the
vms-8019 round-4 defect exactly, and it is not a theoretical one: DCL installs
its interactive SIGINT/SIGQUIT handlers with sa_flags = 0
(src/vmsdcl/dcl_main.c) and DCL is what calls $CREPRC, so a Ctrl-C in the
handshake window is the production trigger.
Under the pipe handshake this defect had two endings (an OVMX$_PRCLOST, or a
reap that blocked for the image's life); the suite still asserts them as ONE
assertion -- the caller's signal decided what $CREPRC said about the child --
and prints which ending it saw.
Nothing else in the file is touched: with no signal delivered the mutated code
and the correct code are byte-for-byte equivalent in behaviour, which is why
the ONLY assertion it reddens is the one that arranges the signal.
EOF
                      ;;
        require_fail) cat <<'EOF'
sys$creprc returned, and reported no process lost, while the caller caught signals
EOF
                      ;;
        knock_on_fail) echo "";;
        knock_on_why)  echo "";;
        esac

}

defect_apply() {
        # The ONE edit: the creation record's op is issued through kif_call,
        # not kif_wait_call -- a signalled wait is no longer re-entered. It
        # changes nothing except what happens when a signal is delivered to the
        # CALLER while it waits, which is the whole property.
        sed -i '/NEGCTL-ANCHORED (creprc-handshake-eintr)/{n;s|^    KIF_WAIT_CALL(VMS_IOCTL_CREPRC_SYNC, \&args);$|    KIF_CALL(VMS_IOCTL_CREPRC_SYNC, \&args); /* NEGCTL creprc-handshake-eintr */|}' "$_file"
    :
}
