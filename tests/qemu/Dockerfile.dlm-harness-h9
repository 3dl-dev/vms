# Dockerfile.dlm-harness-h9 - DLM cross-node harness, rung H9 (rd vms-eeb) --
# THE LVB READ CROSSING: node A reads node B's SEEDED resource value block back
# over the SCS GRANT wire. The exact MIRROR of the H8 write crossing (vms-d81).
#
# The wire sibling of tests/qemu/Dockerfile.dlm-harness-h6. It builds the SAME
# real-executive ingredients -- vms.ko (the executive, now with the LVB read
# crossing: the cross-node ENQ dispatch reads res->valblk into the reply, and
# grant_recv stores the master's LVB on the requester's origin record so GETLKI
# surfaces it) + SCSD.EXE (static musl, now with the H9 drive: node B SEEDs RRD's
# value block via a LOCAL $ENQ EX+VALBLK then $DEQ; node A does a cross-node $ENQ
# with VALBLK and reads the master's LVB back via a LOCAL GETLKI) + sca_l2probe --
# bakes the SAME TWO per-node SYSGEN identity stores (OVMXA/OVMXB), assembles ONE
# symmetric initramfs, and boots TWO QEMU nodes wired on one shared L2 by a QEMU
# `socket` (mcast) netdev -- NO host bridge, NO privilege. It runs the SAME join
# sequencer as H2-H6 (OVMX_MCAST_SOLICIT=1 OVMX_JOIN_SEQ=1) so both nodes reach
# VMS$VAXcluster membership, then the H9 init arms the LVB read crossing over the
# LIVE VC (node A: OVMX_DLM_ENQ=RRD OVMX_DLM_H9=1; node B: OVMX_DLM_H9=1).
#
# WHAT H9 PROVES (the LVB READ crossing): node B (master of RRD) holds a known
# 16-byte value block; node A's cross-node $ENQ reads it back over the GRANT and a
# LOCAL GETLKI on A's own handle surfaces it. H9 PASS iff node B prints
# SCSD-I-DLMLVBSEED and node A prints SCSD-I-DLMLVBRD9 AND the three-way equality
# A_read == B_seed == the expected pattern holds. See tests/qemu/init_dlm_h9.sh +
# run_dlm_harness_h9.sh. Nothing here fabricates a wire reply, a grant, or an LVB
# (INV-6) -- the markers are the REAL executive bytes hex-encoded verbatim.
#
# Usage:
#   docker build -f tests/qemu/Dockerfile.dlm-harness-h9 -t ovmx-dlm-h9 .
#   docker run --rm --device /dev/kvm ovmx-dlm-h9     # --device optional (TCG fallback)
# Exit 0 = H9 PASS (LVB read crossing proven), 1 = FAIL.

FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    ARCH=$(dpkg --print-architecture) && \
    if [ "$ARCH" = "arm64" ]; then QEMU_PKG=qemu-system-arm; else QEMU_PKG=qemu-system-x86; fi && \
    apt-get install -y --no-install-recommends \
    make gcc libc6-dev kmod \
    linux-headers-generic \
    linux-image-virtual \
    busybox-static \
    cpio \
    python3 \
    cmake musl-tools linux-libc-dev \
    "$QEMU_PKG" \
    && rm -rf /var/lib/apt/lists/*

RUN KVER=$(ls /lib/modules/ | sort -V | tail -1) && echo "$KVER" > /tmp/kver && echo "Kernel version: $KVER"

# vms.ko: the real executive.
COPY src/kernel-core/ /src/kernel-core/
COPY src/kernel/ /src/kernel/
COPY src/vmsfs/include/ /src/vmsfs/include/
COPY src/vmsfs/ods2/ /src/vmsfs/ods2/
RUN KVER=$(cat /tmp/kver) && \
    cd /src/kernel && \
    make KDIR=/lib/modules/${KVER}/build 2>&1 && \
    ls -la /src/kernel/vms.ko && \
    modinfo /src/kernel/vms.ko

# musl UAPI header symlinks.
RUN MUSL_INC=$(echo /usr/include/*-linux-musl) && \
    ARCH_INC=$(echo /usr/include/*-linux-gnu) && \
    ln -s /usr/include/linux "$MUSL_INC/linux" && \
    ln -s /usr/include/asm-generic "$MUSL_INC/asm-generic" && \
    ln -s "$ARCH_INC/asm" "$MUSL_INC/asm"

# SCSD.EXE, static musl (OVMX_STATIC=ON) -- the real SCS datalink daemon.
COPY . /src/repo/
RUN cd /src/repo && \
    cmake -B build-static \
        -DCMAKE_C_COMPILER=musl-gcc \
        -DCMAKE_BUILD_TYPE=Release \
        -DOVMX_STATIC=ON \
    && cmake --build build-static --target scsd_exe --parallel $(nproc) 2>&1 && \
    { [ -f build-static/bin/SCSD.EXE ] || { echo "FATAL: SCSD.EXE was not built"; exit 1; }; } && \
    ls -la build-static/bin/SCSD.EXE && \
    { readelf -d build-static/bin/SCSD.EXE 2>/dev/null | grep -q NEEDED && \
        { echo "FATAL: staged SCSD.EXE is not static"; exit 1; } || true; }

# sca_l2probe: the tiny static raw-L2 pcap capturer.
RUN musl-gcc -static -O2 -Wall -Wextra /src/repo/tests/qemu/sca_l2probe.c -o /src/sca_l2probe && \
    { readelf -d /src/sca_l2probe 2>/dev/null | grep -q NEEDED && \
        { echo "FATAL: sca_l2probe is not static"; exit 1; } || true; }

# The two per-node SYSGEN identity stores.
RUN mkdir -p /src/sysgen && \
    python3 /src/repo/tests/cluster/two-ovmx/mk_sysgen_scratch.py /src/sysgen/sysgen-A.dat OVMXA 1601 1 20 && \
    python3 /src/repo/tests/cluster/two-ovmx/mk_sysgen_scratch.py /src/sysgen/sysgen-B.dat OVMXB 1602 1 20

RUN KVER=$(cat /tmp/kver) && \
    if [ ! -e /boot/vmlinuz ]; then ln -s vmlinuz-${KVER} /boot/vmlinuz; fi && \
    ls -la /boot/vmlinuz

# Assemble ONE symmetric initramfs.
COPY tests/qemu/init_dlm_h9.sh /src/init_dlm_h9.sh
RUN mkdir -p /initramfs/bin /initramfs/lib/modules /initramfs/etc/ovmx \
             /initramfs/dev /initramfs/proc /initramfs/sys /initramfs/tmp && \
    cp /bin/busybox /initramfs/bin/busybox && \
    ln -s busybox /initramfs/bin/sh && \
    cp /src/kernel/vms.ko /initramfs/lib/modules/ && \
    cp /src/repo/build-static/bin/SCSD.EXE /initramfs/bin/SCSD.EXE && \
    chmod +x /initramfs/bin/SCSD.EXE && \
    cp /src/sca_l2probe /initramfs/bin/sca_l2probe && \
    chmod +x /initramfs/bin/sca_l2probe && \
    cp /src/sysgen/sysgen-A.dat /initramfs/etc/ovmx/sysgen-A.dat && \
    cp /src/sysgen/sysgen-B.dat /initramfs/etc/ovmx/sysgen-B.dat && \
    cp /src/init_dlm_h9.sh /initramfs/init && \
    chmod +x /initramfs/init && \
    cd /initramfs && find . | cpio -o -H newc 2>/dev/null | gzip > /initramfs.cpio.gz && \
    echo "Initramfs: $(ls -lh /initramfs.cpio.gz | awk '{print $5}')"

COPY tests/qemu/run_dlm_harness_h9.sh /run_dlm_harness_h9.sh
RUN chmod +x /run_dlm_harness_h9.sh

CMD ["/run_dlm_harness_h9.sh"]
