$ SET DEFAULT SYS$SYSDEVICE:[ACLT]
$ SHOW ACL H1.DAT
$ WRITE SYS$OUTPUT "STATUS ", $STATUS
$ SET ACL/ACL=(IDENTIFIER=[200,201],ACCESS=READ) H1.DAT
$ WRITE SYS$OUTPUT "STATUS ", $STATUS
$ SET ACL/ACL=(IDENTIFIER=[200,201],ACCESS=READ) H2.DAT
$ WRITE SYS$OUTPUT "STATUS ", $STATUS
$ SHOW ACL H2.DAT
$ SET ACL/ACL=(IDENTIFIER=[200,201],ACCESS=READ+WRITE) H3.DAT
$ WRITE SYS$OUTPUT "STATUS ", $STATUS
$ SHOW ACL H3.DAT
$ EXIT
