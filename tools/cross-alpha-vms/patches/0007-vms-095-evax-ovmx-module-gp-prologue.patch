+const char *
+alpha_output_ovmx_gpdisp (void)
+{
+  fprintf (asm_out_file, "\t.ovmx_gpdisp $%d, ", OVMX_VMS_MODULE_GP_REGNO);
+  assemble_name (asm_out_file, alpha_fnname);
+  fputc ('\n', asm_out_file);
+  return "";
+}
