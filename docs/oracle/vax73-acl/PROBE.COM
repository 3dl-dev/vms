$ SET DEFAULT SYS$SYSDEVICE:[ACLT]
$ CALL RD F1.DAT
$ CALL RD F2.DAT
$ CALL RD F3.DAT
$ CALL RD F4.DAT
$ CALL RD F5.DAT
$ CALL RD F6.DAT
$ CALL RD F7.DAT
$ CALL WR F8.DAT
$ CALL RD F9.DAT
$ CALL RD F10.DAT
$ CALL RD F11.DAT
$ CALL WR F12.DAT
$ CALL RD F13.DAT
$ CALL RD F14.DAT
$ EXIT
$RD: SUBROUTINE
$ OPEN/READ/ERROR=BAD X 'P1'
$ CLOSE X
$ WRITE SYS$OUTPUT "ACLPROBE ''P1' READ granted"
$ EXIT
$BAD:
$ WRITE SYS$OUTPUT "ACLPROBE ''P1' READ status=", $STATUS
$ EXIT
$ ENDSUBROUTINE
$WR: SUBROUTINE
$ OPEN/APPEND/ERROR=BAD X 'P1'
$ CLOSE X
$ WRITE SYS$OUTPUT "ACLPROBE ''P1' WRITE granted"
$ EXIT
$BAD:
$ WRITE SYS$OUTPUT "ACLPROBE ''P1' WRITE status=", $STATUS
$ EXIT
$ ENDSUBROUTINE
