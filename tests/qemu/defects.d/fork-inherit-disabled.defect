# fork-inherit-disabled -- one facility negative control (tests/qemu/facility_defects.sh).
# defect_meta: its metadata, by field ($_f). defect_apply: the mutation of $_file.

defect_meta() {
        case "$_f" in
        facility)     echo "INET pseudo-device BGn: -- BG channel inheritance at creation (vms_proc_create_for + vms_bg_inherit, src/kernel/vms_module.c, vms-0cd / rd vms-2a5): an image task or subprocess takes its creator's BG channels while the creator holds it, so an accept->fork->close forking server (sshd, inetd) still hands the accepted connection to its child even though it closes its own copy right after the fork.";;
        targets)      echo "kernel/vms_module.c";;
        suites_red)   echo "test_syssvc_bg_fork_close_inherit";;
        blind_suites) echo "";;
        blind_why)    echo "";;
        isolation)    echo "isolated";;
        why)          echo "The mutation stops vms_proc_create_for copying the creator's BG channels onto the child it makes (if (0 \&\& !detached)). In test_syssvc_bg_fork_close_inherit the parent CLOSES the accepted channel right after the fork, so the child's PCB has no channel by that number: ovmx_materialize_fd returns SS\$_IVCHAN and the byte-exact round-trip fails. The no-executive honest-skip and the accept/listener assertions stay green. One condition zeroed; the original condition is gone after substitution, so a second apply is a no-op.";;
        require_fail) cat <<'EOF'
the forked+exec'd child materialized the inherited connection and round-tripped BYTE-EXACT, though the parent CLOSED it right after the fork -- eager fork-time inheritance (vms-0cd)
EOF
                      ;;
        knock_on_fail) echo "";;
        knock_on_why)  echo "";;
        esac

}

defect_apply() {
        sed -i 's|^    if (!detached) {$|    if (0 \&\& !detached) { /* NEGCTL fork-inherit-disabled */|' "$_file"
    :
}
