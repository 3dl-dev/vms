# register-subprocess-identity-self-declared -- one facility negative control (tests/qemu/facility_defects.sh).
# defect_meta: its metadata, by field ($_f). defect_apply: the mutation of $_file.

defect_meta() {
        case "$_f" in
        facility)     echo "creator-driven creation of a SUBPROCESS (vms_proc_create_for, kernel/vms_module.c, rd vms-c43 / vms-2a5) -- the new process's identity is its creator's, copied by the executive, never declared by the child";;
        targets)      echo "kernel/vms_module.c";;
        suites_red)   echo "test_syssvc_creprc_inherit";;
        blind_suites) echo "";;
        blind_why)    echo "";;
        isolation)    echo "isolated";;
        why)          echo "vms_proc_create_for makes a SUBPROCESS's PCB without copying its creator's identity: the child starts with no user name, UIC 0 and no privileges -- a process that could only get an identity by declaring one. Gone after apply.";;
        require_fail) cat <<'EOF'
A: the subprocess INHERITED the creator's user name (SYSTEM) -- a readback, not a self-declaration
EOF
                      ;;
        knock_on_fail) cat <<'EOF'
A: the subprocess inherited the creator's UIC [1,4]
A: the subprocess inherited the creator's privilege mask, SETPRV/SYSPRV included
EOF
                      ;;
        knock_on_why)  echo "the same inherit_identity=false flip means EVERY field continuation was supposed to carry from the creator's row -- user name, UIC, and privilege mask -- reads the fresh-registration default instead; all three are the same single property (identity continuation disabled), not three separate defects.";;
        esac

}

defect_apply() {
        sed -i 's|^        vms_proc_copy_identity(proc, creator, false);$|        (void)0; /* NEGCTL register-subprocess-identity-self-declared */|' "$_file"
    :
}
