# Dockerfile.dlm-harness - DLM cross-node harness, rung H0 (rd vms-4b6).
#
# A DELIBERATELY MINIMAL cousin of tests/qemu/Dockerfile. It builds ONLY what
# H0 needs -- vms.ko (the real executive) and SCSD.EXE (the SCS datalink daemon,
# static musl) -- assembles a tiny initramfs, and boots ONE QEMU node. It does
# NOT build the full src/libvms system-service suite, tcc, OpenSSH, IMGACT, or
# any ODS-2 fixture, and it stages no disks or NIC: SCSD's --dlm-selftest opens
# no socket. That keeps this image an order of magnitude cheaper than the full
# kernel-executive image while proving the ONE thing H0 exists to prove.
#
# WHAT H0 PROVES: on a node with a REAL /dev/vms, SCSD's own cross-node DLM
# dispatch path (scsd_dlm_dispatch_to_executive, src/vmsscs/scsd.c) reaches the
# executive and VMS_IOCTL_DLM_XNODE returns SS$_UNSUPPORTED (2296) -- NOT
# SS$_NOSUCHDEV (2680). That status flip is the machine-checkable foundation the
# two-node DLM harness (H1-H4) builds on. See tests/qemu/init_dlm_h0.sh.
#
# Usage:
#   docker build -f tests/qemu/Dockerfile.dlm-harness -t ovmx-dlm-h0 .
#   docker run --rm ovmx-dlm-h0
# Exit 0 = H0 PASS (SCSD reached the real executive, 2296), 1 = FAIL.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# See tests/qemu/Dockerfile for the linux-image-virtual (not -generic) rationale:
# same kernel, 733 MB less firmware nothing here reads. QEMU package name is
# arch-conditional. musl-tools + linux-libc-dev build SCSD.EXE static (musl),
# exactly the OVMX_STATIC mode distro/Dockerfile.bootable ships SCSD.EXE in.
RUN apt-get update && \
    ARCH=$(dpkg --print-architecture) && \
    if [ "$ARCH" = "arm64" ]; then QEMU_PKG=qemu-system-arm; else QEMU_PKG=qemu-system-x86; fi && \
    apt-get install -y --no-install-recommends \
    make gcc libc6-dev kmod \
    linux-headers-generic \
    linux-image-virtual \
    busybox-static \
    cpio \
    cmake musl-tools linux-libc-dev \
    "$QEMU_PKG" \
    && rm -rf /var/lib/apt/lists/*

RUN KVER=$(ls /lib/modules/ | sort -V | tail -1) && \
    echo "$KVER" > /tmp/kver && \
    echo "Kernel version: $KVER"

# vms.ko: the real executive. Same build inputs as tests/qemu/Dockerfile --
# kernel-core (substrate-agnostic executive core), src/kernel (the Linux
# backend), and the kernel-resident ODS-2 codec sources vms-y lists.
COPY src/kernel-core/ /src/kernel-core/
COPY src/kernel/ /src/kernel/
COPY src/vmsfs/include/ /src/vmsfs/include/
COPY src/vmsfs/ods2/ /src/vmsfs/ods2/
RUN KVER=$(cat /tmp/kver) && \
    cd /src/kernel && \
    make KDIR=/lib/modules/${KVER}/build 2>&1 && \
    ls -la /src/kernel/vms.ko && \
    modinfo /src/kernel/vms.ko

# musl doesn't ship linux/ or asm/ UAPI headers -- symlink from linux-libc-dev,
# the same trick tests/qemu/Dockerfile and distro/Dockerfile.bootable use, so
# scsd.c's #include "vms_ioctl.h" -> <sys/ioctl.h> + linux UAPI resolves.
RUN MUSL_INC=$(echo /usr/include/*-linux-musl) && \
    ARCH_INC=$(echo /usr/include/*-linux-gnu) && \
    ln -s /usr/include/linux "$MUSL_INC/linux" && \
    ln -s /usr/include/asm-generic "$MUSL_INC/asm-generic" && \
    ln -s "$ARCH_INC/asm" "$MUSL_INC/asm"

# SCSD.EXE, static musl (OVMX_STATIC=ON). scsd_exe builds unconditionally (it
# has no dependency on the OVMX library chain beyond the vmsscs_*/vmsfs/vmslnm
# link CMake resolves itself), so `--target scsd_exe` builds exactly its
# closure -- not the whole tree. A static musl image needs no C runtime staged
# into the initramfs; it carries its own libc, like every other OVMX image.
COPY . /src/repo/
RUN cd /src/repo && \
    cmake -B build-static \
        -DCMAKE_C_COMPILER=musl-gcc \
        -DCMAKE_BUILD_TYPE=Release \
        -DOVMX_STATIC=ON \
    && cmake --build build-static --target scsd_exe --parallel $(nproc) 2>&1 && \
    { [ -f build-static/bin/SCSD.EXE ] || { echo "FATAL: SCSD.EXE was not built -- H0 has nothing to run against the executive"; exit 1; }; } && \
    echo "--- SCSD.EXE (static musl; the SCS datalink daemon, vms-c3b) ---" && \
    ls -la build-static/bin/SCSD.EXE && \
    { readelf -d build-static/bin/SCSD.EXE 2>/dev/null | grep -q NEEDED && \
        { echo "FATAL: staged SCSD.EXE is not static"; exit 1; } || true; }

RUN KVER=$(cat /tmp/kver) && \
    if [ ! -e /boot/vmlinuz ]; then ln -s vmlinuz-${KVER} /boot/vmlinuz; fi && \
    ls -la /boot/vmlinuz

# Assemble the minimal initramfs: busybox, vms.ko, SCSD.EXE, and the H0 init.
COPY tests/qemu/init_dlm_h0.sh /src/tests/qemu/init_dlm_h0.sh
RUN mkdir -p /initramfs/bin /initramfs/lib/modules /initramfs/dev \
             /initramfs/proc /initramfs/sys && \
    cp /bin/busybox /initramfs/bin/busybox && \
    ln -s busybox /initramfs/bin/sh && \
    cp /src/kernel/vms.ko /initramfs/lib/modules/ && \
    { cp /src/repo/build-static/bin/SCSD.EXE /initramfs/bin/SCSD.EXE || \
        { echo "FATAL: SCSD.EXE was not staged into the initramfs -- H0 would have nothing to run"; exit 1; }; } && \
    chmod +x /initramfs/bin/SCSD.EXE && \
    cp /src/tests/qemu/init_dlm_h0.sh /initramfs/init && \
    chmod +x /initramfs/init && \
    cd /initramfs && find . | cpio -o -H newc 2>/dev/null | gzip > /initramfs.cpio.gz && \
    echo "Initramfs: $(ls -lh /initramfs.cpio.gz | awk '{print $5}')"

COPY tests/qemu/run_dlm_harness_h0.sh /run_dlm_harness_h0.sh
RUN chmod +x /run_dlm_harness_h0.sh

CMD ["/run_dlm_harness_h0.sh"]
