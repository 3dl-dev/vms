 /* Register number used to reference objects off our PV.  */
 static int vms_base_regno;
 
+/* [OVMX] vms-095 (C3 of vms-5f5): nonzero when the current VMS procedure
+   references the linkage section and therefore establishes a module-GP in $15
+   (and must save/restore the caller's $15).  Set by alpha_compute_frame_layout,
+   read by alpha_expand_prologue and alpha_start_function.  */
+static int vms_module_gp_needed;
+
+/* [OVMX] vms-095 (C3 of vms-5f5; docs/design-alpha-per-image-gp.md 2.1): does
+   this VMS procedure need a per-image module-GP?  On the VMS ABI every external
+   or linkage reference is addressed GP-relative through the linkage section (gas
+   turns `lda reg,sym' into a `.base'-relative linkage load; a call loads its
+   linkage pair), so a procedure needs the module-GP iff its body references any
+   symbol or makes any call.  A procedure that needs it clobbers $15 and so must
+   save/restore the caller's $15 -- which requires a frame slot (see
+   alpha_compute_frame_layout).  */
+static bool
+alpha_vms_needs_module_gp (void)
+{
+  if (!TARGET_ABI_OPEN_VMS || cfun->is_thunk)
+    return false;
+
+  for (rtx_insn *insn = get_insns (); insn; insn = NEXT_INSN (insn))
+    {
+      if (!NONDEBUG_INSN_P (insn))
+	continue;
+      if (CALL_P (insn))
+	return true;
+      subrtx_iterator::array_type array;
+      FOR_EACH_SUBRTX (iter, array, PATTERN (insn), ALL)
+	{
+	  const_rtx x = *iter;
+	  if (x != NULL_RTX && GET_CODE (x) == SYMBOL_REF)
+	    return true;
+	}
+    }
+  return false;
+}
