# dcl-set-declared-qual-refused -- one facility negative control (tests/qemu/facility_defects.sh).
# defect_meta: its metadata, by field ($_f). defect_apply: the mutation of $_file.

defect_meta() {
        case "$_f" in
        facility)     echo "DCL SET per-sub-verb qualifier table (src/vmsdcl/dcl_cmd_set.c sq_file, vms-097)";;
        targets)      echo "vmsdcl/dcl_cmd_set.c";;
        suites_red)   echo "test_syssvc_dcl_set_quals";;
        blind_suites) echo "";;
        blind_why)    echo "";;
        isolation)    echo "isolated";;
        why)          echo "The SET FILE table drops the /TRUNCATE it reads: a qualifier the handler honours is refused as %DCL-W-IVQUAL (over-restriction), so the declared-qualifier assertion goes red.";;
        require_fail) cat <<'EOF2'
the declared qualifiers (/FACILITY, /CARRIAGE_CONTROL, /TRUNCATE) are accepted, not refused
EOF2
                      ;;
        knock_on_fail) echo "";;
        knock_on_why)  echo "";;
        esac

}

defect_apply() {
        sed -i 's|^    { "TRUNCATE",        CDU_VT_NONE,  0,            NULL, NULL },$|    /* NEGCTL dcl-set-declared-qual-refused */|' "$_file"
    :
}
