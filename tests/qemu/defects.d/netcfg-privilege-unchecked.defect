# netcfg-privilege-unchecked -- one facility negative control (tests/qemu/facility_defects.sh).
# defect_meta: its metadata, by field ($_f). defect_apply: the mutation of $_file.


defect_meta() {
        case "$_f" in
        facility)     echo "network configuration through the executive (VMS_IOCTL_NETCFG, vms_ioctl_netcfg in kernel-core/vms_access.c) -- OPER, as TCP/IP Services requires for SET ROUTE (measured on VAX V7.3, rd vms-ec6)";;
        targets)      echo "kernel-core/vms_access.c";;
        suites_red)   echo "test_syssvc_netcfg";;
        blind_suites) echo "";;
        blind_why)    echo "";;
        isolation)    echo "isolated";;
        why)          echo "vms_ioctl_netcfg no longer checks the caller's privileges: any process -- an unprivileged user's included -- can change interface addresses, flags and routes, with the executive acting as the kernel on its behalf. Gone after apply.";;
        require_fail) cat <<'EOT'
without OPER, network configuration is refused SS$_NOPRIV
EOT
                      ;;
        knock_on_fail) echo "";;
        knock_on_why)  echo "";;
        esac

}

defect_apply() {
        sed -i 's|^    if ((privs \& VMS_PRV_M_OPER) == 0) {$|    if (0) { /* NEGCTL netcfg-privilege-unchecked */|' "$_file"
    :
}
