# Per-module Kconfig fragment for the OVMX VMSFS (ODS-2) filesystem (vmsfs.ko).
# See vms/Kconfig for how the overlay discovers and wires a module from this
# fragment. Adding a new OVMX module never edits this file.

config OVMX_VMSFS
	tristate "OVMX VMSFS (ODS-2) filesystem"
	depends on BLOCK
	default n
	help
	  The OVMX VMSFS filesystem: an ODS-2 on-disk-format filesystem driver
	  used for OVMX system and data disks.

	  Built as a module (M) it appears as vmsfs.ko. Say M unless you are
	  statically building an OVMX-only kernel.
