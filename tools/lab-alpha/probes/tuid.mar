        .TITLE  TUID
        .LIBRARY "SYS$LIBRARY:STARLET.MLB"
        $DSCDEF
        .PSECT  DATA,NOEXE,WRT
UID:    .BLKL   4
UID2:   .BLKL   4
FAOCTL: .ASCID  "!XL !XL !XL !XL"
OUTBUF: .BLKB   120
OUTLEN: .BLKL   1
OUTDSC: .WORD   120
        .BYTE   DSC$K_DTYPE_T
        .BYTE   DSC$K_CLASS_S
        .ADDRESS OUTBUF
        .PSECT  CODE,EXE,NOWRT
        .ENTRY  START, ^M<>
        PUSHAL  UID
        CALLS   #1, G^SYS$CREATE_UID
        PUSHAL  UID2
        CALLS   #1, G^SYS$CREATE_UID
        $FAO_S  CTRSTR=FAOCTL, OUTLEN=OUTLEN, OUTBUF=OUTDSC, P1=UID, P2=UID+4, P3=UID+8, P4=UID+12
        MOVW    OUTLEN, OUTDSC
        PUSHAL  OUTDSC
        CALLS   #1, G^LIB$PUT_OUTPUT
        $FAO_S  CTRSTR=FAOCTL, OUTLEN=OUTLEN, OUTBUF=OUTDSC, P1=UID2, P2=UID2+4, P3=UID2+8, P4=UID2+12
        MOVW    OUTLEN, OUTDSC
        PUSHAL  OUTDSC
        CALLS   #1, G^LIB$PUT_OUTPUT
        MOVL    #1, R0
        RET
        .END    START
