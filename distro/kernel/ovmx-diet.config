# OVMX kernel "diet" fragment -- shared by both arches (vms-fee, parent vms-19e).
#
# Merged AFTER the per-arch boot fragment (distro/Dockerfile.bootable kernel-base
# stage). Together they make the OVMX kernel a DISTRO-GRADE-base kernel that is
# smaller without abandoning real hardware. It is NOT tinyconfig and NOT
# localmodconfig: both would strip bare-metal support, which was explicitly
# rejected. The rule is "prune categories OVMX will never need, keep the broad
# hardware set":
#
#   * vmlinuz (=y)  boot-critical only: console, the disk/filesystem path and the
#                   wired NICs. OVMX userland has NO module autoloader yet, so
#                   anything needed to reach the system disk or the network
#                   before/without a loader stays built in.
#   * module tree   broad hardware (sound, GPU, wifi, bluetooth, more NICs,
#                   MMC, SCSI HBAs, USB serial, extra filesystems) is =m: built,
#                   signed, zstd-compressed and shipped in /kernel-out/modules
#                   (kernel-out stage), loaded on demand.
#   * initramfs     boot-critical + the OVMX modules only (unchanged).
#
# The pruned categories and the hardware that must survive are both CHECKED:
# tests/kernel-config/check_kernel_budget.sh asserts the size budgets
# (distro/kernel/budgets-<arch>.conf) and the module-coverage list
# (distro/kernel/hw-coverage-<arch>.txt) against the built artifacts (vms-c5f).
#
# CONFIG_TRIM_UNUSED_KSYMS is deliberately NOT enabled (vms-fee decision): with
# the broad hardware set as =m it trims almost nothing, and it makes the
# exported-symbol set depend on the exact module set, so the incremental
# kernel-build stage (which re-stages the churning vms.ko sources into the base)
# would have to redo the whole symbol-trim pass whenever vms.ko starts using a
# new export -- and any out-of-tree module build against the kept tree would
# break. Revisit only with a measured win.
#
# NB: keep prose references to config symbols mid-line -- a comment line that
# BEGINS with "# CONFIG_" is parsed by merge_config.sh as a directive.

# --- Compression (size) ---------------------------------------------------
# Modules are signed first (MODULE_SIG_ALL at modules_install), then zstd'd;
# MODULE_DECOMPRESS lets finit_module() take the compressed file directly.
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y

# --- Heavy debug off in production builds ---------------------------------
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_KASAN is not set
# CONFIG_KCSAN is not set
# CONFIG_UBSAN is not set
# CONFIG_PROVE_LOCKING is not set
# CONFIG_LOCKDEP is not set
# CONFIG_DEBUG_LOCK_ALLOC is not set
# CONFIG_KGDB is not set
# CONFIG_DEBUG_KMEMLEAK is not set
# CONFIG_DEBUG_OBJECTS is not set
# CONFIG_DEBUG_PAGEALLOC is not set
# CONFIG_SLUB_DEBUG_ON is not set
# CONFIG_KFENCE is not set
# CONFIG_GCOV_KERNEL is not set

# --- Categories OVMX never needs ------------------------------------------
# staging drivers (whole tree), media/DVB/webcams, amateur radio, dead or
# niche net protocols and buses
# CONFIG_STAGING is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_HAMRADIO is not set
# CONFIG_CAN is not set
# CONFIG_NFC is not set
# CONFIG_ATM is not set
# CONFIG_ISDN is not set
# CONFIG_INFINIBAND is not set
# CONFIG_IEEE802154 is not set
# CONFIG_6LOWPAN is not set
# CONFIG_CAIF is not set
# CONFIG_RDS is not set
# CONFIG_TIPC is not set
# CONFIG_PHONET is not set
# CONFIG_BATMAN_ADV is not set
# CONFIG_WIMAX is not set
# exotic / legacy / cluster filesystems
# CONFIG_ADFS_FS is not set
# CONFIG_AFFS_FS is not set
# CONFIG_ECRYPT_FS is not set
# CONFIG_HFS_FS is not set
# CONFIG_HFSPLUS_FS is not set
# CONFIG_BEFS_FS is not set
# CONFIG_BFS_FS is not set
# CONFIG_EFS_FS is not set
# CONFIG_JFFS2_FS is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_CRAMFS is not set
# CONFIG_MINIX_FS is not set
# CONFIG_OMFS_FS is not set
# CONFIG_HPFS_FS is not set
# CONFIG_QNX4FS_FS is not set
# CONFIG_QNX6FS_FS is not set
# CONFIG_SYSV_FS is not set
# CONFIG_UFS_FS is not set
# CONFIG_ORANGEFS_FS is not set
# CONFIG_CODA_FS is not set
# CONFIG_AFS_FS is not set
# CONFIG_NILFS2_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_CEPH_FS is not set
