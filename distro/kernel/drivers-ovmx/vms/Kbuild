# In-tree Kbuild for vms.ko (vms-934, parent vms-19e "owns-kernel").
#
# The canonical source lives in the OVMX repo as src/kernel/ (the Linux glue --
# the /dev/vms char device + the P0/P1 region mappers) and src/kernel-core/ (the
# substrate-agnostic executive facilities). distro/kernel/overlay-ovmx-
# drivers.sh copies BOTH into this directory (flattened) at kernel-build time,
# so every object below is a plain basename here. The object set MUST mirror
# src/kernel/Makefile's `vms-y` (the standalone/out-of-tree build kept for the
# QEMU test harness) -- if you add an executive-core .c there, add it here too.
#
# OVMX_KBACKEND_LINUX selects the Linux realizations of the exec_* shim
# contracts (exec_kbackend_linux.h / exec_list_linux.h / exec_hash_linux.h /
# exec_rbtree_linux.h), which the overlay places beside these sources.

obj-$(CONFIG_OVMX_VMS) += vms.o

vms-y := vms_module.o \
         vms_p0.o \
         vms_p1.o \
         vms_bg.o \
         vms_bg_pollfd.o \
         vms_bg_forkinherit.o \
         vms_bg_datafd.o \
         vms_l2.o \
         vms_access.o \
         vms_ast.o \
         vms_devtab.o \
         vms_eflag.o \
         vms_lnm.o \
         vms_lock.o \
         vms_mbx.o \
         vms_cluster_fork.o \
         vms_cluster_fork_bind.o \
         vms_pe.o \
         vms_cluster_codec.o \
         vms_cluster_codec_cm.o \
         vms_pe_fsm.o \
         vms_cluster_codec_hello.o \
         vms_cnxman_csb.o \
         vms_cnxman_recnx_fsm.o \
         vms_cnxman_quorum.o \
         vms_cluster_api.o \
         vms_cnxman_barrier_fsm.o \
         vms_proctab.o \
         vmsfs_acp.o \
         ods2_reader.o \
         ods2_edit.o

# vms-5f0 (epic vms-208): the ATOMIC FLIP makes PID 1 $MOUNT SYS$DISK through
# the Files-11 ACP, the FIRST product path to call the bootable ACP $MOUNT -- so
# the shipped in-tree vms.ko must now carry the genuine ODS-2 codec (previously
# only the out-of-tree QEMU-test vms.ko did, and the bootable ACP $MOUNT
# fail-honestly refused with SS$_DEVNOTMOUNT). Mirrors src/kernel/Makefile's
# vms-y (ods2_reader.o = the pure parse/validate surface acp_validate_ods2 uses:
# home/FH2/SCB parse + FM2 map-walk; ods2_edit.o = the EDIT twins the IO$_WRITEVBLK
# path uses). NOT the writer / block-I/O objects: vmsfs_acp.c does its own block
# reads/writes through the exec_blockdev_*_block shim. Same flatten-safe codec
# staging as vmsfs/Kbuild (sources.conf stages vmsfs/ods2.h at <moddir>/vmsfs/).
# FC-P3.6: vms_cnxman_csb.o (the CLUB/CSB model + the CSB ten-state ladder) and
# vms_cnxman_recnx_fsm.o (the RECNXINTERVAL/TIMVCFAIL reconnect loop) join on the
# same terms, and for the same two-object-lists reason.
# FC-P3.7: vms_cnxman_quorum.o (CEVOTES/QUORUM, tracking only) and
# vms_cluster_api.o (the $GETSYI cluster item-code projection) join the same way.
# FC-P3.5: vms_cnxman_barrier_fsm.o (the state-transition barrier, participant
# side) plus the two codec objects it reads and builds every frame through --
# vms_cluster_codec.o (FC-P0.6) and vms_cluster_codec_cm.o (FC-P3.1). Same
# two-object-lists rule: all three are in src/kernel/Makefile's vms-y.
# FC-P0.8: vms_pe_fsm.o (the pure NISCA channel state machine) plus the codec it
# builds every frame through -- vms_cluster_codec.o (FC-P0.6) and
# vms_cluster_codec_hello.o (FC-P0.7) -- join on the same terms and for the same
# two-object-lists reason.
# FC-P0.1: vms_pe.o is the executive-resident VMScluster stack's LAN port layer.
# It mirrors src/kernel/Makefile's vms-y (the two-object-lists rule: an executive
# core .c missing here builds standalone and then fails modpost in the bootable
# image, which only the boot gate catches). Its includes are all basenames, as
# the flattening overlay requires. FC-P0.5 adds the fork context beside it
# (vms_cluster_fork.o = the pure queue/dispatch, vms_cluster_fork_bind.o = its
# exec_kthread/exec_timer binding); their includes are basenames too.
ccflags-y := -I $(src) -DOVMX_KBACKEND_LINUX -DOVMX_ODS2_KERNEL
