# Build directories
build/
build-static/
# any local/CI build tree (build-local, build-ci8, build-246gate, ...)
build-*/
dist/

# CMake (generated in build directories)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.cmake
# ...but *.cmake also swallows hand-written CMake scripts that live in the
# SOURCE tree. Un-ignore those explicitly, one path at a time (vms-76e: this
# one is the body of a ctest, so if it silently failed to get committed the
# test would red in CI with "no such file" instead of its real diagnostic).
!tests/vmsscs/scs_credit_figures_no_python3.cmake
!tests/vmsscs/scs_connect_data_figures_no_python3.cmake
!tests/vmsscs/scs_reason_figures_no_python3.cmake

# Object files and libraries
*.o
*.ko
*.mod
*.mod.c
modules.order
Module.symvers
.tmp_versions/
*.a
*.so
*.so.*

# Kernel build
*.cmd
.*.cmd

# Editor swap files
*.swp
*.swo
*~

# IDE
.vscode/
.idea/

# macOS
.DS_Store

# Beads runtime
.beads/beads.db*
.beads/*.lock
.beads/*.tmp

# Python
__pycache__/
*.pyc

# Environment
.env

# agent worktrees — never commit
.claude/worktrees/

# rd local nostr sync cache
.ready/nostr-log.jsonl

# Retired coordination substrate (campfire, fully retired 2026-07 — see CLAUDE.md)
.campfire/

# Session/agent scratch — never source
.telemetry/
scratchpad/
.ready/*.lock
