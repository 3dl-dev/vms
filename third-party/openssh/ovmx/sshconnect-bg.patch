--- a/sshconnect.c
+++ b/sshconnect.c
@@ -52,6 +52,11 @@
 #include "xmalloc.h"
 #include "hostfile.h"
 #include "ssh.h"
+#ifdef OVMX_BG_TRANSPORT
+/* OVMX (vms-22a): route the ssh client transport over the executive BGn: INET
+ * device instead of a raw socket().  See third-party/openssh/ovmx/. */
+#include "ovmx/ovmx_bg_transport.h"
+#endif
 #include "sshbuf.h"
 #include "packet.h"
 #include "sshkey.h"
@@ -494,6 +499,29 @@
 				host, ntop, strport);
 
 			/* Create a socket for connecting. */
+#ifdef OVMX_BG_TRANSPORT
+			/*
+			 * OVMX (vms-22a): obtain the transport over the
+			 * executive-resident BGn: INET device via $ASSIGN
+			 * TCPIP$DEVICE: + $QIO, NOT a raw Linux socket().  The
+			 * returned fd is an ordinary pollable socketpair end
+			 * that a pump thread bridges to the VMS channel, so the
+			 * packet layer below is unchanged.  ENODEV here means
+			 * /dev/vms is absent -- fail honestly (Rule 9/INV-6),
+			 * never a socket() fallback.
+			 */
+			sock = ovmx_bg_connect(ai->ai_addr, ai->ai_addrlen);
+			if (sock < 0) {
+				oerrno = errno;
+				debug("BGn: connect to address %s port %s: %s",
+				    ntop, strport, strerror(errno));
+				errno = oerrno;
+				continue;
+			}
+			/* Successful connection over BGn:. */
+			memcpy(hostaddr, ai->ai_addr, ai->ai_addrlen);
+			break;
+#else
 			sock = ssh_create_socket(ai);
 			if (sock < 0) {
 				/* Any error is already output */
@@ -515,6 +543,7 @@
 				sock = -1;
 				errno = oerrno;
 			}
+#endif
 		}
