# OVMX VMS-compatibility drivers (vms-934, parent vms-19e "owns-kernel").
#
# This is the in-tree home for OVMX's kernel modules. The module SOURCE is
# canonical in the OVMX repo (src/kernel/ + src/kernel-core/); at kernel-build
# time distro/kernel/overlay-ovmx-drivers.sh copies it here as
# drivers/ovmx/{vms,vmsfs}/ so `make modules` builds vms.ko/vmsfs.ko as part of
# OUR kernel tree. modpost then stamps modinfo intree=Y, and loading such a
# module does NOT set TAINT_OUT_OF_TREE. "In-tree" means OUR tree -- no
# mainline/Linus acceptance is implied or required.
#
# Future OVMX kernel modules (e.g. the DECnet kernel half, docs/design-decnet-
# ovmx.md) slot in here the same way.

menuconfig OVMX
	bool "OVMX VMS-compatibility drivers"
	default n
	help
	  In-tree home for the OVMX VMS-compatibility kernel modules. Say Y
	  here to expose the individual OVMX drivers below; each is an
	  independent tristate. If unsure, say N.

if OVMX

config OVMX_VMS
	tristate "OVMX VMS executive (/dev/vms)"
	default n
	help
	  The OVMX VMS executive: the /dev/vms misc character device through
	  which userspace reaches the VMS executive facilities (event flags,
	  ASTs, access modes, mailboxes, the process table, the lock manager,
	  the device table and the logical-name manager). This is the runtime
	  the OVMX product boots against (CLAUDE.md Rule 9).

	  Built as a module (M) it appears as vms.ko. Say M unless you are
	  statically building an OVMX-only kernel.

config OVMX_VMSFS
	tristate "OVMX VMSFS (ODS-2) filesystem"
	depends on BLOCK
	default n
	help
	  The OVMX VMSFS filesystem: an ODS-2 on-disk-format filesystem driver
	  used for OVMX system and data disks.

	  Built as a module (M) it appears as vmsfs.ko. Say M unless you are
	  statically building an OVMX-only kernel.

endif # OVMX
