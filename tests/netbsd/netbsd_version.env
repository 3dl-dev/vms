# netbsd_version.env - the PINNED NetBSD substrate for the OVMX/NetBSD harness
# (rd vms-7f7, epic vms-8e8; docs/design-ovmx-netbsd-syskrnl.md §6).
#
# Everything here is pinned on purpose. Never fetch "latest": a moving release
# would make the harness's verdict irreproducible and would silently change the
# `uname -srm` string the assertion keys on. Bump these deliberately, together,
# with a fresh checksum copied from the CDN's own SHA512 manifest.
#
# The checksum below is the CDN's published SHA512 for the amd64 SERIAL-console
# boot ISO (installation/cdrom/boot-com.iso). anita drives the install over an
# emulated serial console, so boot-com.iso -- NOT boot.iso (VGA) -- is the image
# it downloads (anita.py Version.boot_isos() == ['boot-com.iso']). Source of the
# hash:
#   https://cdn.netbsd.org/pub/NetBSD/NetBSD-10.1/amd64/installation/cdrom/SHA512
#
# Sourced by run_tests.sh and read by drive_netbsd.py via the environment.

NETBSD_VERSION=10.1
NETBSD_ARCH=amd64
NETBSD_URL=https://cdn.netbsd.org/pub/NetBSD/NetBSD-10.1/amd64/
NETBSD_BOOT_ISO=boot-com.iso
NETBSD_BOOT_ISO_SHA512=63341588599eb1e30c744cebdb30699fac159d777672c8948fb841aba99ca83d9eb40592ed21118884af13481e8dbed26583e0d87f548ee400efbb1d7c17c71f

# anita is pinned too: it is the automation that scripts sysinst over the serial
# console. 2.18 is the current release (2026-04-25). It is NOT the PyPI package
# named "anita" (that is an unrelated project); the real tool ships as a tarball
# from gson.org. The SHA256 is computed from that tarball and pinned here so the
# harness image builds reproducibly.
#   https://www.gson.org/netbsd/anita/download/anita-2.18.tar.gz
ANITA_VERSION=2.18
ANITA_SHA256=fa5ac3a8b3e30a3a35df9254bbee213b28210a396544592c3e604a1e53a294ce
