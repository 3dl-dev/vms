	.TITLE DLMLVB6
	$LCKDEF
	$SSDEF
	.PSECT DAT,WRT,NOEXE,LONG
LKSB:	.BLKB	24
PATTERN: .ASCII	/DEMOTEEXTOCRXXXX/
CMDBUF:	.BLKB	100
CMDDSC:	.WORD	100
	.BYTE	14
	.BYTE	1
	.ADDRESS CMDBUF
CMDLEN:	.WORD	0
	.WORD	0
RESDSC:	.WORD	0
	.BYTE	14
	.BYTE	1
	.ADDRESS 0
	.PSECT	COD,EXE,NOWRT
	.ENTRY	DLMLVB6,^M<R2,R3,R4,R5,R6>
	PUSHAW	CMDLEN
	PUSHL	#0
	PUSHAB	CMDDSC
	CALLS	#3,G^LIB$GET_FOREIGN
	MOVZWL	CMDLEN,R1
	MOVW	R1,RESDSC
	MOVAB	CMDBUF,RESDSC+4
	$ENQW_S	EFN=#1,LKMODE=#5,LKSB=LKSB,FLAGS=#<LCK$M_SYSTEM!LCK$M_VALBLK>,RESNAM=RESDSC
	MOVC3	#16,PATTERN,LKSB+8
	$ENQW_S	EFN=#1,LKMODE=#1,LKSB=LKSB,FLAGS=#<LCK$M_SYSTEM!LCK$M_CONVERT!LCK$M_VALBLK>,PARID=LKSB+4
	$HIBER_S
	RET
	.END	DLMLVB6
