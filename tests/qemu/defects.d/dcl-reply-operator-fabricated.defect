# dcl-reply-operator-fabricated -- one facility negative control (tests/qemu/facility_defects.sh).
# defect_meta: its metadata, by field ($_f). defect_apply: the mutation of $_file.

defect_meta() {
        case "$_f" in
        facility)     echo "the operator name REPLY/ENABLE reports and logs (src/vmsdcl/dcl_cmd_misc.c cmd_reply)";;
        targets)      echo "vmsdcl/dcl_cmd_misc.c";;
        suites_red)   echo "test_syssvc_ident";;
        blind_suites) echo "";;
        blind_why)    echo "";;
        isolation)    echo "isolated";;
        why)          echo "REPLY/ENABLE goes back to naming the enabling operator \"SYSTEM\" when the executive holds no name for the process -- in the %OPCOM-I-OPRENA message and in the OPC record it sends to OPERATOR.LOG.";;
        require_fail) cat <<'EOF'
G/REPLY: the OPCOM enable message names the operator SHIPPING
G/REPLY: the console message does not name SYSTEM as the operator
EOF
                      ;;
        knock_on_fail) echo "";;
        knock_on_why)  echo "";;
        esac

}

defect_apply() {
        sed -i '/^int cmd_reply(/,/^}$/ s|^    const char \*username = ctx->username;$|    const char *username = "SYSTEM"; /* NEGCTL dcl-reply-operator-fabricated */|' "$_file"
    :
}
