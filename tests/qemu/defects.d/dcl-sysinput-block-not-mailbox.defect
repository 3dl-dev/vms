# dcl-sysinput-block-not-mailbox -- one facility negative control (tests/qemu/facility_defects.sh).
# defect_meta: its metadata, by field ($_f). defect_apply: the mutation of $_file.


defect_meta() {
        case "$_f" in
        facility)     echo "DCL command-procedure data block as an image's SYS\$INPUT mailbox (dcl_in.c)";;
        targets)      echo "vmsdcl/dcl_in.c";;
        suites_red)   echo "test_syssvc_dcl_image_sysout";;
        blind_suites) echo "";;
        blind_why)    echo "";;
        isolation)    echo "isolated";;
        why)          echo "DCL writes the data lines after RUN to their mailbox but never names it SYS\$INPUT: the image's C RTL finds no mailbox to bind and reads its substrate descriptor 0, so the data lines never reach it. One call removed.";;
        require_fail) cat <<'EOF'
sysin: the RUN image read the two data lines that follow RUN
EOF
                      ;;
        knock_on_fail) echo "";;
        knock_on_why) echo "";;
        esac

}

defect_apply() {
        sed -i 's|^    st = sys\$crelnm(NULL, &blk_ptab, &blk_lnm, &um, il);$|    st = SS$_NORMAL; /* NEGCTL dcl-sysinput-block-not-mailbox */|' "$_file"
    :
}
