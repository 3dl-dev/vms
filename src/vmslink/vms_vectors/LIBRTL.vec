# LIBRTL.vec -- OVMX's LIBRTL.EXE vector image, the run-time library entry
# points an image LINKed on real OpenVMS Alpha calls (rd vms-3b3f). SINGLE
# SOURCE for this image's symbol vector; format and provenance as in
# SYS$PUBLIC_VECTORS.vec (offsets observed in our own probe's link map on the
# lab OpenVMS Alpha V8.4 node, docs/oracle/alpha84-symvec-offsets.txt).
#
# GSMATCH: images linked on V8.4 record LIBRTL ident major 1, minor 1, match
# LEQUAL (observed), so OVMX's LIBRTL carries 1,1.
#
#   gsmatch LEQUAL,1,1
#   use     LIBVMS$SHR.EXE
#
# offset  universal        OVMX target
0x080     LIB$DELETE_SYMBOL LIB$DELETE_SYMBOL
0x0B0     LIB$GET_SYMBOL   LIB$GET_SYMBOL
0x0D0     LIB$SET_SYMBOL   LIB$SET_SYMBOL
0x120     LIB$CVT_DTB      lib$cvt_dtb
0x130     LIB$CVT_HTB      lib$cvt_htb
0x140     LIB$CVT_OTB      lib$cvt_otb
0x210     LIB$FIND_FILE    LIB$FIND_FILE
0x270     LIB$INDEX        LIB$INDEX
0x2A0     LIB$LOCC         LIB$LOCC
0x2E0     LIB$MATCHC       LIB$MATCHC
0x320     LIB$PUT_OUTPUT   LIB$PUT_OUTPUT
0x370     LIB$SCOPY_DXDX   LIB$SCOPY_DXDX
0x440     LIB$SKPC         LIB$SKPC
0x4C0     LIB$FREE_VM      LIB$FREE_VM
0x4D0     LIB$GET_VM       LIB$GET_VM
0x760     STR$APPEND       STR$APPEND
0x770     STR$COMPARE      STR$COMPARE
0x790     STR$COMPARE_EQL  STR$COMPARE_EQL
0x7A0     STR$CONCAT       STR$CONCAT
0x7B0     STR$COPY_DX      STR$COPY_DX
0x7F0     STR$DUPL_CHAR    STR$DUPL_CHAR
0x810     STR$FIND_FIRST_IN_SET STR$FIND_FIRST_IN_SET
0x820     STR$FIND_FIRST_NOT_IN_SET STR$FIND_FIRST_NOT_IN_SET
0x840     STR$FREE1_DX     STR$FREE1_DX
0x880     STR$LEFT         STR$LEFT
0x8A0     STR$LEN_EXTR     STR$LEN_EXTR
0x8C0     STR$POSITION     STR$POSITION
0x8E0     STR$POS_EXTR     STR$POS_EXTR
0x900     STR$PREFIX       STR$PREFIX
0x910     STR$REPLACE      STR$REPLACE
0x930     STR$RIGHT        STR$RIGHT
0x950     STR$TRANSLATE    STR$TRANSLATE
0x960     STR$TRIM         STR$TRIM
0x970     STR$UPCASE       STR$UPCASE
0x9C0     LIB$GETDVI       LIB$GETDVI
0x9D0     LIB$GETJPI       LIB$GETJPI
0x9E0     LIB$GETSYI       LIB$GETSYI
0xC70     LIB$SYS_FAO      LIB$SYS_FAO
0xEF0     LIB$FIND_FILE_END lib$find_file_end
0x10A0     STR$ELEMENT      STR$ELEMENT
