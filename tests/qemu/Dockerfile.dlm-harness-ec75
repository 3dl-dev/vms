# Dockerfile.dlm-harness-ec75 - DLM cross-node harness, rd vms-ec75 -- DISTRIBUTED
# DEADLOCK DETECTION (DLM rung H11, the LAST DLM rung): a genuine cross-node
# wait-for CYCLE is detected by an edge-chasing search over REAL executive state,
# and EXACTLY ONE deterministic victim's queued $ENQ is aborted with SS$_DEADLOCK.
# Copy-extends Dockerfile.dlm-harness-e84 with the SAME three nodes A/B/C and the
# SAME real static 3-member DLM vector; the deltas are init_dlm_ec75.sh +
# run_dlm_harness_ec75.sh, which drive the two contenders (A, B) into a cross-node
# cycle whose resources are mastered by C, and verdict the detection + single-victim
# abort. vms.ko and SCSD.EXE carry the H11 code (VMS_DLM_OP_DLKSRCH +
# VMS_IOCTL_DLM_ENUM_WAITS in the executive; the DLKSRCH search orchestration in the
# daemon).
#
# WHAT ec75 PROVES: node C emits SCSD-I-DLKCYCLE (the real cycle, read off
# res->granted + pending origins) and SCSD-I-DLKVICTIM (the abort); node A's WAIT
# $ENQ returns SS$_DEADLOCK; node B's request stays queued. INV-6: nothing here
# fabricates a deadlock -- the markers are the REAL executive values.
#
# Usage:
#   docker build -f tests/qemu/Dockerfile.dlm-harness-ec75 -t ovmx-dlm-ec75 .
#   docker run --rm --device /dev/kvm --privileged ovmx-dlm-ec75  # --device optional (TCG fallback)
# Exit 0 = ec75 PASS (distributed deadlock detection proven), 1 = FAIL.

FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    ARCH=$(dpkg --print-architecture) && \
    if [ "$ARCH" = "arm64" ]; then QEMU_PKG=qemu-system-arm; else QEMU_PKG=qemu-system-x86; fi && \
    apt-get install -y --no-install-recommends \
    make gcc libc6-dev kmod \
    linux-headers-generic \
    linux-image-virtual \
    busybox-static \
    cpio \
    python3 \
    cmake musl-tools linux-libc-dev \
    "$QEMU_PKG" \
    && rm -rf /var/lib/apt/lists/*

RUN KVER=$(ls /lib/modules/ | sort -V | tail -1) && echo "$KVER" > /tmp/kver && echo "Kernel version: $KVER"

# vms.ko: the real executive (carries the H11 VMS_DLM_OP_DLKSRCH +
# VMS_IOCTL_DLM_ENUM_WAITS handlers).
COPY src/kernel-core/ /src/kernel-core/
COPY src/kernel/ /src/kernel/
COPY src/vmsfs/include/ /src/vmsfs/include/
COPY src/vmsfs/ods2/ /src/vmsfs/ods2/
RUN KVER=$(cat /tmp/kver) && \
    cd /src/kernel && \
    make KDIR=/lib/modules/${KVER}/build 2>&1 && \
    ls -la /src/kernel/vms.ko && \
    modinfo /src/kernel/vms.ko

# musl UAPI header symlinks.
RUN MUSL_INC=$(echo /usr/include/*-linux-musl) && \
    ARCH_INC=$(echo /usr/include/*-linux-gnu) && \
    ln -s /usr/include/linux "$MUSL_INC/linux" && \
    ln -s /usr/include/asm-generic "$MUSL_INC/asm-generic" && \
    ln -s "$ARCH_INC/asm" "$MUSL_INC/asm"

# SCSD.EXE, static musl (OVMX_STATIC=ON) -- the real SCS datalink daemon (carries
# the H11 DLKSRCH search orchestration).
COPY . /src/repo/
RUN cd /src/repo && \
    cmake -B build-static \
        -DCMAKE_C_COMPILER=musl-gcc \
        -DCMAKE_BUILD_TYPE=Release \
        -DOVMX_STATIC=ON \
    && cmake --build build-static --target scsd_exe --parallel $(nproc) 2>&1 && \
    { [ -f build-static/bin/SCSD.EXE ] || { echo "FATAL: SCSD.EXE was not built"; exit 1; }; } && \
    ls -la build-static/bin/SCSD.EXE && \
    { readelf -d build-static/bin/SCSD.EXE 2>/dev/null | grep -q NEEDED && \
        { echo "FATAL: staged SCSD.EXE is not static"; exit 1; } || true; }

# The THREE per-node SYSGEN identity stores. SCSSYSTEMID == the DLM CSID
# (1030/1031/1032), so a peer's DLM CSID is read straight off the wire.
RUN mkdir -p /src/sysgen && \
    python3 /src/repo/tests/cluster/two-ovmx/mk_sysgen_scratch.py /src/sysgen/sysgen-A.dat OVMXA 1030 1 20 && \
    python3 /src/repo/tests/cluster/two-ovmx/mk_sysgen_scratch.py /src/sysgen/sysgen-B.dat OVMXB 1031 1 20 && \
    python3 /src/repo/tests/cluster/two-ovmx/mk_sysgen_scratch.py /src/sysgen/sysgen-C.dat OVMXC 1032 1 20

RUN KVER=$(cat /tmp/kver) && \
    if [ ! -e /boot/vmlinuz ]; then ln -s vmlinuz-${KVER} /boot/vmlinuz; fi && \
    ls -la /boot/vmlinuz

# Assemble ONE symmetric initramfs (all three nodes boot the same image; the
# kernel cmdline ovmx.node=A|B|C selects the identity + H11 role).
COPY tests/qemu/init_dlm_ec75.sh /src/init_dlm_ec75.sh
RUN mkdir -p /initramfs/bin /initramfs/lib/modules /initramfs/etc/ovmx \
             /initramfs/dev /initramfs/proc /initramfs/sys /initramfs/tmp && \
    cp /bin/busybox /initramfs/bin/busybox && \
    ln -s busybox /initramfs/bin/sh && \
    cp /src/kernel/vms.ko /initramfs/lib/modules/ && \
    cp /src/repo/build-static/bin/SCSD.EXE /initramfs/bin/SCSD.EXE && \
    chmod +x /initramfs/bin/SCSD.EXE && \
    cp /src/sysgen/sysgen-A.dat /initramfs/etc/ovmx/sysgen-A.dat && \
    cp /src/sysgen/sysgen-B.dat /initramfs/etc/ovmx/sysgen-B.dat && \
    cp /src/sysgen/sysgen-C.dat /initramfs/etc/ovmx/sysgen-C.dat && \
    cp /src/init_dlm_ec75.sh /initramfs/init && \
    chmod +x /initramfs/init && \
    cd /initramfs && find . | cpio -o -H newc 2>/dev/null | gzip > /initramfs.cpio.gz && \
    echo "Initramfs: $(ls -lh /initramfs.cpio.gz | awk '{print $5}')"

COPY tests/qemu/run_dlm_harness_ec75.sh /run_dlm_harness_ec75.sh
RUN chmod +x /run_dlm_harness_ec75.sh

CMD ["/run_dlm_harness_ec75.sh"]
