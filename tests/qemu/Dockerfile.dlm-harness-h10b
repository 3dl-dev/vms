# Dockerfile.dlm-harness-h10b - DLM cross-node harness, rung H10b (rd vms-dca9) --
# THE REMASTER LOCK REBUILD: a cross-node lock SURVIVES the departure of its
# master node. Copy-extends Dockerfile.dlm-harness-h10 (H10a, the graceful-
# departure directory INGRESS) with the same three nodes A/B/C and the same
# real static 3-member DLM vector, but node A additionally HOLDS a cross-node
# lock on RES_C (mastered by C) before C departs, and re-registers that SAME
# lock on RES_C's new directory master (node B) once C is gone.
#
# It builds the SAME real-executive ingredients as Dockerfile.dlm-harness-h10 --
# vms.ko (now with SCS_DLM_OP_REBUILD / VMS_DLM_OP_REBUILD = 5,
# vms_lock_dlm_xnode_rebuild reconstructing a holder's real grant DIRECTLY into
# res->granted, and VMS_IOCTL_DLM_GET_GRANTED for the value-verify readback) +
# SCSD.EXE (static musl, now with the H10b drive: peer_by_csid, the targeted
# scsd_dlm_client_send_rebuild send, the pre-departure hold-establish, and the
# rebuild-on-depart driver) + sca_l2probe -- bakes the SAME three per-node
# SYSGEN identity stores (OVMXA/OVMXB/OVMXC, SCSSYSTEMID == DLM CSID
# 1030/1031/1032), assembles ONE symmetric initramfs, and boots THREE QEMU
# nodes wired on one shared L2 by a QEMU `socket` (mcast) netdev -- NO host
# bridge, NO privilege.
#
# WHAT H10b PROVES: node A's real cross-node lock on RES_C -- read fresh via
# GETLKI, never assumed -- is genuinely reconstructed on the resource's new
# master (B) from A's real origin state (SCSD-I-DLMREBUILDSENT ->
# SCSD-I-DLMREBUILT), VALUE-VERIFIED three-way against what A sent. See
# tests/qemu/init_dlm_h10b.sh + run_dlm_harness_h10b.sh. Nothing here fabricates
# a hold, a departure, or a rebuild (INV-6) -- the markers are the REAL
# executive values.
#
# Usage:
#   docker build -f tests/qemu/Dockerfile.dlm-harness-h10b -t ovmx-dlm-h10b .
#   docker run --rm --device /dev/kvm ovmx-dlm-h10b     # --device optional (TCG fallback)
# Exit 0 = H10b PASS (the remaster lock rebuild proven), 1 = FAIL.

FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    ARCH=$(dpkg --print-architecture) && \
    if [ "$ARCH" = "arm64" ]; then QEMU_PKG=qemu-system-arm; else QEMU_PKG=qemu-system-x86; fi && \
    apt-get install -y --no-install-recommends \
    make gcc libc6-dev kmod \
    linux-headers-generic \
    linux-image-virtual \
    busybox-static \
    cpio \
    python3 \
    cmake musl-tools linux-libc-dev \
    "$QEMU_PKG" \
    && rm -rf /var/lib/apt/lists/*

RUN KVER=$(ls /lib/modules/ | sort -V | tail -1) && echo "$KVER" > /tmp/kver && echo "Kernel version: $KVER"

# vms.ko: the real executive.
COPY src/kernel-core/ /src/kernel-core/
COPY src/kernel/ /src/kernel/
COPY src/vmsfs/include/ /src/vmsfs/include/
COPY src/vmsfs/ods2/ /src/vmsfs/ods2/
RUN KVER=$(cat /tmp/kver) && \
    cd /src/kernel && \
    make KDIR=/lib/modules/${KVER}/build 2>&1 && \
    ls -la /src/kernel/vms.ko && \
    modinfo /src/kernel/vms.ko

# musl UAPI header symlinks.
RUN MUSL_INC=$(echo /usr/include/*-linux-musl) && \
    ARCH_INC=$(echo /usr/include/*-linux-gnu) && \
    ln -s /usr/include/linux "$MUSL_INC/linux" && \
    ln -s /usr/include/asm-generic "$MUSL_INC/asm-generic" && \
    ln -s "$ARCH_INC/asm" "$MUSL_INC/asm"

# SCSD.EXE, static musl (OVMX_STATIC=ON) -- the real SCS datalink daemon.
COPY . /src/repo/
RUN cd /src/repo && \
    cmake -B build-static \
        -DCMAKE_C_COMPILER=musl-gcc \
        -DCMAKE_BUILD_TYPE=Release \
        -DOVMX_STATIC=ON \
    && cmake --build build-static --target scsd_exe --parallel $(nproc) 2>&1 && \
    { [ -f build-static/bin/SCSD.EXE ] || { echo "FATAL: SCSD.EXE was not built"; exit 1; }; } && \
    ls -la build-static/bin/SCSD.EXE && \
    { readelf -d build-static/bin/SCSD.EXE 2>/dev/null | grep -q NEEDED && \
        { echo "FATAL: staged SCSD.EXE is not static"; exit 1; } || true; }

# sca_l2probe: the tiny static raw-L2 pcap capturer.
RUN musl-gcc -static -O2 -Wall -Wextra /src/repo/tests/qemu/sca_l2probe.c -o /src/sca_l2probe && \
    { readelf -d /src/sca_l2probe 2>/dev/null | grep -q NEEDED && \
        { echo "FATAL: sca_l2probe is not static"; exit 1; } || true; }

# The THREE per-node SYSGEN identity stores. CRITICAL: SCSSYSTEMID == the DLM CSID
# (1030/1031/1032), so each node advertises aa:00:04:00:<LE16(csid)> as its SCA
# src-logical and a peer's DLM CSID is read straight off the wire (peer_node_number).
RUN mkdir -p /src/sysgen && \
    python3 /src/repo/tests/cluster/two-ovmx/mk_sysgen_scratch.py /src/sysgen/sysgen-A.dat OVMXA 1030 1 20 && \
    python3 /src/repo/tests/cluster/two-ovmx/mk_sysgen_scratch.py /src/sysgen/sysgen-B.dat OVMXB 1031 1 20 && \
    python3 /src/repo/tests/cluster/two-ovmx/mk_sysgen_scratch.py /src/sysgen/sysgen-C.dat OVMXC 1032 1 20

RUN KVER=$(cat /tmp/kver) && \
    if [ ! -e /boot/vmlinuz ]; then ln -s vmlinuz-${KVER} /boot/vmlinuz; fi && \
    ls -la /boot/vmlinuz

# Assemble ONE symmetric initramfs (all three nodes boot the same image; the
# kernel cmdline ovmx.node=A|B|C selects the identity + role).
COPY tests/qemu/init_dlm_h10b.sh /src/init_dlm_h10b.sh
RUN mkdir -p /initramfs/bin /initramfs/lib/modules /initramfs/etc/ovmx \
             /initramfs/dev /initramfs/proc /initramfs/sys /initramfs/tmp && \
    cp /bin/busybox /initramfs/bin/busybox && \
    ln -s busybox /initramfs/bin/sh && \
    cp /src/kernel/vms.ko /initramfs/lib/modules/ && \
    cp /src/repo/build-static/bin/SCSD.EXE /initramfs/bin/SCSD.EXE && \
    chmod +x /initramfs/bin/SCSD.EXE && \
    cp /src/sca_l2probe /initramfs/bin/sca_l2probe && \
    chmod +x /initramfs/bin/sca_l2probe && \
    cp /src/sysgen/sysgen-A.dat /initramfs/etc/ovmx/sysgen-A.dat && \
    cp /src/sysgen/sysgen-B.dat /initramfs/etc/ovmx/sysgen-B.dat && \
    cp /src/sysgen/sysgen-C.dat /initramfs/etc/ovmx/sysgen-C.dat && \
    cp /src/init_dlm_h10b.sh /initramfs/init && \
    chmod +x /initramfs/init && \
    cd /initramfs && find . | cpio -o -H newc 2>/dev/null | gzip > /initramfs.cpio.gz && \
    echo "Initramfs: $(ls -lh /initramfs.cpio.gz | awk '{print $5}')"

COPY tests/qemu/run_dlm_harness_h10b.sh /run_dlm_harness_h10b.sh
RUN chmod +x /run_dlm_harness_h10b.sh

CMD ["/run_dlm_harness_h10b.sh"]
