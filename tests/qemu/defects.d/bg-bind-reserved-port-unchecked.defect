# bg-bind-reserved-port-unchecked -- one facility negative control (tests/qemu/facility_defects.sh).
# defect_meta: its metadata, by field ($_f). defect_apply: the mutation of $_file.


defect_meta() {
        case "$_f" in
        facility)     echo "BG socket bind (VMS_IOCTL_BG_BIND, vms_ioctl_bg_bind in kernel-core/vms_bg.c) -- a reserved port (below 1024) needs SYSPRV, BYPASS or OPER";;
        targets)      echo "kernel-core/vms_bg.c";;
        suites_red)   echo "test_syssvc_netcfg";;
        blind_suites) echo "";;
        blind_why)    echo "";;
        isolation)    echo "isolated";;
        why)          echo "vms_ioctl_bg_bind no longer checks the caller's privileges for a reserved port: any process binds below 1024 with the executive acting as the kernel, so an unprivileged user can take a well-known service's port. Gone after apply.";;
        require_fail) cat <<'EOT'
without SYSPRV, BYPASS or OPER, a reserved-port bind is refused SS$_NOPRIV
EOT
                      ;;
        knock_on_fail) echo "";;
        knock_on_why)  echo "";;
        esac

}

defect_apply() {
        sed -i 's|^            if ((privs \& (VMS_PRV_M_SYSPRV \| VMS_PRV_M_BYPASS \| VMS_PRV_M_OPER)) == 0) {$|            if (0) { /* NEGCTL bg-bind-reserved-port-unchecked */|' "$_file"
    :
}
